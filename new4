@lru_cache(maxsize=1)
def get_model() -> ChatOpenAI:
    s = get_settings()
    return ChatOpenAI(model=s.MODEL_NAME, base_url=s.URL_LLM_RAG, api_key=s.API_KEY_RAG)


@lru_cache(maxsize=1)
def get_agent():
    # 1er de la liste = le plus externe : il rattrape aussi les échecs d'ouverture de session MCP.
    middleware = [ToolErrorsAsMessages(), RequestTools()]
    return create_deep_agent(
        model=get_model(),
        tools=[profil_utilisateur],
        system_prompt=PROMPT,
        middleware=middleware,
        context_schema=RunContext,
        # Sous-agent "general-purpose" déclaré explicitement : celui créé par défaut ne reçoit pas
        # le middleware utilisateur, donc il ne verrait pas les outils MCP de la requête.
        subagents=[{**GENERAL_PURPOSE_SUBAGENT, "middleware": middleware}],
    )


# ---------- point d'entrée
async def run_agent_langg(prompt: str, deps: Deps) -> dict:
    specs = await TOOL_SPECS.get(deps)
    if specs is None:
        prompt = f"{MCP_DOWN_NOTE}\n{prompt}"

    ctx = RunContext(deps)
    if specs:
        ctx.mcp = MCPAdapter(Client(mcp_transport(deps))).client  # MCPAdapter
        ctx.tools = {t.name: t for t in [await as_langchain_tool(s, ctx.mcp) for s in specs]}

    try:
        async with asyncio.timeout(RUN_TIMEOUT_S):
            return await get_agent().ainvoke(
                {"messages": [{"role": "user", "content": prompt}]},
                config={"recursion_limit": RECURSION_LIMIT},
                context=ctx,
            )
    finally:
        await ctx.aclose()




"""
Agent back-office.

Partagé par toutes les requêtes (créé une fois par process) : le modèle et le graphe compilé.
Propre à chaque requête : la liste d'outils MCP de l'utilisateur, instanciée avec son token.

Le graphe est compilé SANS outil MCP. Le middleware RequestTools lit les outils de la requête
dans le contexte du run (runtime.context) : il les ajoute à chaque appel modèle et les exécute
à chaque appel d'outil. C'est le mécanisme « dynamic tools » de LangChain (wrap_model_call +
wrap_tool_call). Deux utilisateurs qui tournent en même temps voient donc chacun leurs outils.

Coût par requête, une fois le cache chaud : aucun appel réseau et aucune compilation avant le
premier appel LLM. Il reste seulement la conversion des définitions MCP en outils LangChain.

Requiert Python >= 3.11 (asyncio.timeout).
"""
