    # --- construction ligne par ligne, avec reduction si necessaire -------
    lignes, tailles, debordements = [], [], []
    plafond = hauteur_utile - 4      # petite reserve
    for i, (_, ligne) in enumerate(df.iterrows()):
        taille = taille_police
