        "  sans embedding":
            "MATCH (c:Chunk) WHERE c.embedding IS NULL RETURN count(c) AS n",
        "Items": "MATCH (i:Item) RETURN count(i) AS n",
        "Relations": "MATCH ()-[r]->() RETURN count(r) AS n",
