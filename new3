# DejaVu couvre le latin etendu, les symboles, les monnaies, les fleches.
_CANDIDATS = [
    ("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
     "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"),
    ("C:/Windows/Fonts/DejaVuSans.ttf", "C:/Windows/Fonts/DejaVuSans-Bold.ttf"),
    ("C:/Windows/Fonts/arial.ttf", "C:/Windows/Fonts/arialbd.ttf"),
    ("/System/Library/Fonts/Supplemental/Arial.ttf",
     "/System/Library/Fonts/Supplemental/Arial Bold.ttf"),
]
POLICE, POLICE_G = "Helvetica", "Helvetica-Bold"
for reg, gras in _CANDIDATS:
    if os.path.exists(reg) and os.path.exists(gras):
        pdfmetrics.registerFont(TTFont("Doc", reg))
        pdfmetrics.registerFont(TTFont("Doc-Bold", gras))
        POLICE, POLICE_G = "Doc", "Doc-Bold"
        break


def _prepare(v):
    """Echappe le XML. Les caracteres speciaux passent tels quels."""
    if v is None or (isinstance(v, float) and pd.isna(v)):
        return ""
    return (str(v)
            .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace("\n", "<br/>"))


