            "t", fontName=POLICE_G, fontSize=12,
            textColor=colors.HexColor("#1A1A1A"), spaceAfter=10)))
    histoire.append(table)
    doc.build(histoire)

    if taille < taille_police or inter < interligne:
        print(f"[info] police uniforme ramenee a {taille} pt "
              f"(interligne {inter}) : c'est la plus grande taille permettant "
              f"a toutes les lignes de tenir sur une page.")
    if debordement:
        print("[ATTENTION] une ligne reste trop volumineuse meme a 3 pt. "
              "Passez en paysage, reduisez les marges, ou scindez la cellule.")
    return chemin_sortie


