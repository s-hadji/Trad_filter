    paysage=False,        # A4 portrait par defaut
    taille_police=9,
    police_mini=5.5,      # plancher de reduction automatique
    interligne=1.45,
    espacement=6,         # marge interieure des cellules (points)
    marge=15,             # marge de page (mm)
    seuil_justif=120,     # au-dela de N caracteres -> texte justifie
    largeurs=None,        # ex [33, 34, 33] en % ; None = colonnes egales
    taille_fixe=False,    # True = garde taille_police, quitte a couper une ligne
):
    page = landscape(A4) if paysage else A4
    m = marge * mm
    doc = SimpleDocTemplate(
        chemin_sortie, pagesize=page,
        leftMargin=m, rightMargin=m, topMargin=m, bottomMargin=m,
        title=titre or "Export",
    )
    largeur_utile = page[0] - 2 * m
    hauteur_utile = page[1] - 2 * m

    # colonnes de largeur egale, sauf indication contraire
    n = len(df.columns)
    if largeurs is None:
        # largeur identique au centieme de point pres pour toutes les colonnes
        unite = round(largeur_utile / n, 2)
        cols = [unite] * n
        largeur_utile = unite * n          # la table occupe exactement n x unite
    else:
        cols = [p / 100 * largeur_utile for p in largeurs]
        cols = [c * largeur_utile / sum(cols) for c in cols]

    def style_texte(taille, justifie, inter=None):
        return ParagraphStyle(
            "c", fontName=POLICE, fontSize=taille,
            leading=taille * (inter if inter else interligne),
            alignment=TA_JUSTIFY if justifie else TA_CENTER,
            splitLongWords=True, hyphenationLang="",
        )

    def construire_ligne(valeurs, taille, inter=None):
        cells = []
        for v in valeurs:
            txt = _prepare(v)
            # justification seulement si le contenu est assez long,
            # sinon les mots sont etires de facon disgracieuse
            cells.append(Paragraph(
                txt, style_texte(taille, len(txt) > seuil_justif, inter)))
        return cells

    STYLE = TableStyle([
        ("GRID", (0, 0), (-1, -1), 0.25, colors.HexColor("#B8B8B8")),
        ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
        ("LEFTPADDING", (0, 0), (-1, -1), espacement),
        ("RIGHTPADDING", (0, 0), (-1, -1), espacement),
        ("TOPPADDING", (0, 0), (-1, -1), espacement),
        ("BOTTOMPADDING", (0, 0), (-1, -1), espacement),
    ])

    def hauteur(cells):
        t = Table([cells], colWidths=cols)
        t.setStyle(STYLE)
        return t.wrap(largeur_utile, 10 ** 6)[1]

    # --- taille de police unique pour tout le document -------------------
    # On cherche la plus grande taille telle que MEME la ligne la plus
    # volumineuse tienne sur une page. Elle est ensuite appliquee partout.
    plafond = hauteur_utile - 4
    toutes = [ligne for _, ligne in df.iterrows()]

    def plus_haute(taille, inter):
        return max(hauteur(construire_ligne(l, taille, inter)) for l in toutes)

    taille, inter = taille_police, interligne
    while (not taille_fixe) and plus_haute(taille, inter) > plafond and taille > police_mini:
        taille = round(taille - 0.5, 1)
    if not taille_fixe and plus_haute(taille, inter) > plafond:  # interligne
        while plus_haute(taille, inter) > plafond and inter > 1.02:
            inter = round(inter - 0.05, 2)
    if not taille_fixe and plus_haute(taille, inter) > plafond:  # recours
        while plus_haute(taille, inter) > plafond and taille > 3.0:
            taille = round(taille - 0.25, 2)

    debordement = plus_haute(taille, inter) > plafond
    lignes = [construire_ligne(l, taille, inter) for l in toutes]

    st_entete = ParagraphStyle(
        "e", fontName=POLICE_G, fontSize=taille,
        leading=taille * inter, alignment=TA_CENTER,
        textColor=colors.HexColor("#1A1A1A"),
    )

    entete = [Paragraph(_prepare(c), st_entete) for c in df.columns]

    table = Table(
        [entete] + lignes,
        colWidths=cols,
        repeatRows=0,     # en-tete affiche une seule fois
        splitByRow=1,     # coupure entre les lignes uniquement
        splitInRow=1 if taille_fixe else 0,   # coupure autorisee si taille figee
    )
    style = TableStyle(STYLE.getCommands())
    style.add("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#EFEFEF"))
    style.add("LINEBELOW", (0, 0), (-1, 0), 0.8, colors.HexColor("#4D4D4D"))
    table.setStyle(style)

    histoire = []
    if titre:
