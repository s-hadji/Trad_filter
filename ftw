    modifications_apportees: ModificationDetaillee = Field(description="Détails.")

class FicheVersionGlobale(BaseModel):
    titre_fiche: str = Field(description="Titre de la release note.")
    resume_macro: str = Field(description="Synthèse de haut niveau.")
    sections: List[SectionFicheVersion] = Field(description="Modifications par chapitres.")


def generer_fiche_version_llm(noeud_pivot, payload_brut) -> FicheVersionGlobale:
    payload_textuel = json.dumps(payload_brut, indent=2, ensure_ascii=False)
    
    llm = ChatOpenAI(model="gpt-4o", temperature=0.1)
    llm_structure = llm.with_structured_output(FicheVersionGlobale)
    
    prompt_template = ChatPromptTemplate.from_messages([
        ("system", (
            "Vous êtes un ingénieur expert en documentation technique aéronautique et industrielle.\n"
            "Votre rôle est d'expliquer les modifications apportées à des modules de maintenance.\n\n"
            "Consignes d'analyse :\n"
            "- Les données fournies contiennent une liste explicite de modules ('dm_codes') associés à "
            "leur état d'origine ('texte_avant') et leur nouvel état ('texte_apres').\n"
            "- Expliquez de manière fluide et technique ce qui a changé. Ne parlez jamais de la structure du JSON.\n"
            "- Soyez factuel, neutre et n'utilisez aucun émoji ou artifice graphique."
        )),
        ("user", (
            "Voici les données claires de notre pack (Pivot : {nom_pivot}) :\n\n"
            "{input_data}\n\n"
            "Générez l'analyse des évolutions."
        ))
    ])
    
    chaine = prompt_template | llm_structure
    return chaine.invoke({"nom_pivot": noeud_pivot.name, "input_data": payload_textuel})


