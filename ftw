def epurer_texte(t):
    if not t: return ""
    t_clean = re.sub(r'[\.,\(\)\[\]\{\}!\?;:\*\+\-/\|—–_§•·]', ' ', t)
    return re.sub(r'\s+', ' ', t_clean).strip()

def extraire_tokens_perfo(texte):
    if not texte:
        return []
    pattern = r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]'
