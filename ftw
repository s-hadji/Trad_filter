def initialiser_noeud(nom, parent, dm_code=None, feuille=False):
    noeud = Node(nom, parent=parent)
    noeud.dm_code = dm_code
    noeud.feuille = feuille
    noeud.patches = []
    noeud.statut = "BRANCHE"
    return noeud


def construire_trie(entrees, parent):
    elements_ici = [e for e in entrees if not e[0]]
    if elements_ici:
        index_par_code = defaultdict(list)
        for _, code, doc, version in elements_ici:
            index_par_code[code].append((doc, version))
            
        for code, elements in index_par_code.items():
            items_v1 = [doc for doc, version in elements if version == "v1"]
            items_v2 = [doc for doc, version in elements if version == "v2"]
            taille_max = max(len(items_v1), len(items_v2))
            
            for i in range(taille_max):
                d1 = items_v1[i] if i < len(items_v1) else None
                d2 = items_v2[i] if i < len(items_v2) else None
                nom_feuille = f"[{code}]" if taille_max == 1 else f"[{code}] (p.{i+1})"
                
                noeud_feuille = initialiser_noeud(nom_feuille, parent, dm_code=code, feuille=True)
                noeud_feuille.doc_v1 = d1
                noeud_feuille.doc_v2 = d2

    elements_restants = [e for e in entrees if e[0]]
    if not elements_restants:
        return
        
    groupes_branches = defaultdict(list)
    for tokens, code, doc, version in elements_restants:
        groupes_branches[tokens[0].lower()].append((tokens, code, doc, version))
        
    for _, groupe in sorted(groupes_branches.items()):
        chemins = [e[0] for e in groupe]
        longueur_minimale = min(len(c) for c in chemins)
        prefixe_commun_taille = 0
        
        for i in range(longueur_minimale):
            if len({c[i].lower() for c in chemins}) == 1:
                prefixe_commun_taille = i + 1
            else:
                break
                
        nom_branche = " ".join(chemins[0][:prefixe_commun_taille])
        noeud_intermediaire = initialiser_noeud(nom_branche, parent)
        
        donnees_enfants = [(t[prefixe_commun_taille:], c, d, v) for t, c, d, v in groupe]
        construire_trie(donnees_enfants, noeud_intermediaire)


def propager_bottom_up(racine):
    for noeud in reversed(list(racine.descendants)):
        if noeud.feuille:
            d1 = getattr(noeud, 'doc_v1', None)
            d2 = getattr(noeud, 'doc_v2', None)
            
            if d1 is None and d2 is not None:
                noeud.statut = "AJOUTE"
                noeud.patches.append({"avant": "VIDE", "apres": d2["content"], "dm_code": noeud.dm_code})
            elif d2 is None and d1 is not None:
                noeud.statut = "SUPPRIME"
                noeud.patches.append({"avant": d1["content"], "apres": "VIDE", "dm_code": noeud.dm_code})
            elif d1 is not None and d2 is not None:
                liste_diffs = calculer_diff_mots(d1["content"], d2["content"])
                
                if not liste_diffs:
                    noeud.statut = "INCHANGE"
                else:
                    noeud.statut = "MODIFIE"
                    for avant, apres in liste_diffs:
                        noeud.patches.append({
                            "avant": avant,
                            "apres": apres,
                            "dm_code": noeud.dm_code
                        })
        else:
            for enfant in noeud.children:
                for patch in enfant.patches:
                    noeud.patches.append(patch)


# =====================================================================
