                if len({c[i].lower() for c in chemins}) == 1:
                    n_commun = i + 1
                else:
                    break
            noeud = make_node(" ".join(chemins[0][:n_commun]), parent)
            construire_trie([(c[n_commun:], code, t_complet) for c, code, t_complet in groupe], noeud)

