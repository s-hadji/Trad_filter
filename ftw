# 5. REINJECTION ET SUPERPOSITION APRES RETOUR LLM
# ==============================================================================
def superposer_et_reinjecter_analyses(commentaires_bruts_llm, registre_mutations_global):
    """
    Prend le dictionnaire de reponses fournies par le LLM pour chaque ID unique,
    et reconstruit la cartographie complete en superposant le commentaire sur toutes
    les sous-branches et modules concernes.
    """
    # Inversion de l'index pour travailler par Branche / Module de destination
    # Structure : { sous_branche: { bloc_id: [ (mutation, commentaire_llm), ... ] } }
    vue_applicative = defaultdict(lambda: defaultdict(list))
    
    for mut_text, info in registre_mutations_global.items():
        mod_id = info["id"]
        # Recuperation du commentaire du LLM pour cet ID, ou valeur par defaut si manquant
        commentaire = commentaires_bruts_llm.get(mod_id, "Aucune analyse disponible pour ce bloc.")
        
        for occ in info["occurrences"]:
            vue_applicative[occ["branche"]][occ["bloc"]].append({
                "mutation": mut_text,
                "commentaire_llm": commentaire
            })
            
    # Affichage final superposé et pret pour l'utilisateur ou l'IHM
    print("==================================================================")
    print("      RAPPORT DE SUPERPOSITION ET DE REINJECTION APRES LLM        ")
    print("==================================================================")
    for sous_branche, blocs in vue_applicative.items():
        print(f"Sous-Branche : {sous_branche}")
        for bloc_id, modifs in blocs.items():
            print(f"  Composant : {bloc_id}")
            for item in modifs:
                print(f"    - Modification brute : {item['mutation']}")
                print(f"      Analyse detaillee LLM  : {item['commentaire_llm']}")
        print("-" * 66)

