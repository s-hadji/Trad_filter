# 3. FORMATTAGE DU RAPPORT POUR TON LLM
# ==============================================================================
def generer_rapport_simple(modifications_groupees):
    if not modifications_groupees:
        return "Aucune modification pertinente trouvée."
        
    blocs_rapport = []
    for (avant, apres), codes in modifications_groupees.items():
