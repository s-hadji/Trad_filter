"""
modern_diff.py
==============
A modern, feature-rich extension of Python's difflib.HtmlDiff.

Features
--------
- Ultra-modern dark/light HTML rendering (glassmorphism, rounded corners,
  animated highlights, colour-coded changes)
- Three display modes: side-by-side, overlay (superimposed), unified
- Optional filename banners at the top
- Trivial-symbol filter: strips diffs that are *only* punctuation / isolated
  symbols so an LLM receives only semantically meaningful changes
- Markdown export for LLM consumption

Dependencies: Python ≥ 3.9, difflib (stdlib only)
"""

from __future__ import annotations

import difflib
import html
import re
import textwrap
from dataclasses import dataclass, field
from typing import Sequence


# ─────────────────────────────────────────────────────────────────────────────
# Trivial-symbol filter
# ─────────────────────────────────────────────────────────────────────────────

# Characters that are considered "isolated symbols" – a diff line whose
# *entire non-whitespace content* consists only of these is marked trivial.
_TRIVIAL_SYMBOLS: frozenset[str] = frozenset(
    r"""-/:;''.,?»«!()[]{}|@#$%^&*~`"'"""
)

_ONLY_SYMBOLS_RE = re.compile(
    r"^[\s\-/:;''.,?»«!()\[\]{}|@#$%^&*~`\"'\\<>]+$"
)


def _is_trivial_line(line: str) -> bool:
    """Return True if *line* contains nothing beyond isolated symbols."""
    stripped = line.strip()
    if not stripped:
        return True
    return bool(_ONLY_SYMBOLS_RE.match(stripped))


def _strip_trivial(
    opcodes: list[tuple],
    a_lines: list[str],
    b_lines: list[str],
) -> list[tuple]:
    """
    Walk a SequenceMatcher opcode list and demote 'replace'/'delete'/'insert'
    blocks to 'equal' when every changed line is trivial (symbol-only).
    """
    result = []
    for tag, i1, i2, j1, j2 in opcodes:
        if tag in ("replace", "delete", "insert"):
            a_chunk = a_lines[i1:i2]
            b_chunk = b_lines[j1:j2]
            changed_lines = a_chunk + b_chunk
            if changed_lines and all(_is_trivial_line(l) for l in changed_lines):
                # Treat as equal – just keep whichever side has content
                result.append(("equal", i1, i2, j1, j2))
                continue
        result.append((tag, i1, i2, j1, j2))
    return result


# ─────────────────────────────────────────────────────────────────────────────
# Data structures
# ─────────────────────────────────────────────────────────────────────────────

@dataclass
class DiffBlock:
    """One logical block of differences (used for Markdown / overlay)."""
    tag: str           # 'equal' | 'replace' | 'delete' | 'insert'
    a_lines: list[str] = field(default_factory=list)
    b_lines: list[str] = field(default_factory=list)
    a_start: int = 0   # 1-based line number in source file
    b_start: int = 0


