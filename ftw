# MOTEUR DE DIFF ET FUSION PAR CONTIGUÏTÉ RETRAVAILLÉ
# ══════════════════════════════════════════════════════════════════════════════

def diff_contenu(t1, t2):
    mots_v1 = extraire_tokens_perfo(t1)
    mots_v2 = extraire_tokens_perfo(t2)
    
    matcher = difflib.SequenceMatcher(None, mots_v1, mots_v2, autojunk=False)
    opcodes = matcher.get_opcodes()
    
    # SEUIL DE CONTIGUÏTÉ : Si moins de 5 mots identiques séparent deux changements,
    # on fusionne tout en un seul grand bloc logique.
    SEUIL_CONTIGUITE = 5
    blocs_fusionnes = []
    
    for action, i1, i2, j1, j2 in opcodes:
        if action != 'equal':
            if not blocs_fusionnes:
                blocs_fusionnes.append([i1, i2, j1, j2])
            else:
                dernier = blocs_fusionnes[-1]
                dist_v1 = i1 - dernier[1]
                dist_v2 = j1 - dernier[3]
                
                if dist_v1 <= SEUIL_CONTIGUITE and dist_v2 <= SEUIL_CONTIGUITE:
                    # Extension et absorption de la zone intermédiaire
                    dernier[1] = i2
                    dernier[3] = j2
                else:
                    blocs_fusionnes.append([i1, i2, j1, j2])
        
    patches_filtres = []
    for min_i, max_i, min_j, max_j in blocs_fusionnes:
        avant = " ".join(mots_v1[min_i:max_i])
        apres = " ".join(mots_v2[min_j:max_j])
        
        coeur_avant = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', avant).lower()
        coeur_apres = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', apres).lower()
        if coeur_avant == coeur_apres and coeur_avant != "":
            continue
            
        patches_filtres.append((avant, apres))
        
    return patches_filtres


