    nom_chemin = f"{chemin_actuel} > {noeud.name}" if chemin_actuel else noeud.name
    
    # On isole uniquement les modules ayant subi un changement (Modifié, Nouveau, Supprimé)
    modules_modifies = {k: v for k, v in noeud.modules.items() if v["status"] != "IDENTIQUE"}
    
    if modules_modifies:
        print(f"\n📂 Sous-Chapitre : {nom_chemin}")
        for dm_code, mod in modules_modifies.items():
