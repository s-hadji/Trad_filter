# ══════════════════════════════════════════════════════════════════════════════
# STRUCTURE DE L'ARBRE (STANDALONE AVEC TRAÇABILITÉ DES DMC)
# ══════════════════════════════════════════════════════════════════════════════

TOKENS_PARASITES = {'-', '/', '|', '–', '—', '·', '>', '→', '->'}

class Node:
    def __init__(self, name, parent=None):
        self.name = name
        self.parent = parent
        self.children = []
        if parent:
            parent.children.append(self)
        self.dm_code = None
        self.feuille = False
        self.patches = []          
        self.statut = "BRANCHE"
        self.tokens_cumules = 0  
        self.doc_v1 = None
        self.doc_v2 = None

    @property
    def descendants(self):
        nodes = []
        for child in self.children:
            nodes.append(child)
            nodes.extend(child.descendants)
        return nodes

    @property
    def path(self):
        path = []
        current = self
        while current:
            path.insert(0, current)
            current = current.parent
        return path

    @property
    def depth(self):
        return len(self.path) - 1


# ══════════════════════════════════════════════════════════════════════════════
# FONCTIONS DE NETTOYAGE ET SÉPARATION FINE (TOKENIZER PERFO)
# ══════════════════════════════════════════════════════════════════════════════

def normaliser(ligne):
    if not ligne:
        return []
    ligne = unicodedata.normalize('NFKC', ligne.splitlines()[0])
    ligne = re.sub(r'\s+', ' ', ligne).strip()
    return [t for t in ligne.split(' ') if t and t not in TOKENS_PARASITES]

def extraire(dico):
    return [d for d in dico if d["type"] == "XML_procedure"]

def extraire_tokens_perfo(texte):
    if not texte:
        return []
    pattern = r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]'
    return re.findall(pattern, texte)


# ══════════════════════════════════════════════════════════════════════════════
# MOTEUR DE DIFF ET FUSION PAR CONTIGUÏTÉ
# ══════════════════════════════════════════════════════════════════════════════

def diff_contenu(t1, t2):
    mots_v1 = extraire_tokens_perfo(t1)
    mots_v2 = extraire_tokens_perfo(t2)
    
    matcher = difflib.SequenceMatcher(None, mots_v1, mots_v2, autojunk=False)
    opcodes = matcher.get_opcodes()
    
    groupes_patches = []
    groupe_actuel = []
    
    for action, i1, i2, j1, j2 in opcodes:
        if action != 'equal':
            groupe_actuel.append((i1, i2, j1, j2))
        else:
            if groupe_actuel:
                groupes_patches.append(groupe_actuel)
                groupe_actuel = []
    if groupe_actuel:
        groupes_patches.append(groupe_actuel)
        
    patches_filtres = []
    for groupe in groupes_patches:
        min_i, max_i = groupe[0][0], groupe[-1][1]
        min_j, max_j = groupe[0][2], groupe[-1][3]
        
        avant = " ".join(mots_v1[min_i:max_i])
        apres = " ".join(mots_v2[min_j:max_j])
        
        coeur_avant = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', avant).lower()
        coeur_apres = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', apres).lower()
        if coeur_avant == coeur_apres:
            continue
            
        patches_filtres.append((avant, apres))
        
    return patches_filtres


# ══════════════════════════════════════════════════════════════════════════════
# REGROUPEMENT ET COMPRESSION PAR TRACABILITÉ DMC (SANS PERTE)
# ══════════════════════════════════════════════════════════════════════════════

def compresser_patches_sous_arbre(patches):
    """
    Regroupe strictement par couple (avant, apres) identique.
    Associe de facon limpide la liste des DMC concernes a cette transformation exacte.
    """
    if not patches: 
        return []
        
    # Clé : (texte_avant, texte_apres) -> Valeur : Liste des codes DMC
    regroupement = defaultdict(list)
    for p in patches:
        cle_transformation = (p["avant"].strip(), p["apres"].strip())
        regroupement[cle_transformation].append(p["dm_code"])
        
    regles_traçables = []
    for (avant, apres), codes in regroupement.items():
        regles_traçables.append({
            "avant": avant,
            "apres": apres,
            "codes_dmc": sorted(list(set(codes))) # Déduplication des DMC ayant subi ce changement exact
        })
    return regles_traçables


# ══════════════════════════════════════════════════════════════════════════════
# GESTION, PROPAGATION ET PLANIFICATION DE L'ARBRE
# ══════════════════════════════════════════════════════════════════════════════

def construire_trie(entrees, parent):
    ici = [e for e in entrees if not e[0]]
    if ici:
        by_code = defaultdict(list)
        for _, code, doc, version in ici:
            by_code[code].append((doc, version))
        for code, items in by_code.items():
            v1_items = [doc for doc, version in items if version == "v1"]
            v2_items = [doc for doc, version in items if version == "v2"]
            max_len = max(len(v1_items), len(v2_items))
            for i in range(max_len):
                d1 = v1_items[i] if i < len(v1_items) else None
                d2 = v2_items[i] if i < len(v2_items) else None
                nom_feuille = f"[{code}]" + (f" (p.{i+1})" if max_len > 1 else "")
                noeud_feuille = Node(nom_feuille, parent=parent)
                noeud_feuille.dm_code = code
                noeud_feuille.feuille = True
                noeud_feuille.doc_v1 = d1
                noeud_feuille.doc_v2 = d2

    restants = [e for e in entrees if e[0]]
    if not restants: return
    groupes = defaultdict(list)
    for tokens, code, doc, version in restants:
        groupes[tokens[0].lower()].append((tokens, code, doc, version))
    for _, groupe in sorted(groupes.items()):
        chemins = [e[0] for e in groupe]
        min_len = min(len(c) for c in chemins)
        n_commun = 0
        for i in range(min_len):
            if len({c[i].lower() for c in chemins}) == 1: n_commun = i + 1
            else: break
        nom_branche = " ".join(chemins[0][:n_commun])
        noeud_intermediaire = Node(nom_branche, parent=parent)
        construire_trie([(t[n_commun:], c, d, v) for t, c, d, v in groupe], noeud_intermediaire)

def propager_bottom_up(racine):
    for noeud in reversed(list(racine.descendants)):
        if noeud.feuille:
            d1 = getattr(noeud, 'doc_v1', None)
            d2 = getattr(noeud, 'doc_v2', None)
            if d1 is None and d2 is not None:
                noeud.statut = "AJOUTE"
                noeud.patches.append({"avant": "VIDE", "apres": d2["content"], "dm_code": noeud.dm_code})
            elif d2 is None and d1 is not None:
                noeud.statut = "SUPPRIME"
                noeud.patches.append({"avant": d1["content"], "apres": "VIDE", "dm_code": noeud.dm_code})
            elif d1 is not None and d2 is not None:
                t1, t2 = d1["content"], d2["content"]
                if re.sub(r'\s+', ' ', t1).strip() == re.sub(r'\s+', ' ', t2).strip():
                    noeud.statut = "INCHANGE"
                else:
                    noeud.statut = "MODIFIE"
                    for avant, apres in diff_contenu(t1, t2):
                        noeud.patches.append({"avant": avant, "apres": apres, "dm_code": noeud.dm_code})
        else:
            for patch in [p for enfant in noeud.children for p in enfant.patches]:
                noeud.patches.append(patch)

def estimer_tokens_arbre(noeud):
    modifs_uniques = {(p["avant"], p["apres"]) for p in noeud.patches}
    noeud.tokens_cumules = sum(len(av.split()) + len(ap.split()) for av, ap in modifs_uniques)
    
    if not noeud.feuille:
        for enfant in noeud.children:
            estimer_tokens_arbre(enfant)

def planifier_appels_llm(racine, budget_max_appels=10, limite_tokens_par_appel=2000):
    selection_pivots = [racine]
    continuer = True
    
    while continuer:
        continuer = False
        nouvelle_selection = []
        for noeud in selection_pivots:
            if noeud.tokens_cumules > limite_tokens_par_appel and not noeud.feuille:
                nouvelle_selection.extend(noeud.children)
                continuer = True
            else:
                nouvelle_selection.append(noeud)
        selection_pivots = nouvelle_selection

    if len(selection_pivots) > budget_max_appels:
        return selection_pivots

    while len(selection_pivots) < budget_max_appels:
        divisibles = [n for n in selection_pivots if not n.feuille]
        if not divisibles:
            break
        noeud_cible = max(divisibles, key=lambda n: n.tokens_cumules)
        croissance = len(noeud_cible.children) - 1
        if len(selection_pivots) + croissance <= budget_max_appels:
            selection_pivots.remove(noeud_cible)
            selection_pivots.extend(noeud_cible.children)
        else:
            eligibles = [n for n in divisibles if len(n.children) - 1 <= (budget_max_appels - len(selection_pivots))]
            if not eligibles:
                break
            noeud_compromis = max(eligibles, key=lambda n: n.tokens_cumules)
            selection_pivots.remove(noeud_compromis)
            selection_pivots.extend(noeud_compromis.children)
            
    return selection_pivots


# ══════════════════════════════════════════════════════════════════════════════
# COMPACTAGE ET EXTRACTION DU PAYLOAD
# ══════════════════════════════════════════════════════════════════════════════

def extraire_payload_du_pivot(noeud_pivot):
    packs_chapitres = []
    noeuds_a_traiter = [noeud_pivot] if noeud_pivot.feuille else [n for n in noeud_pivot.descendants if not n.feuille and n.patches]
    if not noeuds_a_traiter and noeud_pivot.patches:
        noeuds_a_traiter = [noeud_pivot]

    for n in noeuds_a_traiter:
        regles = compresser_patches_sous_arbre(n.patches)
        if regles:
            chemin = " > ".join(a.name for a in n.path)
            pack = {"chapitre": chemin, "transformations_explicites": []}
            for r in regles:
                pack["transformations_explicites"].append({
                    "dm_codes_impactes": r["codes_dmc"],
                    "texte_avant": r["avant"],
                    "texte_apres": r["apres"]
                })
            packs_chapitres.append(pack)
            
    return packs_chapitres


