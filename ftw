import difflib
import json
from typing import List
from pydantic import BaseModel, Field
from langchain_core.prompts import ChatPromptTemplate
from langchain_openai import ChatOpenAI

# ══════════════════════════════════════════════════════════════════════════════
# 1. STRUCTURE DE L'ARBRE (ADAPTÉE À TON FORMAT DE DONNÉES)
# ══════════════════════════════════════════════════════════════════════════════

class Node:
    def __init__(self, name, parent=None):
        self.name = name
        self.parent = parent
        self.children = {}  # Stockage direct par {nom: Node}
        self.is_leaf = False
        self.dm_code = None
        self.v1 = None
        self.v2 = None
        self.difference = None  # Contiendra le bloc de diff (unified_diff) avec contexte
        self.tokens = 0

    @property
    def path(self):
        """Reconstitue la chaîne des chapitres du sommet jusqu'à ce nœud."""
        chemin = []
        courant = self
        while courant:
            chemin.insert(0, courant)
            courant = courant.parent
        return chemin


def batir_arbre(dico_v1, dico_v2):
    """
    Construit l'arbre unifié en lisant directement ton format de dictionnaire :
    - Filtre sur 'XML_procedure'
    - Extraction du chemin via 'DM_title' découpé par le séparateur '>'
    - Extraction du code via 'DM_code'
    """
    racine = Node("Root")
    
    # Filtrage des procédures v1
    liste_v1 = [d for d in dico_v1 if d.get("type") == "XML_procedure"]
    for d in liste_v1:
        extra = d.get("extra_information", {})
        titre = extra.get("DM_title", "Sans Titre")
        dm_code = extra.get("DM_code", "UNK")
        
        # Nettoyage et découpage du titre (ex: "Hydraulique > Vannes" -> ["Hydraulique", "Vannes"])
        chemin = [etape.strip() for etape in titre.split(">") if etape.strip()]
        
        courant = racine
        for etape in chemin:
            courant = courant.children.setdefault(etape, Node(etape, parent=courant))
            
        feuille = courant.children.setdefault(dm_code, Node(dm_code, parent=courant))
        feuille.is_leaf = True
        feuille.dm_code = dm_code
        feuille.v1 = d.get("content", "")

    # Fusion des procédures v2
    liste_v2 = [d for d in dico_v2 if d.get("type") == "XML_procedure"]
    for d in liste_v2:
        extra = d.get("extra_information", {})
        titre = extra.get("DM_title", "Sans Titre")
        dm_code = extra.get("DM_code", "UNK")
        
        chemin = [etape.strip() for etape in titre.split(">") if etape.strip()]
        
        courant = racine
        for etape in chemin:
            courant = courant.children.setdefault(etape, Node(etape, parent=courant))
            
        feuille = courant.children.setdefault(dm_code, Node(dm_code, parent=courant))
        feuille.is_leaf = True
        feuille.dm_code = dm_code
        feuille.v2 = d.get("content", "")
        
    return racine


# ══════════════════════════════════════════════════════════════════════════════
# 2. MOTEUR DE DIFF PAR LIGNE ET PROPAGATION DES POIDS
# ══════════════════════════════════════════════════════════════════════════════

def generer_diff_et_tokens(noeud):
    """Compare v1 et v2 ligne par ligne avec 1 ligne de contexte autour des modifs."""
    if noeud.is_leaf:
        t1 = (noeud.v1 or "").strip()
        t2 = (noeud.v2 or "").strip()
        
        if t1 == t2:
            noeud.difference = None
            noeud.tokens = 0
        else:
            lignes_v1 = t1.splitlines()
            lignes_v2 = t2.splitlines()
            
            # n=1 force à prendre 1 ligne de contexte avant et après la modification
            diff_generateur = difflib.unified_diff(lignes_v1, lignes_v2, n=1, lineterm="")
            liste_diff = list(diff_generateur)
            
            if len(liste_diff) > 2:
                # On enlève les en-têtes système (--- et +++) inutiles pour le LLM
                noeud.difference = "\n".join(liste_diff[2:])
                # On compte les tokens UNIQUEMENT sur le paquet de modification + son contexte
                noeud.tokens = len(noeud.difference.split())
            else:
                noeud.difference = None
                noeud.tokens = 0
                
    for enfant in noeud.children.values():
        generer_diff_et_tokens(enfant)


def clean_diff_tree(noeud):
    """Élimine de l'arbre toutes les branches ou feuilles sans aucune modification."""
    for nom, enfant in list(noeud.children.items()):
        clean_diff_tree(enfant)
        if (enfant.is_leaf and enfant.difference is None) or (not enfant.is_leaf and not enfant.children):
            del noeud.children[nom]


def imposer_poids_branches(noeud):
    """Remonte récursivement la somme des tokens des lignes modifiées vers les parents."""
    if noeud.is_leaf:
        return noeud.tokens
    noeud.tokens = sum(imposer_poids_branches(e) for e in noeud.children.values())
    return noeud.tokens


# ══════════════════════════════════════════════════════════════════════════════
# 3. ALGORITHME D'OPTIMISATION DU BUDGET D'APPELS LLM
# ══════════════════════════════════════════════════════════════════════════════

def optimiser_appels_llm(racine, M, max_token):
    """Détermine au maximum M nœuds pivots sans dépasser le plafond max_token."""
    pivots = [racine]
    while len(pivots) < M:
        candidats = [n for n in pivots if n.tokens > max_token and n.children]
        if not candidats:
            break
        pire_noeud = max(candidats, key=lambda n: n.tokens)
        if len(pivots) - 1 + len(pire_noeud.children) <= M:
            pivots.remove(pire_noeud)
            pivots.extend(pire_noeud.children.values())
        else:
            break
    return pivots


def extraire_payload_du_pivot(noeud_pivot):
    """Extrait toutes les feuilles modifiées situées sous un nœud pivot sélectionné."""
    def collecter_feuilles(n):
        if n.is_leaf:
            # Reconstitution propre de la chaîne de chapitres
            chemin_chapitre = " > ".join(p.name for p in n.path[:-1] if p.name != "Root")
            return [{
                "chapitre": chemin_chapitre or "Général",
                "dm_code": n.dm_code,
                "difference": n.difference
            }]
        res = []
        for child in n.children.values():
            res.extend(collecter_feuilles(child))
        return res
    return collecter_feuilles(noeud_pivot)


