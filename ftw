                if t1_clean == t2_clean:
                    noeud.statut = "INCHANGE"
                else:
                    noeud.statut = "MODIFIE"
                    ratio = difflib.SequenceMatcher(None, t1_clean, t2_clean).ratio()
                    noeud.ratio = ratio
                    
                    ancetres = " > ".join(a.name for a in noeud.ancestors if a.name != racine.name)
                    for avant, apres in diff_contenu(t1, t2):
                        noeud.patches.append({
                            "avant":    avant,
