                        f'<td class="u-sig">+</td>'
                        f'<td class="u-code">{_he(ln_text)}</td>'
                        f"</tr>"
                    )

        return (
            '<table class="unified-table">'
            "<tbody>" + "".join(rows) + "</tbody>"
            "</table>"
        )
