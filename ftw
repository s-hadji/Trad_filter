            npatch = f" ({len(n.patches)} modif)" if n.patches else ""
            print(f"{pre}{ICONES[n.statut]} {n.name}  [{n.dm_code}]{ratio}{npatch}")
        else:
            total = len(n.patches)
            rep   = len(n.patterns)
            print(f"{pre}📁 {n.name}  [{total} modif, {rep} patterns répétés]")

def afficher_rapport_bottom_up(racine):
