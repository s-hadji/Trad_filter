def normaliser_titre(titre):
    if not titre:
        return []
    titre_normalise = unicodedata.normalize('NFKC', titre.splitlines()[0])
    titre_normalise = re.sub(r'\s+', ' ', titre_normalise).strip()
    
    separateurs = {'-', '/', '|', '–', '—', '·', '>', '→', '->'}
    mots = titre_normalise.split(' ')
    return [mot for mot in mots if mot and mot not in separateurs]


def extraire_procedures(jeu_donnees):
    return [doc for doc in jeu_donnees if doc.get("type") == "XML_procedure"]


# =====================================================================
# MOTEUR DE DIFF AVEC TOKENISATION ET FUSION PAR CONTIGUÏTÉ
# =====================================================================

def extraire_tokens_perfo(texte):
    if not texte:
        return []
    pattern = r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]'
    return re.findall(pattern, texte)


def calculer_diff_mots(texte_v1, texte_v2):
    """
    Analyse les diffs, fusionne les modifications contigues (qui se suivent directement)
    pour eviter la fragmentation, puis applique le filtre anti-parasite.
    """
    mots_v1 = extraire_tokens_perfo(texte_v1)
    mots_v2 = extraire_tokens_perfo(texte_v2)
    
    matcher = difflib.SequenceMatcher(None, mots_v1, mots_v2, autojunk=False)
    opcodes = matcher.get_opcodes()
    
    # 1. Regroupement des opcodes non-'equal' qui sont contigus
    groupes_patches = []
    groupe_actuel = []
    
    for action, i1, i2, j1, j2 in opcodes:
        if action != 'equal':
            groupe_actuel.append((i1, i2, j1, j2))
        else:
            if groupe_actuel:
                groupes_patches.append(groupe_actuel)
                groupe_actuel = []
    if groupe_actuel:
        groupes_patches.append(groupe_actuel)
        
    # 2. Reconstruction des chaines "avant" et "apres" fusionnees par continuite
    patches_bruts = []
    for groupe in groupes_patches:
        min_i = groupe[0][0]
        max_i = groupe[-1][1]
        min_j = groupe[0][2]
        max_j = groupe[-1][3]
        
        avant = " ".join(mots_v1[min_i:max_i])
        apres = " ".join(mots_v2[min_j:max_j])
        patches_bruts.append((avant, apres))
        
    # 3. Filtrage final des bruits et parasites sur les blocs consolides
    patches_filtres = []
    for avant, apres in patches_bruts:
        coeur_avant = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', avant).lower()
        coeur_apres = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', apres).lower()
        
        if coeur_avant == coeur_apres:
            continue
            
        patches_filtres.append((avant, apres))
        
    return patches_filtres


