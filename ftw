# SCHÉMAS DE SORTIE STRUCTURÉE (PYDANTIC)
# ══════════════════════════════════════════════════════════════════════════════

class ModificationDetaillee(BaseModel):
    descriptions: List[str] = Field(
        description="Description humaine, claire et technique des evolutions observees entre l'ancienne et la nouvelle valeur."
    )

class SectionFicheVersion(BaseModel):
    chapitre: str = Field(description="Chemin complet ou chapitre cible de la modification.")
    codes_dm: List[str] = Field(description="Liste dedupliquee des codes DM (DMC) concernes par ce bloc.")
    modifications_apportees: ModificationDetaillee = Field(description="Synthese descriptive de la modification.")

class FicheVersionGlobale(BaseModel):
    titre_fiche: str = Field(description="Intitule formel de la note de version.")
    resume_macro: str = Field(description="Explication globale de haut niveau synthetisant l'impact technique global.")
    sections: List[SectionFicheVersion] = Field(description="Ensemble des chapitres modifies.")


