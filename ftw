        self.feuille = False
        self.patches = []          
        self.statut = "BRANCHE"
        self.tokens_cumules = 0  
        self.doc_v1 = None
        self.doc_v2 = None

    @property
    def path(self):
        path = []
        current = self
        while current:
            path.insert(0, current)
            current = current.parent
        return path


