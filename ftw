def condenser_valeurs_after(series_after):
    """
    Prend une liste de chaînes 'after' et détecte automatiquement la partie 
    commune (prefixe/suffixe) pour ne lister que les éléments uniques qui changent.
    """
    valeurs = sorted(list(set(series_after.astype(str))))
    if not valeurs:
        return ""
    if len(valeurs) == 1:
        return valeurs[0]
        
    # 1. Trouver le plus long préfixe commun
    prefixe = ""
    taille_min = min(len(s) for s in valeurs)
    for i in range(taille_min):
        char = valeurs[0][i]
        if all(s[i] == char for s in valeurs):
            prefixe += char
        else:
            break
            
    # 2. Trouver le plus long suffixe commun
    suffixe = ""
    for i in range(1, taille_min - len(prefixe) + 1):
        char = valeurs[0][-i]
        if all(s[-i] == char for s in valeurs):
            suffixe = char + suffixe
        else:
            break
            
    # 3. Extraire uniquement la partie qui change (la variable unique)
    elements_uniques = []
    len_pre = len(prefixe)
    len_suf = len(suffixe)
    
    for s in valeurs:
        fin_idx = len(s) - len_suf if len_suf > 0 else len(s)
        variable = s[len_pre:fin_idx].strip()
        if variable:
            elements_uniques.append(variable)
            
    if elements_uniques:
        try:
            elements_uniques = sorted(list(set(elements_uniques)), key=lambda x: int(x))
        except ValueError:
            elements_uniques = sorted(list(set(elements_uniques)))
            
        if prefixe or suffixe:
            return f"{prefixe}{', '.join(elements_uniques)}{suffixe}"
        else:
            return " / ".join(valeurs)
            
    return prefixe + suffixe

