    return re.findall(pattern, text=texte)


# ══════════════════════════════════════════════════════════════════════════════
# MOTEUR DE DIFF ET FUSION PAR CONTIGUÏTÉ RETRAVAILLÉ
# ══════════════════════════════════════════════════════════════════════════════

def diff_contenu(t1, t2):
    mots_v1 = extraire_tokens_perfo(t1)
    mots_v2 = extraire_tokens_perfo(t2)
    
    matcher = difflib.SequenceMatcher(None, mots_v1, mots_v2, autojunk=False)
    opcodes = matcher.get_opcodes()
    
    # SEUIL DE CONTIGUÏTÉ : Si moins de 5 mots identiques séparent deux changements,
    # on fusionne tout en un seul grand bloc logique.
    SEUIL_CONTIGUITE = 5
    blocs_fusionnes = []
    
    for action, i1, i2, j1, j2 in opcodes:
        if action != 'equal':
            if not blocs_fusionnes:
                blocs_fusionnes.append([i1, i2, j1, j2])
            else:
                dernier = blocs_fusionnes[-1]
                dist_v1 = i1 - dernier[1]
                dist_v2 = j1 - dernier[3]
                
                if dist_v1 <= SEUIL_CONTIGUITE and dist_v2 <= SEUIL_CONTIGUITE:
                    # Extension et absorption de la zone intermédiaire
                    dernier[1] = i2
                    dernier[3] = j2
                else:
                    blocs_fusionnes.append([i1, i2, j1, j2])
        
    patches_filtres = []
    for min_i, max_i, min_j, max_j in blocs_fusionnes:
        avant = " ".join(mots_v1[min_i:max_i])
        apres = " ".join(mots_v2[min_j:max_j])
        
        coeur_avant = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', avant).lower()
        coeur_apres = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', apres).lower()
        if coeur_avant == coeur_apres and coeur_avant != "":
            continue
            
        patches_filtres.append((avant, apres))
        
    return patches_filtres


# ══════════════════════════════════════════════════════════════════════════════
# GESTION ET PROPAGATION DANS L'ARBRE
# ══════════════════════════════════════════════════════════════════════════════

def construire_trie(entrees, parent):
    ici = [e for e in entrees if not e[0]]
    if ici:
        by_code = defaultdict(list)
        for _, code, doc, version in ici:
            by_code[code].append((doc, version))
        for code, items in by_code.items():
            v1_items = [doc for doc, version in items if version == "v1"]
            v2_items = [doc for doc, version in items if version == "v2"]
            max_len = max(len(v1_items), len(v2_items))
            for i in range(max_len):
                d1 = v1_items[i] if i < len(v1_items) else None
                d2 = v2_items[i] if i < len(v2_items) else None
                nom_feuille = f"[{code}]" + (f" (p.{i+1})" if max_len > 1 else "")
                noeud_feuille = Node(nom_feuille, parent=parent)
                noeud_feuille.dm_code = code
                noeud_feuille.feuille = True
                noeud_feuille.doc_v1 = d1
                noeud_feuille.doc_v2 = d2

    restants = [e for e in entrees if e[0]]
    if not restants: return
    groupes = defaultdict(list)
    for tokens, code, doc, version in restants:
        groupes[tokens[0].lower()].append((tokens, code, doc, version))
    for _, groupe in sorted(groupes.items()):
        chemins = [e[0] for e in groupe]
        min_len = min(len(c) for c in chemins)
        n_commun = 0
        for i in range(min_len):
            if len({c[i].lower() for c in chemins}) == 1: n_commun = i + 1
            else: break
        nom_branche = " ".join(chemins[0][:n_commun])
        noeud_intermediaire = Node(nom_branche, parent=parent)
        construire_trie([(t[n_commun:], c, d, v) for t, c, d, v in groupe], noeud_intermediaire)


def propager_bottom_up(racine):
    """Identifie le statut et génère des descriptions claires pour les structures."""
    for noeud in reversed(list(racine.descendants)):
        if noeud.feuille:
            d1 = getattr(noeud, 'doc_v1', None)
            d2 = getattr(noeud, 'doc_v2', None)
            
            # Insertions : Message propre sans saturer de tokens
            if d1 is None and d2 is not None:
                noeud.statut = "AJOUTE"
                noeud.patches.append({
                    "avant": "[Néant - Nouveau Module Documentaire]", 
                    "apres": f"Création et insertion complète du module {noeud.dm_code}", 
                    "dm_code": noeud.dm_code
                })
            # Suppressions
            elif d2 is None and d1 is not None:
                noeud.statut = "SUPPRIME"
                noeud.patches.append({
                    "avant": f"Suppression complète du module {noeud.dm_code}", 
                    "apres": "[Supprimé du référentiel]", 
                    "dm_code": noeud.dm_code
                })
            elif d1 is not None and d2 is not None:
                t1, t2 = d1["content"], d2["content"]
                if re.sub(r'\s+', ' ', t1).strip() == re.sub(r'\s+', ' ', t2).strip():
                    noeud.statut = "INCHANGE"
                else:
                    noeud.statut = "MODIFIE"
                    for avant, apres in diff_contenu(t1, t2):
                        noeud.patches.append({"avant": avant, "apres": apres, "dm_code": noeud.dm_code})
        else:
            for patch in [p for enfant in noeud.children for p in enfant.patches]:
                noeud.patches.append(patch)


def estimer_tokens_arbre(noeud):
    modifs_uniques = {(p["avant"], p["apres"]) for p in noeud.patches}
    noeud.tokens_cumules = sum(len(av.split()) + len(ap.split()) for av, ap in modifs_uniques)
    if not noeud.feuille:
        for enfant in noeud.children:
            estimer_tokens_arbre(enfant)


def planifier_appels_llm(racine, budget_max_appels=10, limite_tokens_par_appel=2000):
    selection_pivots = [racine]
    continuer = True
    while continuer:
        continuer = False
        nouvelle_selection = []
        for noeud in selection_pivots:
            if noeud.tokens_cumules > limite_tokens_par_appel and not noeud.feuille:
                nouvelle_selection.extend(noeud.children)
                continuer = True
            else:
                nouvelle_selection.append(noeud)
        selection_pivots = nouvelle_selection
    return selection_pivots[:budget_max_appels]


# ══════════════════════════════════════════════════════════════════════════════
# COMPACTAGE ET FACTORISATION PAR TRAJECTOIRE STRICTE (LA CORRECTION)
# ══════════════════════════════════════════════════════════════════════════════

def extraire_payload_du_pivot(noeud_pivot):
    """
    Regroupe les modules par TRAJECTOIRE EXACTE (Même Avant -> Même Après).
    Supprime définitivement les notations illisibles de type [ A | B ].
    """
    packs_chapitres = []
    
    # Récupération des feuilles valides sous le pivot
    noeuds_feuilles = [noeud_pivot] if noeud_pivot.feuille else [n for n in noeud_pivot.descendants if n.feuille and n.patches]
    if not noeuds_feuilles and noeud_pivot.patches:
        noeuds_feuilles = [noeud_pivot]

    # Étape 1 : Classer les patches par Chapitre d'arborescence (Pour situer le "Où")
    patches_par_chapitre = defaultdict(list)
    for n in noeuds_feuilles:
        # Nettoyage du nom de chemin pour ne garder que les dossiers de l'arborescence
        chemin = " > ".join(a.name for a in n.path if not a.name.startswith("["))
        for p in n.patches:
            patches_par_chapitre[chemin].append(p)

    # Étape 2 : Pour chaque chapitre, factoriser uniquement par trajectoire identique
    for chapitre, liste_patches in patches_par_chapitre.items():
        trajectoires_identiques = defaultdict(set)
        
        for p in liste_patches:
            cle_trajectoire = (p["avant"].strip(), p["apres"].strip())
            trajectoires_identiques[cle_trajectoire].add(p["dm_code"])
            
        changements_facto = []
        for (avant, apres), codes_dm in trajectoires_identiques.items():
            changements_facto.append({
                "dm_codes": sorted(list(codes_dm)), # Liste claire des modules impactés par cette modif exacte
                "texte_avant": avant,
                "texte_apres": apres
            })
            
        if changements_facto:
            packs_chapitres.append({
                "chapitre": chapitre,
                "changements": changements_facto
            })
            
    return packs_chapitres


