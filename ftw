                    )
            elif bl.tag == "replace":
                for ln_text in bl.a_lines:
                    a_ln += 1
                    rows.append(
                        f'<tr class="u-row-del">'
                        f'<td class="u-ln">{a_ln}</td>'
                        f'<td class="u-ln"></td>'
                        f'<td class="u-sig">−</td>'
                        f'<td class="u-code">{_he(ln_text)}</td>'
