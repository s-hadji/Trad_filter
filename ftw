        nouvelle_selection = []
        for noeud in selection_pivots:
            if noeud.tokens_cumules > limite_tokens_par_appel and not noeud.feuille:
                nouvelle_selection.extend(noeud.children)
                continuer = True
            else:
                nouvelle_selection.append(noeud)
        selection_pivots = nouvelle_selection
    return selection_pivots[:budget_max_appels]


# ══════════════════════════════════════════════════════════════════════════════
# COMPACTAGE ET FACTORISATION PAR TRAJECTOIRE STRICTE (LA CORRECTION)
# ══════════════════════════════════════════════════════════════════════════════

def extraire_payload_du_pivot(noeud_pivot):
    """
    Regroupe les modules par TRAJECTOIRE EXACTE (Même Avant -> Même Après).
    Supprime définitivement les notations illisibles de type [ A | B ].
    """
    packs_chapitres = []
    
    # Récupération des feuilles valides sous le pivot
    noeuds_feuilles = [noeud_pivot] if noeud_pivot.feuille else [n for n in noeud_pivot.descendants if n.feuille and n.patches]
    if not noeuds_feuilles and noeud_pivot.patches:
        noeuds_feuilles = [noeud_pivot]

    # Étape 1 : Classer les patches par Chapitre d'arborescence (Pour situer le "Où")
    patches_par_chapitre = defaultdict(list)
    for n in noeuds_feuilles:
        # Nettoyage du nom de chemin pour ne garder que les dossiers de l'arborescence
        chemin = " > ".join(a.name for a in n.path if not a.name.startswith("["))
        for p in n.patches:
            patches_par_chapitre[chemin].append(p)

    # Étape 2 : Pour chaque chapitre, factoriser uniquement par trajectoire identique
    for chapitre, liste_patches in patches_par_chapitre.items():
        trajectoires_identiques = defaultdict(set)
        
        for p in liste_patches:
            cle_trajectoire = (p["avant"].strip(), p["apres"].strip())
            trajectoires_identiques[cle_trajectoire].add(p["dm_code"])
            
        changements_facto = []
        for (avant, apres), codes_dm in trajectoires_identiques.items():
            changements_facto.append({
                "dm_codes": sorted(list(codes_dm)), # Liste claire des modules impactés par cette modif exacte
                "texte_avant": avant,
                "texte_apres": apres
            })
            
        if changements_facto:
            packs_chapitres.append({
                "chapitre": chapitre,
                "changements": changements_facto
            })
            
    return packs_chapitres


