import re
import difflib
import unicodedata
from collections import defaultdict
# Depuis ta librairie d'arbre (ex: anytree) :
# from anytree import Node, RenderTree

TOKENS_PARASITES = {'-', '/', '|', '–', '—', '·'}
ICONES = {"INCHANGE": "✅", "MODIFIE": "✏️ ", "AJOUTE": "➕", "SUPPRIME": "❌", "BRANCHE": "📁"}

def normaliser(ligne):
    if not ligne:
        return []
    ligne = unicodedata.normalize('NFKC', ligne.splitlines()[0])  # titre = 1ère ligne
    ligne = re.sub(r'\s+', ' ', ligne).strip()
    return [t for t in ligne.split(' ') if t and t not in TOKENS_PARASITES]

# ══════════════════════════════════════════════════════════════════════════════
# EXTRACTION SANS PERTE (Retourne une liste brute de tuples)
# ══════════════════════════════════════════════════════════════════════════════
def extraire(dico):
    return [d for d in dico if d["type"] == "XML_procedure"]

# ══════════════════════════════════════════════════════════════════════════════
# TRIE AUTO-ALIGNÉ ET APPARIÉ
# ══════════════════════════════════════════════════════════════════════════════
def make_node(name, parent, dm_code=None, feuille=False):
    n = Node(name, parent=parent)
    n.dm_code  = dm_code
    n.feuille  = feuille
    n.patches  = []          
    n.statut   = "BRANCHE"
    return n

def construire_trie(entrees, parent):
    """
    entrees: liste de tuples (tokens_restants, dm_code, document_brut, version)
    """
    # 1. Gestion des éléments arrivés à destination (plus de tokens de titre à traiter)
    ici = [e for e in entrees if not e[0]]
    if ici:
        # On regroupe par DM_code les procédures qui partagent le même titre exact
        by_code = defaultdict(list)
        for _, code, doc, version in ici:
            by_code[code].append((doc, version))
            
        for code, items in by_code.items():
            v1_items = [doc for doc, version in items if version == "v1"]
            v2_items = [doc for doc, version in items if version == "v2"]
            
            # On aligne séquentiellement les blocs V1 et V2 partageant ce titre et ce code
            max_len = max(len(v1_items), len(v2_items))
            for i in range(max_len):
                d1 = v1_items[i] if i < len(v1_items) else None
                d2 = v2_items[i] if i < len(v2_items) else None
                
                nom_feuille = f"[{code}]" + (f" (partie {i+1})" if max_len > 1 else "")
                noeud_feuille = make_node(nom_feuille, parent, dm_code=code, feuille=True)
                
                # On attache directement les structures V1 et V2 au nœud pour le calcul du diff
                noeud_feuille.doc_v1 = d1
                noeud_feuille.doc_v2 = d2

    # 2. Continuer la construction des branches pour les tokens restants
    restants = [e for e in entrees if e[0]]
    if not restants:
        return
        
    groupes = defaultdict(list)
    for tokens, code, doc, version in restants:
        groupes[tokens[0].lower()].append((tokens, code, doc, version))
        
    for _, groupe in sorted(groupes.items()):
        chemins = [e[0] for e in groupe]
        min_len = min(len(c) for c in chemins)
        n_commun = 0
        for i in range(min_len):
            if len({c[i].lower() for c in chemins}) == 1:
                n_commun = i + 1
            else:
                break
                
        nom_branche = " ".join(chemins[0][:n_commun])
        noeud_intermediaire = make_node(nom_branche, parent)
        
        prochaines_entrees = [
            (tokens[n_commun:], code, doc, version)
            for tokens, code, doc, version in groupe
        ]
        construire_trie(prochaines_entrees, noeud_intermediaire)

# ══════════════════════════════════════════════════════════════════════════════
# DIFF PAR MOTS (INSENSIBLE AUX SAUTS DE LIGNE)
# ══════════════════════════════════════════════════════════════════════════════
def diff_contenu(t1, t2):
    t1_clean = re.sub(r'\s+', ' ', t1).strip()
    t2_clean = re.sub(r'\s+', ' ', t2).strip()
    w1, w2 = t1_clean.split(' '), t2_clean.split(' ')
    
    matcher = difflib.SequenceMatcher(None, w1, w2, autojunk=False)
    return [
        (" ".join(w1[i1:i2]), " ".join(w2[j1:j2]))
        for tag, i1, i2, j1, j2 in matcher.get_opcodes()
        if tag != 'equal'
    ]

# ══════════════════════════════════════════════════════════════════════════════
# PROPAGATION ET ANALYSE DES DICTIONNAIRES EMBARQUÉS
# ══════════════════════════════════════════════════════════════════════════════
def propager_bottom_up(racine):
    for noeud in reversed(list(racine.descendants)):
        if noeud.feuille:
            d1 = getattr(noeud, 'doc_v1', None)
            d2 = getattr(noeud, 'doc_v2', None)

            if d1 is None:
                noeud.statut = "AJOUTE"
            elif d2 is None:
                noeud.statut = "SUPPRIME"
            else:
                t1 = d1["content"]
                t2 = d2["content"]
                
                t1_clean = re.sub(r'\s+', ' ', t1).strip()
