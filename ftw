class Node:
    def __init__(self, name, parent=None):
        self.name = name
        self.parent = parent
        if parent:
            if not hasattr(parent, 'children'):
                parent.children = []
            parent.children.append(self)
        self.children = []
        self.dm_code = None
        self.feuille = False
        self.patches = []
        self.statut = "BRANCHE"
        self.tokens_cumules = 0
        self.doc_v1 = None
        self.doc_v2 = None

    @property
    def descendants(self):
        nodes = []
        for child in self.children:
            nodes.append(child)
            nodes.extend(child.descendants)
        return nodes

    @property
    def path(self):
        path = []
        current = self
        while current:
            path.insert(0, current)
            current = current.parent
        return path


