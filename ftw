# DIFF PAR DOCUMENT
# ══════════════════════════════════════════════════════════════════════════════
def diff_contenu(t1, t2):
    l1, l2 = t1.splitlines(), t2.splitlines()
    matcher = difflib.SequenceMatcher(None, l1, l2, autojunk=False)
    return [
        ("\n".join(l1[i1:i2]), "\n".join(l2[j1:j2]))
        for tag, i1, i2, j1, j2 in matcher.get_opcodes()
        if tag != 'equal'
    ]

# ══════════════════════════════════════════════════════════════════════════════
# PROPAGATION BOTTOM-UP
# Chaque feuille reçoit ses patches, puis on remonte vers la racine
# en agrégeant : chaque nœud parent accumule tous les patches de ses enfants
# et détecte les patterns répétés DANS son sous-arbre
# ══════════════════════════════════════════════════════════════════════════════
def propager_bottom_up(racine, idx_v1, idx_v2):
    """
    Parcours post-order (feuilles → racine).
    Chaque nœud reçoit :
      - patches     : liste de {avant, apres, dm_code, chemin_ancetres}
      - patterns    : {(avant,apres): [dm_codes]} répétitions dans ce sous-arbre
    """
    for noeud in reversed(list(racine.descendants)):
        if noeud.feuille:
            code = noeud.dm_code
            in_v1 = code in idx_v1
            in_v2 = code in idx_v2

            if not in_v1:
                noeud.statut = "AJOUTE"
            elif not in_v2:
                noeud.statut = "SUPPRIME"
            else:
                t1 = idx_v1[code]["content"]
                t2 = idx_v2[code]["content"]
                if t1 == t2:
                    noeud.statut = "INCHANGE"
                else:
                    noeud.statut = "MODIFIE"
                    ratio = difflib.SequenceMatcher(None, t1, t2).ratio()
                    noeud.ratio  = ratio
                    # Chemin depuis la racine jusqu'à ce nœud (pour le contexte)
                    ancetres = " > ".join(a.name for a in noeud.ancestors if a.name != racine.name)
                    for avant, apres in diff_contenu(t1, t2):
                        noeud.patches.append({
                            "avant":    avant,
                            "apres":    apres,
                            "dm_code":  code,
                            "chemin":   ancetres,
                        })

        else:
            # Nœud intermédiaire : agrège les patches de TOUS ses descendants feuilles
            for patch in [p for enfant in noeud.children for p in enfant.patches]:
                noeud.patches.append(patch)

    # Calcul des patterns répétés pour chaque nœud
    for noeud in racine.descendants:
        sig = defaultdict(list)  # (avant,apres) → [dm_codes]
        for p in noeud.patches:
            sig[(p["avant"], p["apres"])].append(p["dm_code"])
        noeud.patterns = {k: v for k, v in sig.items() if len(v) > 1}  # répétés seulement

# ══════════════════════════════════════════════════════════════════════════════
# AFFICHAGE : arbre + résumé bottom-up
# ══════════════════════════════════════════════════════════════════════════════
ICONES = {"INCHANGE": "✅", "MODIFIE": "✏️ ", "AJOUTE": "➕", "SUPPRIME": "❌", "BRANCHE": "📁"}

def afficher_arbre_diff(racine):
