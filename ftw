"""
diff_summary.py
===============
One markdown diff in, one structured summary of modifications out.
Single LLM call, minimal prompt, no chatter.

    md = ModernHtmlDiff().make_markdown(before, after)
    summary = DiffSummarizer(api_key, base_url, model).summarize(md)

Dependencies: langchain-openai >= 0.2, pydantic >= 2
"""

from __future__ import annotations

from enum import Enum

from langchain_openai import ChatOpenAI
from pydantic import BaseModel, Field


class ModificationType(str, Enum):
    REFERENCE_CHANGE = "reference_change"
    INFO_ADDED = "info_added"
    INFO_REMOVED = "info_removed"
    INFO_REPLACED = "info_replaced"
    VALUE_CHANGE = "value_change"
    REWORDING = "rewording"
    STRUCTURE_CHANGE = "structure_change"


class Modification(BaseModel):
    type: ModificationType
    target: str = Field(description="Object / field / section affected.")
    description: str = Field(description="What changed, before -> after if useful.")


class DiffSummary(BaseModel):
    overview: str = Field(description="One short sentence on overall intent.")
    modifications: list[Modification]


# Instructions live in the schema field descriptions above; the prompt only
# states the task once, so the model never echoes the rules back.
_PROMPT = "Summarize the modifications in this diff:\n\n{md}"


class DiffSummarizer:
    """Custom ChatOpenAI endpoint bound to the DiffSummary schema."""

    def __init__(
        self,
        api_key: str,
        base_url: str,
        model: str,
        temperature: float = 0.0,
        max_tokens: int | None = None,
    ) -> None:
        self._chain = ChatOpenAI(
            api_key=api_key,
            base_url=base_url,
            model=model,
            temperature=temperature,
            max_tokens=max_tokens,
        ).with_structured_output(DiffSummary)

    def summarize(self, diff_markdown: str) -> DiffSummary:
        """One call: markdown diff -> validated DiffSummary."""
        return self._chain.invoke(_PROMPT.format(md=diff_markdown))


if __name__ == "__main__":
    from modern_diff import ModernHtmlDiff

    before = ["Owner: Alice", "Status: draft", "Budget: 1000"]
    after = ["Owner: Bob", "Status: draft", "Budget: 1500", "Reviewer: Carol"]

    md = ModernHtmlDiff().make_markdown(before, after, "record_v1", "record_v2")

    summarizer = DiffSummarizer(
        api_key="YOUR_API_KEY",
        base_url="https://your-endpoint/v1",
        model="your-model-name",
    )
    summary = summarizer.summarize(md)

    print(summary.overview)
    for m in summary.modifications:
        print(f"- [{m.type.value}] {m.target}: {m.description}")


"""
diff_summary.py
===============
Turn a `ModernHtmlDiff.make_markdown(...)` output into a terse, operator-facing
summary of changes, using the Anthropic API with a strict Pydantic schema.

Pipeline position
-----------------
    fromlines, tolines
        └─> ModernHtmlDiff.make_markdown(...)   # markdown diff
              └─> build_summary_prompt(markdown) # system + user messages
                    └─> summarize_diff(...)      # -> DiffSummary (validated)

Design goals
------------
- Zero LLM chatter: the model only emits the structured object, nothing else.
- Operator-oriented: each change is one scannable line with a severity tag.
- Resilient: uses native Structured Outputs when available, falls back to
  strict tool-use on older SDKs/models.

Dependencies: anthropic >= 0.69, pydantic >= 2
"""

from __future__ import annotations

import json
import os
from enum import Enum
from typing import Any

from pydantic import BaseModel, Field


# ─────────────────────────────────────────────────────────────────────────────
# Structured output schema
# ─────────────────────────────────────────────────────────────────────────────

class ChangeKind(str, Enum):
    """Coarse classification of what a change does."""
    ADDED = "added"
    REMOVED = "removed"
    MODIFIED = "modified"
    MOVED = "moved"
    RENAMED = "renamed"


class Severity(str, Enum):
    """How much an operator should care."""
    CRITICAL = "critical"   # behaviour-altering, breaking, security
    MAJOR = "major"         # notable logic/interface change
    MINOR = "minor"         # small adjustment, low risk
    TRIVIAL = "trivial"     # formatting / cosmetic that slipped through


class ChangeItem(BaseModel):
    """A single, atomic change an operator needs to know about."""
    kind: ChangeKind = Field(description="What kind of change this is.")
    severity: Severity = Field(description="Operator-facing importance.")
    location: str = Field(
        description="Where the change is, e.g. 'compute_ik() signature' "
        "or 'lines 6-10'. Keep it short."
    )
    summary: str = Field(
        description="One imperative sentence, max ~15 words, no fluff. "
        "State WHAT changed and the OBSERVABLE effect."
    )


class DiffSummary(BaseModel):
    """Complete operator summary of a diff. No prose outside these fields."""
    headline: str = Field(
        description="One line (max ~12 words) capturing the overall intent "
        "of the change set."
    )
    changes: list[ChangeItem] = Field(
        description="Ordered most-important-first. Omit trivial noise entirely."
    )
    risk_flags: list[str] = Field(
        default_factory=list,
        description="Short warnings an operator must verify before deploying "
        "(e.g. 'tolerance loosened 1e-4 -> 1e-5'). Empty if none.",
    )


# ─────────────────────────────────────────────────────────────────────────────
# Prompt construction
# ─────────────────────────────────────────────────────────────────────────────

_SYSTEM_PROMPT = (
    "You are a code-review summarizer embedded in an automated tooling suite. "
    "You receive a markdown diff and emit ONLY a structured summary for a human "
    "operator who must decide whether to approve a change.\n"
    "Rules:\n"
    "- Be ruthless about brevity. No greetings, no explanations, no markdown "
    "in field values.\n"
    "- One ChangeItem per distinct logical change; merge cosmetic edits.\n"
    "- Skip pure formatting/whitespace unless it affects behaviour.\n"
    "- 'summary' fields are imperative and observable: what changed + effect.\n"
    "- Order changes by severity (critical first).\n"
    "- risk_flags are for things that could silently break production."
)


def build_summary_prompt(
    diff_markdown: str,
    fromdesc: str = "original",
    todesc: str = "modified",
) -> dict[str, Any]:
    """
    Build the message payload for the summarization call.

    Returns a dict with 'system' and 'messages' keys, ready to splat into the
    Anthropic messages API (works for both .parse() and .create()).
    """
    user_content = (
        f"Diff between `{fromdesc}` and `{todesc}`. "
        f"Summarize for an operator.\n\n{diff_markdown}"
    )
    return {
        "system": _SYSTEM_PROMPT,
        "messages": [{"role": "user", "content": user_content}],
    }


# ─────────────────────────────────────────────────────────────────────────────
# LLM invocation
# ─────────────────────────────────────────────────────────────────────────────

# Native structured outputs are supported on recent Claude models.
_DEFAULT_MODEL = "claude-sonnet-4-5"
_STRUCTURED_OUTPUTS_BETA = "structured-outputs-2025-11-13"


def summarize_diff(
    diff_markdown: str,
    fromdesc: str = "original",
    todesc: str = "modified",
    *,
    client: Any | None = None,
    model: str = _DEFAULT_MODEL,
    max_tokens: int = 1024,
) -> DiffSummary:
    """
    Send a markdown diff to Claude and return a validated DiffSummary.

    Parameters
    ----------
    diff_markdown : str
        Output of ModernHtmlDiff.make_markdown(...).
    fromdesc, todesc : str
        Labels for the two versions (used in the prompt only).
    client : anthropic.Anthropic | None
        An existing client. If None, one is created from the
        ANTHROPIC_API_KEY environment variable.
    model : str
        Model id. Defaults to a structured-output-capable Sonnet.
    max_tokens : int
        Upper bound on the response.

    Returns
    -------
    DiffSummary
        Parsed and validated.
    """
    if client is None:
        from anthropic import Anthropic  # local import keeps module import light
        client = Anthropic(api_key=os.environ.get("ANTHROPIC_API_KEY"))

    payload = build_summary_prompt(diff_markdown, fromdesc, todesc)

    # ── Path 1: native structured outputs (preferred) ───────────────────────
    try:
        resp = client.beta.messages.parse(
            model=model,
            max_tokens=max_tokens,
            betas=[_STRUCTURED_OUTPUTS_BETA],
            system=payload["system"],
            messages=payload["messages"],
            response_model=DiffSummary,
        )
        if getattr(resp, "parsed_output", None) is not None:
            return resp.parsed_output
        # Some SDK versions expose .parsed
        if getattr(resp, "parsed", None) is not None:
            return resp.parsed  # type: ignore[return-value]
    except (AttributeError, TypeError, NotImplementedError):
        pass  # SDK too old or feature unavailable -> fall back
    except Exception as exc:  # noqa: BLE001
        # API-level failure on the beta path: try the fallback before giving up
        _last_error = exc

    # ── Path 2: strict tool-use fallback ────────────────────────────────────
    return _summarize_via_tool(
        client, payload, model=model, max_tokens=max_tokens
    )


def _summarize_via_tool(
    client: Any,
    payload: dict[str, Any],
    *,
    model: str,
    max_tokens: int,
) -> DiffSummary:
    """Fallback that forces the model to call a single schema-typed tool."""
    tool = {
        "name": "emit_diff_summary",
        "description": "Emit the structured operator summary of the diff.",
        "input_schema": DiffSummary.model_json_schema(),
    }
    resp = client.messages.create(
        model=model,
        max_tokens=max_tokens,
        system=payload["system"],
        messages=payload["messages"],
        tools=[tool],
        tool_choice={"type": "tool", "name": "emit_diff_summary"},
    )
    for block in resp.content:
        if getattr(block, "type", None) == "tool_use":
            return DiffSummary.model_validate(block.input)

    raise RuntimeError(
        "Model did not return a tool_use block; cannot build DiffSummary."
    )


# ─────────────────────────────────────────────────────────────────────────────
# Convenience: render a DiffSummary back to a compact operator string
# ─────────────────────────────────────────────────────────────────────────────

_SEV_MARK = {
    Severity.CRITICAL: "🔴",
    Severity.MAJOR: "🟠",
    Severity.MINOR: "🟡",
    Severity.TRIVIAL: "⚪",
}


def render_summary_text(summary: DiffSummary) -> str:
    """Render a DiffSummary as a terse plain-text block for a terminal/log."""
    out = [f"▎{summary.headline}", ""]
    for c in summary.changes:
        mark = _SEV_MARK.get(c.severity, "•")
        out.append(f"{mark} [{c.kind.value}] {c.location}: {c.summary}")
    if summary.risk_flags:
        out.append("")
        out.append("⚠ Risks:")
        out.extend(f"  - {r}" for r in summary.risk_flags)
    return "\n".join(out)


# ─────────────────────────────────────────────────────────────────────────────
# End-to-end helper (diff -> markdown -> summary) in one call
# ─────────────────────────────────────────────────────────────────────────────

def summarize_change(
    fromlines: list[str],
    tolines: list[str],
    fromdesc: str = "original",
    todesc: str = "modified",
    *,
    filter_trivial: bool = True,
    client: Any | None = None,
    model: str = _DEFAULT_MODEL,
) -> tuple[str, DiffSummary]:
    """
    One-shot: build the markdown diff AND the LLM summary.

    Returns (markdown, summary) so the caller can both display the diff and
    show the operator summary.
    """
    from modern_diff import ModernHtmlDiff

    differ = ModernHtmlDiff(filter_trivial=filter_trivial)
    markdown = differ.make_markdown(fromlines, tolines, fromdesc, todesc)
    summary = summarize_diff(
        markdown, fromdesc, todesc, client=client, model=model
    )
    return markdown, summary


# ─────────────────────────────────────────────────────────────────────────────
# Demo (offline-safe: shows prompt + schema without hitting the API)
# ─────────────────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    sample_md = (
        "## Diff: `ik_solver_v1.py` -> `ik_solver_v2.py`\n\n"
        "### Change 1 — lines 1-4\n```diff\n"
        "- def compute_ik(robot, target_pose, max_iter=100):\n"
        "+ def compute_ik(robot, target_pose, max_iter=200, tol=1e-5):\n```\n"
    )

    payload = build_summary_prompt(sample_md, "ik_solver_v1.py", "ik_solver_v2.py")
    print("=== SYSTEM ===")
    print(payload["system"])
    print("\n=== USER ===")
    print(payload["messages"][0]["content"])
    print("\n=== RESPONSE SCHEMA (JSON) ===")
    print(json.dumps(DiffSummary.model_json_schema(), indent=2))

    if os.environ.get("ANTHROPIC_API_KEY"):
        print("\n=== LIVE SUMMARY ===")
        summary = summarize_diff(
            sample_md, "ik_solver_v1.py", "ik_solver_v2.py"
        )
        print(render_summary_text(summary))
    else:
        print("\n(Set ANTHROPIC_API_KEY to run a live summary.)")
