# 3. EXTRACTION, DÉDUPLICATION GLOBALE ET CARTOGRAPHIE
# ==============================================================================
def collecter_et_dedupler_donnees(noeud, chemin_actuel="", donnees_branches=None, registre_mutations_global=None):
    if donnees_branches is None:
        donnees_branches = defaultdict(lambda: {"ajouts": [], "suppressions": [], "typos": 0})
    if registre_mutations_global is None:
        # Structure : { mutation_text: {"id": str, "occurrences": [{"branche": str, "bloc": str}]} }
        registre_mutations_global = {}
        
    nom_chemin = f"{chemin_actuel} > {noeud.name}" if chemin_actuel else noeud.name
    
    for (dm_code, type_label), mod in noeud.modules.items():
        identifiant_bloc = f"{dm_code} ({type_label})"
        
        if mod["status"] == "NOUVEAU":
            donnees_branches[nom_chemin]["ajouts"].append(identifiant_bloc)
        elif mod["status"] == "SUPPRIME":
            donnees_branches[nom_chemin]["suppressions"].append(identifiant_bloc)
        elif mod["status"] == "MODIFIE":
            for mut, categorie in mod["transformations"]:
                if categorie == "TYPO":
                    donnees_branches[nom_chemin]["typos"] += 1
                else:
                    # Traitement de la modification réelle : Enregistrement et isolation globale
                    if mut not in registre_mutations_global:
                        num_id = len(registre_mutations_global) + 1
                        registre_mutations_global[mut] = {
                            "id": f"MOD-{num_id:03d}",
                            "occurrences": []
                        }
                    registre_mutations_global[mut]["occurrences"].append({
                        "branche": nom_chemin,
                        "bloc": identifiant_bloc
                    })
                    
    for enfant in noeud.children.values():
        collecter_et_dedupler_donnees(enfant, nom_chemin, donnees_branches, registre_mutations_global)
        
    return donnees_branches, registre_mutations_global

# ==============================================================================
# 4. PREPARATION ET COMPACTAGE DU PACK LLM (BATCHING)
# ==============================================================================
def estimer_tokens(texte):
    return max(1, len(texte) // 4)

def generer_paquets_llm(donnees_branches, registre_mutations_global, max_tokens_per_batch=1500):
    batchs = []
    
    consigne_systeme = (
        "ROLE: Analyser la liste des modifications dedupliquees ci-dessous.\n"
        "Pour chaque identifiant (MOD-XXX), rediger un commentaire synthetique expliquant "
        "l'impact fonctionnel ou la portee de ce changement.\n"
        "FORMAT DE REPONSE ATTENDU:\n"
        "MOD-XXX: [Votre commentaire ici]\n"
        "==================================================================\n"
    )
    
    # 1. On prepare le catalogue des modifications uniques (Chaque modif apparait une seule fois)
    corps_catalogue = "CATALOGUE DES MODIFICATIONS UNIQUE A ANALYSER :\n"
    for mut_text, info in registre_mutations_global.items():
        corps_catalogue += f"  - ID: {info['id']} | Modification: {mut_text}\n"
        
    corps_catalogue += "==================================================================\n"
    
    # 2. On injecte l'etat condensé des structures pour donner du contexte au LLM si besoin
    corps_contextuel_structures = "CONTEXTE COMPLEMENTAIRE DES STRUCTURES (HORS ANALYSE ELEMENTAIRE) :\n"
    for chemin, contenu in donnees_branches.items():
        if contenu["ajouts"] or contenu["suppressions"] or contenu["typos"] > 0:
            corps_contextuel_structures += f"Sous-Branche : {chemin}\n"
            if contenu["ajouts"]:
                corps_contextuel_structures += f"  Ajout de blocs complets : {', '.join(contenu['ajouts'])}\n"
            if contenu["suppressions"]:
                corps_contextuel_structures += f"  Suppression de blocs complets : {', '.join(contenu['suppressions'])}\n"
            if contenu["typos"] > 0:
                corps_contextuel_structures += f"  Modifications de type typo : {contenu['typos']} detectees.\n"
                
    payload_total = consigne_systeme + corps_catalogue + corps_contextuel_structures
    
    # Decoupage en batch elementaire si la structure globale depasse la limite
    # (Ici adapte pour la re-segmentation de lignes de modifications uniques si volumineux)
    if estimer_tokens(payload_total) <= max_tokens_per_batch:
        batchs.append(payload_total)
    else:
        # Si le catalogue est gigantesque, on segmente uniquement le catalogue des IDs
        lignes_catalogue = corps_catalogue.split('\n')
        tampon_courant = []
        for ligne in lignes_catalogue:
            tampon_courant.append(ligne)
            if estimer_tokens("\n".join(tampon_courant)) > max_tokens_per_batch - 300:
                batchs.append(consigne_systeme + "\n".join(tampon_courant))
                tampon_courant = []
        if tampon_courant:
            batchs.append(consigne_systeme + "\n".join(tampon_courant))
            
    return batchs

