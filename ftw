import numpy as np
import plotly.express as px
from plotly.subplots import make_subplots
import plotly.graph_objects as go
from sklearn.decomposition import PCA
from sklearn.manifold import TSNE

# --- 1. Simulation de tes données ---
# On imagine que 'emb' est ton tableau numpy (ex: 300 embeddings de dimension 128)
# On crée aussi des faux labels pour colorer le graphique, c'est plus sympa !
np.random.seed(42)
emb = np.random.rand(300, 128)
labels = np.random.choice(
    ["Groupe A", "Groupe B", "Groupe C"], size=300
)  # Optionnel
metadata = [f"Doc n°{i}" for i in range(300)]  # Texte au survol

# --- 2. Réduction de dimension ---

# A. Version Linéaire : PCA (2 composants)
pca = PCA(n_components=2)
emb_pca = pca.fit_transform(emb)

# B. Version Non-Linéaire : t-SNE (2 composants)
# Note : perplexity doit être inférieure au nombre d'individus
tsne = TSNE(n_components=2, perplexity=30, random_state=42, n_iter=1000)
emb_tsne = tsne.fit_transform(emb)


# --- 3. Création du "Joli Plot" interactif ---

# On crée une figure avec 2 sous-graphiques (1 ligne, 2 colonnes)
fig = make_subplots(
    rows=1,
    cols=2,
    subplot_titles=(
        "PCA (Réduction Linéaire)",
        "t-SNE (Réduction Non-Linéaire)",
    ),
)

# Couleurs pour que les deux graphiques soient synchronisés
unique_labels = list(set(labels))
colors = px.colors.qualitative.Plotly

for i, label in enumerate(unique_labels):
    mask = labels == label

    # Ajout du scatter PCA
    fig.add_trace(
        go.Scatter(
            x=emb_pca[mask, 0],
            y=emb_pca[mask, 1],
            mode="markers",
            name=label,
            marker=dict(color=colors[i], size=8),
            hovertext=[metadata[j] for j, m in enumerate(mask) if m],
            legendgroup=label,  # Lie la légende entre les deux plots
        ),
        row=1,
        col=1,
    )

    # Ajout du scatter t-SNE
    fig.add_trace(
        go.Scatter(
            x=emb_tsne[mask, 0],
            y=emb_tsne[mask, 1],
            mode="markers",
            name=label,
            marker=dict(color=colors[i], size=8),
            hovertext=[metadata[j] for j, m in enumerate(mask) if m],
            legendgroup=label,
            showlegend=False,  # Évite les doublons dans la légende
        ),
        row=1,
        col=2,
    )

# --- 4. Tuning du design ---
fig.update_layout(
    title_text="Visualisation des Embeddings",
    title_x=0.5,  # Centre le titre
    template="plotly_white",  # Fond blanc ultra propre
    width=1100,
    height=500,
    hovermode="closest",
)

# Afficher le plot (s'ouvre dans ton navigateur ou ton notebook)
fig.show()



"""
modern_diff.py
==============
A modern, feature-rich extension of Python's difflib.HtmlDiff.

Features
--------
- Ultra-modern dark/light HTML rendering (glassmorphism, rounded corners,
  animated highlights, colour-coded changes)
- Three display modes: side-by-side, overlay (superimposed), unified
- Optional filename banners at the top
- Trivial-symbol filter: strips diffs that are *only* punctuation / isolated
  symbols so an LLM receives only semantically meaningful changes
- Markdown export for LLM consumption

Dependencies: Python ≥ 3.9, difflib (stdlib only)
"""

from __future__ import annotations

import difflib
import html
import re
import textwrap
from dataclasses import dataclass, field
from typing import Sequence


# ─────────────────────────────────────────────────────────────────────────────
# Trivial-symbol filter
# ─────────────────────────────────────────────────────────────────────────────

# Characters that are considered "isolated symbols" – a diff line whose
# *entire non-whitespace content* consists only of these is marked trivial.
_TRIVIAL_SYMBOLS: frozenset[str] = frozenset(
    r"""-/:;''.,?»«!()[]{}|@#$%^&*~`"'"""
)

_ONLY_SYMBOLS_RE = re.compile(
    r"^[\s\-/:;''.,?»«!()\[\]{}|@#$%^&*~`\"'\\<>]+$"
)


def _is_trivial_line(line: str) -> bool:
    """Return True if *line* contains nothing beyond isolated symbols."""
    stripped = line.strip()
    if not stripped:
        return True
    return bool(_ONLY_SYMBOLS_RE.match(stripped))


def _strip_trivial(
    opcodes: list[tuple],
    a_lines: list[str],
    b_lines: list[str],
) -> list[tuple]:
    """
    Demote 'replace'/'delete'/'insert' blocks to 'equal' when every changed
    line contains nothing beyond isolated symbols (e.g. a lone comma or dash).
    """
    result = []
    for tag, i1, i2, j1, j2 in opcodes:
        if tag in ("replace", "delete", "insert"):
            a_chunk = a_lines[i1:i2]
            b_chunk = b_lines[j1:j2]
            if (a_chunk + b_chunk) and all(
                _is_trivial_line(l) for l in a_chunk + b_chunk
            ):
                result.append(("equal", i1, i2, j1, j2))
                continue
        result.append((tag, i1, i2, j1, j2))
    return result


# Characters stripped before comparing content for semantic equality.
_NORMALIZE_RE = re.compile(r"[\s\W]+")


def _normalize_content(text: str) -> str:
    """Remove all punctuation and whitespace, lowercase — keeps only words."""
    return _NORMALIZE_RE.sub("", text).lower()


def _strip_content_equal(
    opcodes: list[tuple],
    a_lines: list[str],
    b_lines: list[str],
) -> list[tuple]:
    """
    Demote blocks to 'equal' when both sides carry the *same words* once
    punctuation and whitespace are removed.

    Examples that become 'equal':
      - "hello, world"  vs "hello world"   (comma removed)
      - "foo  bar"      vs "foo bar"        (extra space)
      - "end."          vs "end"            (trailing dot)
      - " , "           vs ""               (only punctuation)

    A block where one side adds or removes real words is kept as-is.
    """
    result = []
    for tag, i1, i2, j1, j2 in opcodes:
        if tag in ("replace", "delete", "insert"):
            a_content = _normalize_content(" ".join(a_lines[i1:i2]))
            b_content = _normalize_content(" ".join(b_lines[j1:j2]))
            if a_content == b_content:
                result.append(("equal", i1, i2, j1, j2))
                continue
        result.append((tag, i1, i2, j1, j2))
    return result


# ─────────────────────────────────────────────────────────────────────────────
# Data structures
# ─────────────────────────────────────────────────────────────────────────────

@dataclass
class DiffBlock:
    """One logical block of differences (used for Markdown / overlay)."""
    tag: str           # 'equal' | 'replace' | 'delete' | 'insert'
    a_lines: list[str] = field(default_factory=list)
    b_lines: list[str] = field(default_factory=list)
    a_start: int = 0   # 1-based line number in source file
    b_start: int = 0


