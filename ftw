def nettoyage_texte_complet(texte):
    if not isinstance(texte, str):
        return texte
        
    # Étape 1 : Séparer les mots collés (ex: wingVoir -> wing Voir)
    texte = re.sub(r'([a-z])([A-Z])', r'\1 \2', texte)
    
    # Étape 2 : Supprimer les parenthèses fermantes orphelines (ex: wing) -> wing)
    texte = re.sub(r'(?<!\([^()]*)\)', '', texte)
    
    # Étape 3 : Supprimer les parenthèses ouvrantes orphelines (ex: (wing -> wing)
    texte = re.sub(r'\((?![^()]*\))', '', texte)
    
    return texte.strip()

