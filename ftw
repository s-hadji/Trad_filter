        else:
            if v1.strip() == v2.strip():
                mod["status"] = "IDENTIQUE"
                mod["avant"] = "[...identique...]"
                mod["apres"] = "[...identique...]"
            else:
                mod["status"] = "MODIFIÉ"
                mod["avant"], mod["apres"] = calculer_avant_apres_global(v1, v2)
                
    # Récursion sur les sous-chapitres enfants
    for enfant in noeud.children.values():
        analyser_et_tagger_arbre(enfant)

