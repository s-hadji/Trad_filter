import re
import difflib
import json
import unicodedata
from collections import defaultdict
from typing import List
from pydantic import BaseModel, Field
from langchain_core.prompts import ChatPromptTemplate
from langchain_openai import ChatOpenAI

# ══════════════════════════════════════════════════════════════════════════════
# STRUCTURE DE L'ARBRE (STANDALONE AVEC TOKENS CUMULÉS)
# ══════════════════════════════════════════════════════════════════════════════

TOKENS_PARASITES = {'-', '/', '|', '–', '—', '·', '>', '→', '->'}

class Node:
    def __init__(self, name, parent=None):
        self.name = name
        self.parent = parent
        self.children = []
        if parent:
            parent.children.append(self)
        self.dm_code = None
        self.feuille = False
        self.patches = []          
        self.statut = "BRANCHE"
        self.tokens_cumules = 0  # Stocke le poids factorisé de la branche
        self.doc_v1 = None
        self.doc_v2 = None

    @property
    def descendants(self):
        nodes = []
        for child in self.children:
            nodes.append(child)
            nodes.extend(child.descendants)
        return nodes

    @property
    def path(self):
        path = []
        current = self
        while current:
            path.insert(0, current)
            current = current.parent
        return path

    @property
    def depth(self):
        return len(self.path) - 1


# ══════════════════════════════════════════════════════════════════════════════
# FONCTIONS DE NETTOYAGE ET SÉPARATION FINE (TOKENIZER PERFO)
# ══════════════════════════════════════════════════════════════════════════════

def normaliser(ligne):
    if not ligne:
        return []
    ligne = unicodedata.normalize('NFKC', ligne.splitlines()[0])
    ligne = re.sub(r'\s+', ' ', ligne).strip()
    return [t for t in ligne.split(' ') if t and t not in TOKENS_PARASITES]

def extraire(dico):
    return [d for d in dico if d["type"] == "XML_procedure"]

def epurer_texte(t):
    if not t: return ""
    t_clean = re.sub(r'[\.,\(\)\[\]\{\}!\?;:\*\+\-/\|—–_§•·]', ' ', t)
    return re.sub(r'\s+', ' ', t_clean).strip()

def extraire_tokens_perfo(texte):
    if not texte:
        return []
    pattern = r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]'
    return re.findall(pattern, texte)


# ══════════════════════════════════════════════════════════════════════════════
# MOTEUR DE DIFF ET FUSION PAR CONTIGUÏTÉ
# ══════════════════════════════════════════════════════════════════════════════

def diff_contenu(t1, t2):
    mots_v1 = extraire_tokens_perfo(t1)
    mots_v2 = extraire_tokens_perfo(t2)
    
    matcher = difflib.SequenceMatcher(None, mots_v1, mots_v2, autojunk=False)
    opcodes = matcher.get_opcodes()
    
    groupes_patches = []
    groupe_actuel = []
    
    for action, i1, i2, j1, j2 in opcodes:
        if action != 'equal':
            groupe_actuel.append((i1, i2, j1, j2))
        else:
            if groupe_actuel:
                groupes_patches.append(groupe_actuel)
                groupe_actuel = []
    if groupe_actuel:
        groupes_patches.append(groupe_actuel)
        
    patches_filtres = []
    for groupe in groupes_patches:
        min_i, max_i = groupe[0][0], groupe[-1][1]
        min_j, max_j = groupe[0][2], groupe[-1][3]
        
        avant = " ".join(mots_v1[min_i:max_i])
        apres = " ".join(mots_v2[min_j:max_j])
        
        coeur_avant = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', avant).lower()
        coeur_apres = re.sub(r'[^a-zA-Z0-9À-ÿ]', '', apres).lower()
        if coeur_avant == coeur_apres:
            continue
            
        patches_filtres.append((avant, apres))
        
    return patches_filtres


# ══════════════════════════════════════════════════════════════════════════════
# ARBRE DE FACTORISATION ALIGNÉE VIA DIFFLIB
# ══════════════════════════════════════════════════════════════════════════════

def factoriser_textes_difflib(liste_textes):
    if not liste_textes: return ""
    if len(liste_textes) == 1: return liste_textes[0]
        
    current_mots = [w.lower() for w in liste_textes[0].split()]
    for t in liste_textes[1:]:
        t_mots = [w.lower() for w in t.split()]
        sm = difflib.SequenceMatcher(None, current_mots, t_mots, autojunk=False)
        new_mots = []
        for block in sm.get_matching_blocks():
            if block.size > 0:
                new_mots.extend(current_mots[block.a : block.a + block.size])
        current_mots = new_mots
        
    invariants_lower = current_mots
    
    if not invariants_lower:
        seen = set()
        unique_raw = []
        for t in liste_textes:
            t_clean = t.strip()
            if t_clean.lower() not in seen:
                seen.add(t_clean.lower())
                unique_raw.append(t_clean if t_clean else "Ø")
        if len(unique_raw) == 1: return unique_raw[0]
        return "[ " + " | ".join(f"'{u}'" if u != "Ø" else "Ø" for u in unique_raw) + " ]"
        
    tous_segments = []
    invariants_originaux_reference = None
    
    for t in liste_textes:
        texte_mots = t.split()
        segments = []
        matched_orig = []
        idx_t = 0
        for inv_low in invariants_lower:
            sub_segment = []
            while idx_t < len(texte_mots) and texte_mots[idx_t].lower() != inv_low:
                sub_segment.append(texte_mots[idx_t])
                idx_t += 1
            segments.append(" ".join(sub_segment))
            if idx_t < len(texte_mots):
                matched_orig.append(texte_mots[idx_t])
                idx_t += 1
            else:
                matched_orig.append(inv_low)
        segments.append(" ".join(texte_mots[idx_t:]))
        tous_segments.append(segments)
        if invariants_originaux_reference is None:
            invariants_originaux_reference = matched_orig
            
    resultat_pieces = []
    num_invariants = len(invariants_lower)
    for i in range(num_invariants + 1):
        choix_intervalle = [tous_segments[j][i] for j in range(len(liste_textes))]
        seen_choix = set()
        unique_choix = []
        for c in choix_intervalle:
            c_clean = c.strip()
            if c_clean.lower() not in seen_choix:
                seen_choix.add(c_clean.lower())
                unique_choix.append(c_clean if c_clean else "Ø")
                
        if len(unique_choix) > 1 or (len(unique_choix) == 1 and unique_choix[0] != "Ø"):
            if len(unique_choix) == 1:
                resultat_pieces.append(unique_choix[0])
            else:
                bloc_choix = " | ".join(f"'{u}'" if u != "Ø" else "Ø" for u in unique_choix)
                resultat_pieces.append(f"[ {bloc_choix} ]")
        if i < num_invariants:
            resultat_pieces.append(invariants_originaux_reference[i])
            
    chaine_finale = " ".join([p for p in resultat_pieces if p])
    return re.sub(r'\s+', ' ', chaine_finale).strip()

def compresser_patches_sous_arbre(patches):
    if not patches: return []
    par_avant_clean = defaultdict(list)
    for p in patches:
        av_clean = epurer_texte(p["avant"])
        par_avant_clean[av_clean].append(p)
        
    regles_phase1 = []
    for av_clean, liste_p in par_avant_clean.items():
        raw_apres_list = [p["apres"] for p in liste_p]
        tous_codes = sorted(list(set(p["dm_code"] for p in liste_p)))
        apres_condense = factoriser_textes_difflib(raw_apres_list)
        est_structurel = "[" in apres_condense or "|" in apres_condense
        regles_phase1.append({
            "avant": av_clean, "apres": apres_condense, "codes": tous_codes, "structurel": est_structurel
        })

    simples = [r for r in regles_phase1 if not r["structurel"]]
    complexes = [r for r in regles_phase1 if r["structurel"]]
    
    par_apres_clean_global = defaultdict(list)
    for r in simples:
        par_apres_clean_global[r["apres"].strip().lower()].append(r)
        
    regles_finales = list(complexes)
    for ap_clean, liste_r in par_apres_clean_global.items():
        if len(liste_r) == 1:
            regles_finales.append(liste_r[0])
        else:
            raw_avant_list = [r["avant"] for r in liste_r]
            tous_codes = sorted(list(set(c for r in liste_r for c in r["codes"])))
            avant_condense = factoriser_textes_difflib(raw_avant_list)
            regles_finales.append({
                "avant": avant_condense, "apres": liste_r[0]["apres"], "codes": tous_codes, "structurel": True
            })
    return regles_finales


