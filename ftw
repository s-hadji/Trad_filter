# COMPRESSION DES PATCHES (AVANT SANS SYMBOLE / APRÈS VIA SÉQUENCE DIFFLIB)
# ══════════════════════════════════════════════════════════════════════════════
def compresser_patches_sous_arbre(patches):
    if not patches:
        return []
        
    # --- PASSE 1 : Regroupement par 'AVANT' épuré de ses symboles ---
    par_avant_clean = defaultdict(list)
    for p in patches:
        av_clean = epurer_texte(p["avant"])
        par_avant_clean[av_clean].append(p)
        
    regles_phase1 = []
    for av_clean, liste_p in par_avant_clean.items():
        raw_apres_list = [p["apres"] for p in liste_p]
        tous_codes = sorted(list(set(p["dm_code"] for p in liste_p)))
        
        # Utilisation du nouveau moteur de factorisation difflib pour l'après
        apres_condense = factoriser_textes_difflib(raw_apres_list)
        
        # Une règle est structurelle si elle a généré des choix complexes
        est_structurel = "[" in apres_condense or "|" in apres_condense
        
        regles_phase1.append({
            "avant": av_clean,
            "apres": apres_condense,
            "codes": tous_codes,
            "structurel": est_structurel
        })

    # --- PASSE 2 : Regroupement par 'APRÈS' (Inverse / Non casse-sensitive) ---
    simples = [r for r in regles_phase1 if not r["structurel"]]
    complexes = [r for r in regles_phase1 if r["structurel"]]
    
    par_apres_clean_global = defaultdict(list)
    for r in simples:
        par_apres_clean_global[r["apres"].strip().lower()].append(r)
        
    regles_finales = list(complexes)
    for ap_clean, liste_r in par_apres_clean_global.items():
        if len(liste_r) == 1:
            regles_finales.append(liste_r[0])
        else:
            # Multiples AVANT (épurés) pointent vers le même APRÈS sémantique
            raw_avant_list = [r["avant"] for r in liste_r]
            tous_codes = sorted(list(set(c for r in liste_r for c in r["codes"])))
            
            # On applique la même puissance difflib sur l'AVANT
            avant_condense = factoriser_textes_difflib(raw_avant_list)
            ap_display = liste_r[0]["apres"]
            
            regles_finales.append({
                "avant": avant_condense,
                "apres": ap_display,
                "codes": tous_codes,
                "structurel": True
            })
                
    return regles_finales

