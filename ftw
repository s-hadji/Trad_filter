# COMPACTAGE DU CONTENU D'UN PIVOT SPÉCIFIQUE
# ══════════════════════════════════════════════════════════════════════════════

def extraire_payload_du_pivot(noeud_pivot):
    """
    Genere la structure condensee pour un pivot donne.
    Si le pivot est lui-meme une branche parente, il englobe ses sous-chapitres.
    """
    packs_chapitres = []
    
    # Si le pivot a des sous-branches avec des patches, on les traite, sinon on prend le pivot lui-meme
    noeuds_a_traiter = [noeud_pivot] if noeud_pivot.feuille else [n for n in noeud_pivot.descendants if not n.feuille and n.patches]
    if not noeuds_a_traiter and noeud_pivot.patches:
        noeuds_a_traiter = [noeud_pivot]

    for n in noeuds_a_traiter:
        regles = compresser_patches_sous_arbre(n.patches)
        if regles:
            chemin = " > ".join(a.name for a in n.path)
            pack = {"chapitre": chemin, "changements": []}
            for r in regles:
                pack["changements"].append({
                    "dm_codes": sorted(list(set(r["codes"]))),
                    "texte_avant": r["avant"],
                    "texte_apres": r["apres"]
                })
            packs_chapitres.append(pack)
            
    return packs_chapitres


