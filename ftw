# 3. FILTRAGE, FUSION CONTIGUË ET CONTEXTE (2 MOTS AVANT / AFTER)
# ==============================================================================
def calculer_mutations_tokens(t1, t2):
    """ Diff de Niveau 2 : Formate en ligne avec un contexte strict de 2 mots """
    tok1 = re.findall(r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]', t1) if t1 else []
    tok2 = re.findall(r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]', t2) if t2 else []
    
    matcher = difflib.SequenceMatcher(None, tok1, tok2, autojunk=False)
    opcodes = matcher.get_opcodes()
    
    # Fusion des modifications contiguës amont/aval
    opcodes_fuses = []
    bloc_courant = None
    
    for tag, i1, i2, j1, j2 in opcodes:
        if tag == 'equal':
            if bloc_courant:
                opcodes_fuses.append(bloc_courant)
                bloc_courant = None
        else:
            if bloc_courant is None:
                bloc_courant = {'tag': tag, 'i1': i1, 'i2': i2, 'j1': j1, 'j2': j2}
            else:
                bloc_courant['tag'] = 'replace'
                bloc_courant['i2'] = i2
                bloc_courant['j2'] = j2
                
    if bloc_courant:
        opcodes_fuses.append(bloc_courant)
        
    transformations = []
    for o in opcodes_fuses:
        tag = o['tag']
        i1, i2, j1, j2 = o['i1'], o['i2'], o['j1'], o['j2']
        
        txt_av = ' '.join(tok1[i1:i2]) if tag in ['delete', 'replace'] else ""
        txt_ap = ' '.join(tok2[j1:j2]) if tag in ['insert', 'replace'] else ""
        
        # Filtrage drop_identique
        if drop_identique(txt_av, txt_ap):
            continue
            
        # Extraction du contexte cible de 2 mots max avant et après
        if tag == 'insert':
            ctx_av = ' '.join(tok2[max(0, j1-2):j1])
            ctx_ap = ' '.join(tok2[j2:j2+2])
        else:
            ctx_av = ' '.join(tok1[max(0, i1-2):i1])
            ctx_ap = ' '.join(tok1[i2:i2+2])
            
        ctx_av = ctx_av if ctx_av.strip() else "[Début]"
        ctx_ap = ctx_ap if ctx_ap.strip() else "[Fin]"
        
        # Écriture en ligne claire
        if tag == 'delete':
            mut = f"'{txt_av}' a été supprimé après '{ctx_av}' (avant '{ctx_ap}')"
        elif tag == 'insert':
            mut = f"'{txt_ap}' a été ajouté après '{ctx_av}' (avant '{ctx_ap}')"
        elif tag == 'replace':
            mut = f"'{txt_av}' a été modifié en '{txt_ap}' après '{ctx_av}' (avant '{ctx_ap}')"
            
        transformations.append((mut, "REAL"))
        
    return transformations

def executer_double_diff(v1, v2):
    lignes_v1 = v1.splitlines() if v1 else []
    lignes_v2 = v2.splitlines() if v2 else []
    
    matcher = difflib.SequenceMatcher(None, lignes_v1, lignes_v2, autojunk=False)
    
    nb_ajouts = 0
    nb_suppr = 0
    mutations_locales = []
    
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            continue
        elif tag == 'delete':
            nb_suppr += (i2 - i1)
        elif tag == 'insert':
            nb_ajouts += (j2 - j1)
        elif tag == 'replace':
            bloc_avant = "\n".join(lignes_v1[i1:i2])
            bloc_apres = "\n".join(lignes_v2[j1:j2])
            
            mutations_internes = calculer_mutations_tokens(bloc_avant, bloc_apres)
            mutations_locales.extend(mutations_internes)
            
    return nb_ajouts, nb_suppr, mutations_locales

def analyser_et_tagger_arbre(noeud):
    for cle_module, mod in noeud.modules.items():
        v1, v2 = mod["v1"], mod["v2"]
        
        if v2 is not None and v1 is None:
            mod["status"] = "NOUVEAU"
            mod["lignes_ajoutees"] = len(v2.splitlines())
        elif v1 is not None and v2 is None:
            mod["status"] = "SUPPRIME"
            mod["lignes_supprimees"] = len(v1.splitlines())
        else:
            if v1.strip() == v2.strip():
                mod["status"] = "IDENTIQUE"
            else:
                mod["status"] = "MODIFIE"
                ajouts, suppr, modifs = executer_double_diff(v1, v2)
                mod["lignes_ajoutees"] = ajouts
                mod["lignes_supprimees"] = suppr
                mod["transformations_internes"] = modifs
                
    for enfant in noeud.children.values():
        analyser_et_tagger_arbre(enfant)

