# PIPELINE LANGCHAIN AVEC RETOUR TRACÉ
# ══════════════════════════════════════════════════════════════════════════════

def generer_fiche_version_llm(noeud_pivot) -> FicheVersionGlobale:
    donnees_pack = extraire_payload_du_pivot(noeud_pivot)
    payload_textuel = json.dumps(donnees_pack, indent=2, ensure_ascii=False)
    
    llm = ChatOpenAI(model="gpt-4o", temperature=0.1)
    llm_structure = llm.with_structured_output(FicheVersionGlobale)
    
    prompt_template = ChatPromptTemplate.from_messages([
        ("system", (
            "Vous etes un expert de la documentation aéronautique et technique.\n"
            "Votre role est de rédiger une note d'évolution précise à partir de données de diff.\n\n"
            "Consigne de traçabilité absolue :\n"
            "Chaque bloc contient une liste explicite de modules 'dm_codes_impactes'. Vous devez obligatoirement "
            "lier les descriptions techniques aux modules concernés pour que le lecteur sache exactement "
            "quel Data Module a subi quel changement.\n\n"
            "Regles de redaction strictes :\n"
            "- N'utilisez aucun emoji, icone graphique ou artifice visuel.\n"
            "- Redigez des phrases fluides, orientees metier et techniques.\n"
            "- Restez factuel, neutre et concis."
        )),
        ("user", (
            "Voici les données de modifications traçées par module (Pivot : {nom_pivot}) :\n\n"
            "{input_data}\n\n"
            "Générez la fiche de version structurée."
        ))
    ])
    
    chaine = prompt_template | llm_structure
    return chaine.invoke({"nom_pivot": noeud_pivot.name, "input_data": payload_textuel})


