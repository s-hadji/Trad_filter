def drop_identique(avant, apres, liste_symboles=None):
    """ Renvoie True si avant et après sont identiques (hors casse, espaces et symboles) """
    if liste_symboles is None:
        liste_symboles = [',', '.', ';', ':', '!', '?', '(', ')', '[', ']', '{', '}', '-', '_', '"', "'", '«', '»', '/', '\\', '*']
    
