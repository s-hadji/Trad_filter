import re
import difflib

# ══════════════════════════════════════════════════════════════════════════════
# 1. CRÉATION DE L'ARBRE (STRUCTURE PAR SOUS-CHAPITRE)
# ══════════════════════════════════════════════════════════════════════════════
class ChapitreNode:
    def __init__(self, name="Racine"):
        self.name = name
        self.children = {}  # Sous-chapitres : { "Nom": ChapitreNode }
        self.modules = {}   # Modules par DM Code : { "DM-XXX": {"v1": text, "v2": text} }

def ajouter_au_trie(racine, doc, version):
    """Filtre sur XML_procedure et insère le contenu dans l'arbre selon DM_title."""
    if doc.get("type") != "XML_procedure":
        return
        
    info = doc.get("extra_information", {})
    titre = info.get("DM_title", "")
    code = info.get("DM_code", "")
    contenu = doc.get("content", "")
    
    # Découpage du chemin (ex: "Hydraulique > Vannes")
    elements = [e.strip() for e in titre.split(">") if e.strip()]
    courant = racine
    for elem in elements:
        if elem not in courant.children:
            courant.children[elem] = ChapitreNode(elem)
        courant = courant.children[elem]
    
    # Correspondance V1 / V2 au sein du même nœud
    if code not in courant.modules:
        courant.modules[code] = {"v1": None, "v2": None, "status": None, "avant": "", "apres": ""}
    courant.modules[code][version] = contenu

# ══════════════════════════════════════════════════════════════════════════════
# 2. TAGGING & AVANT / APRÈS (ORDRE CONSERVÉ + ELLIPSE IDENTIQUE)
# ══════════════════════════════════════════════════════════════════════════════
def calculer_avant_apres_global(t1, t2):
    """Génère la trajectoire linéaire ordonnée avec les balises demandées."""
    tok1 = re.findall(r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]', t1) if t1 else []
    tok2 = re.findall(r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]', t2) if t2 else []
    
    matcher = difflib.SequenceMatcher(None, tok1, tok2, autojunk=False)
    avant_pieces, apres_pieces = [], []
    
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            # Injection du tag d'égalité sans doublon
            if not avant_pieces or avant_pieces[-1] != "[...identique...]":
                avant_pieces.append("[...identique...]")
            if not apres_pieces or apres_pieces[-1] != "[...identique...]":
                apres_pieces.append("[...identique...]")
        elif tag == 'delete':
            avant_pieces.append(f"[SUPPRIMÉ: {' '.join(tok1[i1:i2])}]")
        elif tag == 'insert':
            apres_pieces.append(f"[AJOUTÉ: {' '.join(tok2[j1:j2])}]")
        elif tag == 'replace':
            avant_pieces.append(f"[SUPPRIMÉ: {' '.join(tok1[i1:i2])}]")
            apres_pieces.append(f"[AJOUTÉ: {' '.join(tok2[j1:j2])}]")
            
    return " ".join(avant_pieces), " ".join(apres_pieces)

# ══════════════════════════════════════════════════════════════════════════════
# 3. DÉTECTION DES STATUTS (NOUVEAU, SUPPRIMÉ, IDENTIQUE, MODIFIÉ)
# ══════════════════════════════════════════════════════════════════════════════
def analyser_et_tagger_arbre(noeud):
    """Parcourt l'arbre pour qualifier chaque module et générer son diff."""
    for dm_code, mod in noeud.modules.items():
        v1, v2 = mod["v1"], mod["v2"]
        
        # Détection : Nouvelle branche / Nouveau Module
        if v2 is not None and v1 is None:
            mod["status"] = "NOUVEAU"
            mod["avant"] = "[Néant - Nouveau Module]"
            mod["apres"] = f"[AJOUTÉ: {v2}]"
            
        # Détection : Suppression de branche / Module supprimé
        elif v1 is not None and v2 is None:
            mod["status"] = "SUPPRIMÉ"
            mod["avant"] = f"[SUPPRIMÉ: {v1}]"
            mod["apres"] = "[Néant - Supprimé]"
            
        # Détection : Branche présente dans les deux versions
        else:
            if v1.strip() == v2.strip():
                mod["status"] = "IDENTIQUE"
                mod["avant"] = "[...identique...]"
                mod["apres"] = "[...identique...]"
            else:
                mod["status"] = "MODIFIÉ"
                mod["avant"], mod["apres"] = calculer_avant_apres_global(v1, v2)
                
