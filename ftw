def analyser_et_tagger_arbre(noeud):
    for dm_code, mod in noeud.modules.items():
        v1, v2 = mod["v1"], mod["v2"]
        
        if v2 is not None and v1 is None:
            mod["status"] = "NOUVEAU"
            mod["avant"], mod["apres"] = "[Néant]", f"[AJOUTÉ: {v2}]"
            mod["transformations"] = [f"Création complète du module."]
            mod["mots_cles"] = extraire_mots_techniques([v2])
        elif v1 is not None and v2 is None:
            mod["status"] = "SUPPRIMÉ"
            mod["avant"], mod["apres"] = f"[SUPPRIMÉ: {v1}]", "[Néant]"
            mod["transformations"] = [f"Suppression complète du module."]
            mod["mots_cles"] = extraire_mots_techniques([v1])
        else:
            if v1.strip() == v2.strip():
                mod["status"] = "IDENTIQUE"
                mod["avant"], mod["apres"] = "[...identique...]", "[...identique...]"
            else:
                mod["status"] = "MODIFIÉ"
                mod["avant"], mod["apres"], mod["transformations"] = calculer_diff_et_mutations(v1, v2)
                # On extrait les mots-clés uniquement de ce qui a bougé (ajouts/suppressions)
                mod["mots_cles"] = extraire_mots_techniques(mod["transformations"])
                
    for enfant in noeud.children.values():
        analyser_et_tagger_arbre(enfant)

