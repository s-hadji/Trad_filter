# GESTION ET PROPAGATION RÉCURSIVE DE L'ARBRE (CORRIGÉ)
# ══════════════════════════════════════════════════════════════════════════════

def construire_trie(entrees, parent):
    ici = [e for e in entrees if not e[0]]
    if ici:
        by_code = defaultdict(list)
        for _, code, doc, version in ici:
            by_code[code].append((doc, version))
        for code, items in by_code.items():
            v1_items = [doc for doc, version in items if version == "v1"]
            v2_items = [doc for doc, version in items if version == "v2"]
            max_len = max(len(v1_items), len(v2_items))
            for i in range(max_len):
                d1 = v1_items[i] if i < len(v1_items) else None
                d2 = v2_items[i] if i < len(v2_items) else None
                nom_feuille = f"[{code}]" + (f" (p.{i+1})" if max_len > 1 else "")
                noeud_feuille = Node(nom_feuille, parent=parent)
                noeud_feuille.dm_code = code
                noeud_feuille.feuille = True
                noeud_feuille.doc_v1 = d1
                noeud_feuille.doc_v2 = d2

    restants = [e for e in entrees if e[0]]
    if not restants: return
    groupes = defaultdict(list)
    for tokens, code, doc, version in restants:
        groupes[tokens[0].lower()].append((tokens, code, doc, version))
    for _, groupe in sorted(groupes.items()):
        chemins = [e[0] for e in groupe]
        min_len = min(len(c) for c in chemins)
        n_commun = 0
        for i in range(min_len):
            if len({c[i].lower() for c in chemins}) == 1: n_commun = i + 1
            else: break
        nom_branche = " ".join(chemins[0][:n_commun])
        noeud_intermediaire = Node(nom_branche, parent=parent)
        construire_trie([(t[n_commun:], c, d, v) for t, c, d, v in groupe], noeud_intermediaire)


def propager_bottom_up(noeud):
    """Propagation récursive stricte incluant tous les niveaux de l'arbre."""
    if noeud.feuille:
        d1 = getattr(noeud, 'doc_v1', None)
        d2 = getattr(noeud, 'doc_v2', None)
        noeud.patches = []
        
        if d1 is None and d2 is not None:
            noeud.statut = "AJOUTE"
            noeud.patches.append({
                "avant": "[Néant - Nouveau Module Documentaire]", 
                "apres": f"Création et insertion complète du module {noeud.dm_code}", 
                "dm_code": noeud.dm_code
            })
        elif d2 is None and d1 is not None:
            noeud.statut = "SUPPRIME"
            noeud.patches.append({
                "avant": f"Suppression complète du module {noeud.dm_code}", 
                "apres": "[Supprimé du référentiel]", 
                "dm_code": noeud.dm_code
            })
        elif d1 is not None and d2 is not None:
            t1, t2 = d1["content"], d2["content"]
            if re.sub(r'\s+', ' ', t1).strip() == re.sub(r'\s+', ' ', t2).strip():
                noeud.statut = "INCHANGE"
            else:
                noeud.statut = "MODIFIE"
                for avant, apres in diff_contenu(t1, t2):
                    noeud.patches.append({"avant": avant, "apres": apres, "dm_code": noeud.dm_code})
    else:
        noeud.patches = []
        for enfant in noeud.children:
            propager_bottom_up(enfant)  # Appel récursif descendant
            noeud.patches.extend(enfant.patches) # Collecte montante


def estimer_tokens_arbre(noeud):
    modifs_uniques = {(p["avant"], p["apres"]) for p in noeud.patches}
    noeud.tokens_cumules = sum(len(av.split()) + len(ap.split()) for av, ap in modifs_uniques)
    if not noeud.feuille:
        for enfant in noeud.children:
            estimer_tokens_arbre(enfant)


def planifier_appels_llm(racine, budget_max_appels=10, limite_tokens_par_appel=2000):
    selection_pivots = [racine]
    continuer = True
    while continuer:
        continuer = False
        nouvelle_selection = []
        for noeud in selection_pivots:
            if noeud.tokens_cumules > limite_tokens_par_appel and not noeud.feuille:
                nouvelle_selection.extend(noeud.children)
                continuer = True
            else:
                nouvelle_selection.append(noeud)
        selection_pivots = nouvelle_selection
    return selection_pivots[:budget_max_appels]


