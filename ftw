import re
import difflib
import unicodedata
from collections import defaultdict
# Depuis ta librairie d'arbre (ex: anytree) :
# from anytree import Node, RenderTree

TOKENS_PARASITES = {'-', '/', '|', '–', '—', '·'}
ICONES = {"INCHANGE": "✅", "MODIFIE": "✏️ ", "AJOUTE": "➕", "SUPPRIME": "❌", "BRANCHE": "📁"}

def normaliser(ligne):
    if not ligne:
        return []
    ligne = unicodedata.normalize('NFKC', ligne.splitlines()[0])
    ligne = re.sub(r'\s+', ' ', ligne).strip()
    return [t for t in ligne.split(' ') if t and t not in TOKENS_PARASITES]

def extraire(dico):
    return [d for d in dico if d["type"] == "XML_procedure"]

# ══════════════════════════════════════════════════════════════════════════════
# NETTOYAGE ULTRA-AGRESSIF DES SYMBOLES ET CASSE
# ══════════════════════════════════════════════════════════════════════════════
def epurer_texte(t):
    """
    Supprime les virgules, points, parenthèses, crochets et symboles spéciaux
    pour ne garder que la moelle osseuse textuelle (insensible aux bruits).
    """
    if not t:
        return ""
    # Nettoyage des symboles demandés
    t_clean = re.sub(r'[\.,\(\)\[\]\{\}!\?;:\*\+\-/\|—–_§•·]', ' ', t)
    return re.sub(r'\s+', ' ', t_clean).strip()

def extraire_communs(liste_textes):
    if not liste_textes: 
        return "", "", []
    if len(liste_textes) == 1: 
        return liste_textes[0], "", [""]
        
    mots_listes = [t.split() for t in liste_textes]
    
    # Longest Common Prefix
    lcp_mots = []
    for zone in zip(*mots_listes):
        if len(set(zone)) == 1: lcp_mots.append(zone[0])
        else: break
    prefix = " ".join(lcp_mots)
    
    # Longest Common Suffix
    lcs_mots = []
    mots_listes_rev = [l[::-1] for l in mots_listes]
    for zone in zip(*mots_listes_rev):
        if len(set(zone)) == 1: lcs_mots.append(zone[0])
        else: break
    suffix = " ".join(lcs_mots[::-1])
    
    p_len, s_len = len(lcp_mots), len(lcs_mots)
    uniques = []
    for l in mots_listes:
        end_idx = len(l) - s_len if s_len > 0 else len(l)
        uniques.append(" ".join(l[p_len:end_idx]) if end_idx >= p_len else "")
            
    return prefix, suffix, uniques

# ══════════════════════════════════════════════════════════════════════════════
# MOTEUR DE COMPRESSION AVANCÉ (SANS SYMBOLE & NON CASSE-SENSITIVE)
# ══════════════════════════════════════════════════════════════════════════════
def compresser_patches_sous_arbre(patches):
    if not patches:
        return []
        
    # --- PASSE 1 : Groupe par 'AVANT' épuré (Fusion des symboles et des doublons) ---
    par_avant_clean = defaultdict(list)
    for p in patches:
        av_clean = epurer_texte(p["avant"])
        par_avant_clean[av_clean].append(p)
        
    regles_phase1 = []
    for av_clean, liste_p in par_avant_clean.items():
        
        # Sous-groupe par 'APRÈS' de manière NON CASSE-SENSITIVE
        par_apres_clean = defaultdict(list)
        for p in liste_p:
            ap_clean = p["apres"].strip().lower()  # Tolérance totale à la casse
            par_apres_clean[ap_clean].append(p)
            
        if len(par_apres_clean) == 1:
            # Idéal : Un seul APRÈS sémantique détecté pour cet AVANT épuré
            ap_clean, p_list = list(par_apres_clean.items())[0]
            codes = sorted(list(set(p["dm_code"] for p in p_list)))
            # On conserve la casse de la première occurrence pour l'affichage propre
            ap_display = p_list[0]["apres"]
            
            regles_phase1.append({
                "avant": av_clean,       # Affiché sans les symboles parasites qui les différenciaient
                "apres": ap_display, 
                "apres_clean": ap_clean, 
                "codes": codes, 
                "structurel": False
            })
        else:
            # Multiples APRÈS sémantiques distincts -> Analyse Suffixe / Préfixe
            apres_distincts = {}
            for ap_clean, p_list in par_apres_clean.items():
                apres_distincts[p_list[0]["apres"]] = [p["dm_code"] for p in p_list]
                
            prefix, suffix, uniques = extraire_communs(list(apres_distincts.keys()))
            tous_codes = sorted(list(set(c for c_list in apres_distincts.values() for c in c_list)))
            
            if prefix or suffix:
                choix = " | ".join(f"'{u}'" if u else "Ø" for u in sorted(set(uniques)))
                apres_condense = re.sub(r'\s+', ' ', f"{prefix} [{choix}] {suffix}").strip()
            else:
                choix = " | ".join(f"'{a}'" for a in sorted(apres_distincts.keys()))
                apres_condense = f"[ {choix} ]"
                
            regles_phase1.append({
                "avant": av_clean, 
                "apres": apres_condense, 
                "apres_clean": apres_condense.lower(), 
                "codes": tous_codes, 
                "structurel": True
            })

    # --- PASSE 2 : Groupe par 'APRÈS' épuré (Factorisation inverse / Casse ignorée) ---
    simples = [r for r in regles_phase1 if not r["structurel"]]
    complexes = [r for r in regles_phase1 if r["structurel"]]
    
    par_apres_clean_global = defaultdict(list)
    for r in simples:
        par_apres_clean_global[r["apres_clean"]].append(r)
        
    regles_finales = list(complexes)
    for ap_clean, liste_r in par_apres_clean_global.items():
        if len(liste_r) == 1:
            regles_finales.append(liste_r[0])
        else:
            # Différents AVANT mènent au même APRÈS (à la casse près)
            prefix, suffix, uniques = extraire_communs([r["avant"] for r in liste_r])
            tous_codes = sorted(list(set(c for r in liste_r for c in r["codes"])))
            ap_display = liste_r[0]["apres"]
            
            if prefix or suffix:
                choix = " | ".join(f"'{u}'" if u else "Ø" for u in sorted(set(uniques)))
                avant_condense = re.sub(r'\s+', ' ', f"{prefix} [{choix}] {suffix}").strip()
                regles_finales.append({
                    "avant": avant_condense, "apres": ap_display, "codes": tous_codes, "structurel": True
                })
            else:
                regles_finales.extend(liste_r)
                
    return regles_finales

