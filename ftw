# 2. EXTRACTION DIRECTE DES LIGNES ET DÉDUPLICATION
# ==============================================================================
def extraire_et_grouper_modifs(dico_v1, dico_v2):
    # Mapping direct du contenu par DM_code
    v1_map = {doc["extra_information"]["DM_code"]: ftfy.fix_text(doc.get("content", "")) for doc in dico_v1 if "extra_information" in doc}
    v2_map = {doc["extra_information"]["DM_code"]: ftfy.fix_text(doc.get("content", "")) for doc in dico_v2 if "extra_information" in doc}
    
    # Regroupement : (Texte_Avant, Texte_Après) -> Ensemble des DM_codes
    modifications_groupees = defaultdict(set)
    tous_les_codes = set(v1_map.keys()).union(v2_map.keys())
    
    for code in tous_les_codes:
        # On split les lignes directement
        lines1 = v1_map.get(code, "").splitlines()
        lines2 = v2_map.get(code, "").splitlines()
        
        # Le differ compare les deux listes de lignes
        matcher = difflib.SequenceMatcher(None, lines1, lines2, autojunk=False)
        
        for tag, i1, i2, j1, j2 in matcher.get_opcodes():
            if tag == 'equal':
                continue
            
            # Le differ nous donne directement les segments de lignes modifiées
            avant = "\n".join(lines1[i1:i2])
            apres = "\n".join(lines2[j1:j2])
            
            # Si la ligne ne change que par la casse, l'espace ou un symbole -> on drop
            if drop_identique(avant, apres):
                continue
            
            # On stocke le couple (Avant, Après). Si un autre module a EXACTEMENT le même, 
            # il sera fusionné ici dans le même groupe de codes.
            modifications_groupees[(avant, apres)].add(code)
            
    return modifications_groupees

