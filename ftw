                opcodes_fuses.append(bloc_courant)
                bloc_courant = None
        else:
            if bloc_courant is None:
                bloc_courant = {'tag': tag, 'i1': i1, 'i2': i2, 'j1': j1, 'j2': j2}
            else:
                # Si des modifications se collent (en amont ou en aval), on fusionne
                bloc_courant['tag'] = 'replace'
                bloc_courant['i2'] = i2
                bloc_courant['j2'] = j2
                
    if bloc_courant:
        opcodes_fuses.append(bloc_courant)
        
    transformations = []
    for o in opcodes_fuses:
        tag = o['tag']
        i1, i2, j1, j2 = o['i1'], o['i2'], o['j1'], o['j2']
        
        txt_av = ' '.join(tok1[i1:i2]) if tag in ['delete', 'replace'] else ""
        txt_ap = ' '.join(tok2[j1:j2]) if tag in ['insert', 'replace'] else ""
        
        # Application du filtre d'exclusion intelligent
        if drop_identique(txt_av, txt_ap):
            continue
            
        # Capture du contexte amont / aval
        if tag in ['delete', 'replace']:
            mot_avant = tok1[i1 - 1] if i1 > 0 else ""
            mot_apres = tok1[i2] if i2 < len(tok1) else ""
        else:
            mot_avant = tok2[j1 - 1] if j1 > 0 else ""
            mot_apres = tok2[j2] if j2 < len(tok2) else ""
            
        transformations.append({
            "tag": tag,
            "txt_av": txt_av,
            "txt_ap": txt_ap,
            "mot_avant": mot_avant,
            "mot_apres": mot_apres
        })
            
    return transformations

def executer_double_diff(v1, v2):
    lignes_v1 = v1.splitlines() if v1 else []
    lignes_v2 = v2.splitlines() if v2 else []
    
    matcher = difflib.SequenceMatcher(None, lignes_v1, lignes_v2, autojunk=False)
    
    nb_ajouts = 0
    nb_suppr = 0
    mutations_locales = []
    
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            continue
        elif tag == 'delete':
            nb_suppr += (i2 - i1)
        elif tag == 'insert':
            nb_ajouts += (j2 - j1)
        elif tag == 'replace':
            bloc_avant = "\n".join(lignes_v1[i1:i2])
            bloc_apres = "\n".join(lignes_v2[j1:j2])
            
            mutations_internes = calculer_mutations_tokens(bloc_avant, bloc_apres)
            mutations_locales.extend(mutations_internes)
            
    return nb_ajouts, nb_suppr, mutations_locales

