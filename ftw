def filtre_modif_typo(avant, apres):
    norm_av = re.sub(r'\s+', '', avant.lower())
    norm_ap = re.sub(r'\s+', '', apres.lower())
    return norm_av == norm_ap or norm_av.rstrip('s') == norm_ap.rstrip('s')

def calculer_mutations_tokens(t1, t2):
    tok1 = re.findall(r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]', t1) if t1 else []
    tok2 = re.findall(r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]', t2) if t2 else []
    
    matcher = difflib.SequenceMatcher(None, tok1, tok2, autojunk=False)
    transformations = []
    
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            continue
            
        txt_av = ' '.join(tok1[i1:i2]) if tag in ['delete', 'replace'] else ""
        txt_ap = ' '.join(tok2[j1:j2]) if tag in ['insert', 'replace'] else ""
        
        if tag in ['delete', 'replace']:
            mot_avant = tok1[i1 - 1] if i1 > 0 else ""
            mot_apres = tok1[i2] if i2 < len(tok1) else ""
        else:
            mot_avant = tok2[j1 - 1] if j1 > 0 else ""
            mot_apres = tok2[j2] if j2 < len(tok2) else ""
            
        ctx_av = f"{mot_avant} " if mot_avant else ""
        ctx_ap = f" {mot_apres}" if mot_apres else ""
        
        is_typo = filtre_modif_typo(txt_av, txt_ap)
        categorie = "TYPO" if is_typo else "REAL"
        
        if tag == 'delete':
            mut = f"... {ctx_av}[Supprimé: '{txt_av}']{ctx_ap} ..."
        elif tag == 'insert':
            mut = f"... {ctx_av}[Ajouté: '{txt_ap}']{ctx_ap} ..."
        elif tag == 'replace':
            mut = f"... {ctx_av}['{txt_av}' -> '{txt_ap}']{ctx_ap} ..."
            
        item = (mut, categorie)
        if item not in transformations:
            transformations.append(item)
            
    return transformations

def executer_double_diff(v1, v2):
    lignes_v1 = v1.splitlines() if v1 else []
    lignes_v2 = v2.splitlines() if v2 else []
    
    matcher = difflib.SequenceMatcher(None, lignes_v1, lignes_v2, autojunk=False)
    
    nb_ajouts = 0
    nb_suppr = 0
    mutations_locales = []
    
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            continue
        elif tag == 'delete':
            nb_suppr += (i2 - i1)
        elif tag == 'insert':
            nb_ajouts += (j2 - j1)
        elif tag == 'replace':
            bloc_avant = "\n".join(lignes_v1[i1:i2])
            bloc_apres = "\n".join(lignes_v2[j1:j2])
            
            mutations_internes = calculer_mutations_tokens(bloc_avant, bloc_apres)
            mutations_locales.extend(mutations_internes)
            
    return nb_ajouts, nb_suppr, mutations_locales

