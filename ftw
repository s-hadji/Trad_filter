# PIPELINE LANGCHAIN DE GÉNÉRATION DE FICHE TECHNIQUE
# ══════════════════════════════════════════════════════════════════════════════

def generer_fiche_version_llm(noeud_pivot) -> FicheVersionGlobale:
    donnees_pack = extraire_payload_du_pivot(noeud_pivot)
    payload_textuel = json.dumps(donnees_pack, indent=2, ensure_ascii=False)
    
    llm = ChatOpenAI(model="gpt-4o", temperature=0.1)
    llm_structure = llm.with_structured_output(FicheVersionGlobale)
    
    prompt_template = ChatPromptTemplate.from_messages([
        ("system", (
            "Vous etes un expert de la documentation technique et de la gestion de configuration.\n"
            "Votre role est de transformer un condensat brut de modifications textuelles en une fiche "
            "de version intelligible pour des operateurs humains.\n\n"
            "Regles de redaction strictes :\n"
            "- N'utilisez aucun emoji, icone graphique ou artifice de mise en forme visuelle.\n"
            "- Redigez des phrases fluides, orientees metier et purement explicatives.\n"
            "- Conservez la precision des variables ou chiffres cles indiques dans les blocs.\n"
            "- Restez factuel, neutre et concis."
        )),
        ("user", (
            "Voici les donnees structurees issues de notre pack optimise (Pivot : {nom_pivot}) :\n\n"
            "{input_data}\n\n"
            "Generez la fiche de version conformement au schema structure demande."
        ))
    ])
    
    chaine = prompt_template | llm_structure
    return chaine.invoke({"nom_pivot": noeud_pivot.name, "input_data": payload_textuel})


