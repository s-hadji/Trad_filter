# 2. STRUCTURE DE L'ARBRE
# ==============================================================================
class ChapitreNode:
    def __init__(self, name="Racine"):
        self.name = name
        self.children = {}  
        self.modules = {}   

def ajouter_au_trie(racine, doc, version):
    if doc.get("type") != "XML_fusionne": 
        return
        
    info = doc.get("extra_information", {})
    titre, code, contenu = info.get("DM_title", ""), info.get("DM_code", ""), doc.get("content", "")
    
    type_label = "Fusionne"
    elements = [e.strip() for e in titre.split(">") if e.strip()]
    
    courant = racine
    for elem in elements:
        if elem not in courant.children:
            courant.children[elem] = ChapitreNode(elem)
        courant = courant.children[elem]
    
    cle_module = (code, type_label)
    if cle_module not in courant.modules:
        courant.modules[cle_module] = {
            "v1": None, "v2": None, "status": None, 
            "lignes_ajoutees": 0, "lignes_supprimees": 0, "transformations_internes": []
        }
        
    courant.modules[cle_module][version] = contenu

# ==============================================================================
# 3. FILTRAGE ET ANALYSE DES MODIFICATIONS (DOUBLE DIFF)
# ==============================================================================
def filtre_modif_typo(avant, apres):
    norm_av = re.sub(r'\s+', '', avant.lower())
    norm_ap = re.sub(r'\s+', '', apres.lower())
    return norm_av == norm_ap or norm_av.rstrip('s') == norm_ap.rstrip('s')

def calculer_mutations_tokens(t1, t2):
    """ Diff de Niveau 2 : Analyse au niveau des mots/tokens à l'intérieur d'une ligne """
    tok1 = re.findall(r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]', t1) if t1 else []
    tok2 = re.findall(r'[a-zA-Z0-9À-ÿ]+|[^a-zA-Z0-9À-ÿ\s]', t2) if t2 else []
    
    matcher = difflib.SequenceMatcher(None, tok1, tok2, autojunk=False)
    transformations = []
    
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            continue
            
        txt_av = ' '.join(tok1[i1:i2]) if tag in ['delete', 'replace'] else ""
        txt_ap = ' '.join(tok2[j1:j2]) if tag in ['insert', 'replace'] else ""
        
        is_typo = filtre_modif_typo(txt_av, txt_ap)
        categorie = "TYPO" if is_typo else "REAL"
        
        if tag == 'delete':
            mut = f"Retrait de : '{txt_av}'"
        elif tag == 'insert':
            mut = f"Ajout de : '{txt_ap}'"
        elif tag == 'replace':
            mut = f"'{txt_av}' -> '{txt_ap}'"
            
        item = (mut, categorie)
        if item not in transformations:
            transformations.append(item)
            
    return transformations

def executer_double_diff(v1, v2):
    """ Diff de Niveau 1 : splitlines() et aiguillage intelligent """
    lignes_v1 = v1.splitlines() if v1 else []
    lignes_v2 = v2.splitlines() if v2 else []
    
    matcher = difflib.SequenceMatcher(None, lignes_v1, lignes_v2, autojunk=False)
    
    nb_ajouts = 0
    nb_suppr = 0
    mutations_locales = []
    
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            # On dégage, on ne fait rien
            continue
            
        elif tag == 'delete':
            # Lignes pures supprimées -> mis de côté pour la phrase statistique
            nb_suppr += (i2 - i1)
            
        elif tag == 'insert':
            # Lignes pures ajoutées -> mis de côté pour la phrase statistique
            nb_ajouts += (j2 - j1)
            
        elif tag == 'replace':
            # Lignes MODIFIÉES -> On rentre à l'intérieur et on refait le differ !
            bloc_avant = "\n".join(lignes_v1[i1:i2])
            bloc_apres = "\n".join(lignes_v2[j1:j2])
            
            mutations_internes = calculer_mutations_tokens(bloc_avant, bloc_apres)
            mutations_locales.extend(mutations_internes)
            
    return nb_ajouts, nb_suppr, mutations_locales

def analyser_et_tagger_arbre(noeud):
    for cle_module, mod in noeud.modules.items():
        v1, v2 = mod["v1"], mod["v2"]
        
        if v2 is not None and v1 is None:
            mod["status"] = "NOUVEAU"
            mod["lignes_ajoutees"] = len(v2.splitlines())
        elif v1 is not None and v2 is None:
            mod["status"] = "SUPPRIME"
            mod["lignes_supprimees"] = len(v1.splitlines())
        else:
            if v1.strip() == v2.strip():
                mod["status"] = "IDENTIQUE"
            else:
                mod["status"] = "MODIFIE"
                # Exécution de notre double stratégie
                ajouts, suppr, modifs = executer_double_diff(v1, v2)
                mod["lignes_ajoutees"] = ajouts
                mod["lignes_supprimees"] = suppr
                mod["transformations_internes"] = modifs
                
    for enfant in noeud.children.values():
        analyser_et_tagger_arbre(enfant)

# ==============================================================================
# 4. COLLECTE ET GÉNÉRATION DES BATCHS ULTRA-CONDENSÉS
# ==============================================================================
def collecter_donnees_condensees(noeud, chemin_actuel="", donnees_par_branche=None):
    if donnees_par_branche is None:
        donnees_par_branche = defaultdict(lambda: {"resume_lignes": [], "modifications": [], "typos": []})
        
    nom_chemin = f"{chemin_actuel} > {noeud.name}" if chemin_actuel else noeud.name
    
    for (dm_code, type_label), mod in noeud.modules.items():
        identifiant_bloc = f"{dm_code}"
        
        # Économie d'appels : on génère une phrase descriptive plutôt que de donner les lignes brutes
        if mod["lignes_ajoutees"] > 0 or mod["lignes_supprimees"] > 0:
            phrase = f"Module {identifiant_bloc} : {mod['lignes_ajoutees']} ligne(s) ajoutée(s), {mod['lignes_supprimees']} ligne(s) supprimée(s)."
            donnees_par_branche[nom_chemin]["resume_lignes"].append(phrase)
            
        # Uniquement ce qui a été modifié à l'intérieur (le vrai travail du LLM)
        if mod["status"] == "MODIFIE" and mod["transformations_internes"]:
            for mut, categorie in mod["transformations_internes"]:
                if categorie == "TYPO":
                    donnees_par_branche[nom_chemin]["typos"].append(f"{identifiant_bloc}: {mut}")
                else:
                    donnees_par_branche[nom_chemin]["modifications"].append({
                        "bloc": identifiant_bloc,
                        "mutation": mut
                    })
                    
    for enfant in noeud.children.values():
        collecter_donnees_condensees(enfant, nom_chemin, donnees_par_branche)
        
    return donnees_par_branche

def generer_batchs_llm(donnees_par_branche, max_tokens_per_batch=1000):
    batchs = []
    contenu_courant = []
    tokens_courants = 0
    
    consigne_systeme = (
        "ROLE: Analyser les micro-modifications textuelles fournies. Repérer si un "
        "changement de mot ou de formulation se répète d'un module à l'autre.\n"
        "==================================================================\n"
    )
    
    for chemin, contenu in donnees_par_branche.items():
        bloc_texte_branche = f"Sous-Branche : {chemin}\n"
        
        # Injection des phrases condensées (Le LLM sait ce qui s'est passé globalement sans consommer de tokens)
        if contenu["resume_lignes"]:
            bloc_texte_branche += "  Structure globale :\n"
            for phrase in contenu["resume_lignes"]:
                bloc_texte_branche += f"    - {phrase}\n"
                
        if contenu["typos"]:
            bloc_texte_branche += f"  Typos ignorées localement : {len(contenu['typos'])} détectées.\n"
            
        # Le cœur de l'analyse interne transmis au LLM
        if contenu["modifications"]:
            bloc_texte_branche += "  Modifications internes précises à corréler :\n"
            for modif in contenu["modifications"]:
                bloc_texte_branche += f"    - {modif['bloc']} | {modif['mutation']}\n"
                
        bloc_texte_branche += "--------------------------------------------------\n"
        
        # Heuristique d'estimation rapide de la taille du lot
        tokens_bloc = max(1, len(bloc_texte_branche) // 4)
        
        if tokens_courants + tokens_bloc > max_tokens_per_batch:
            batchs.append(consigne_systeme + "".join(contenu_courant))
            contenu_courant = [bloc_texte_branche]
            tokens_courants = tokens_bloc
        else:
            contenu_courant.append(bloc_texte_branche)
            tokens_courants += tokens_bloc
            
    if contenu_courant:
        batchs.append(consigne_systeme + "".join(contenu_courant))
        
    return batchs

