    synthese_macro: str = Field(description="Résumé global de l'orientation technique de ce paquet de modifications.")
    sections: List[SectionChapitre] = Field(description="Ensemble des chapitres documentaires modifiés.")


def generer_fiche_version_llm(noeud_pivot) -> FicheVersionGlobale:
    """Prend un nœud pivot, extrait son payload de diffs avec contexte, et interroge le LLM."""
    donnees_pack = extraire_payload_du_pivot(noeud_pivot)
    payload_textuel = json.dumps(donnees_pack, indent=2, ensure_ascii=False)
    
    llm = ChatOpenAI(model="gpt-4o", temperature=0.1)
