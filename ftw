def extraire_donnees_utiles(liste_noeuds_optimises):
    resultat_nettoye = []

    for node in liste_noeuds_optimises:
        dict_feuilles = {}
        stack = [node]
        
        while stack:
            curr = stack.pop()
            if not curr.children:
                dm_code = getattr(curr, 'dm_code', None)
                md_out = getattr(curr, 'md_out', None)
                
                # On ne garde la feuille que si elle a un code ET du contenu textuel réel
                if dm_code and md_out and str(md_out).strip():
                    dict_feuilles[dm_code] = md_out
            else:
                stack.extend(curr.children)
                
        # VÉRIFICATION : Si le dictionnaire est vide (tout était None ou vide),
        # on DROP le node, il ne sert à rien.
        if dict_feuilles:
            resultat_nettoye.append({
                "node": node,
                "donnees": dict_feuilles
            })

    return resultat_nettoye



def extraire_donnees_feuilles(liste_noeuds_optimises):
    resultat_final = []

    for node in liste_noeuds_optimises:
        dict_feuilles = {}
        
        # --- Étape 1 : Récupérer toutes les feuilles sous ce nœud ---
        # On utilise une petite pile (stack) locale pour trouver les feuilles
        stack = [node]
        while stack:
            curr = stack.pop()
            
            if not curr.children:
                # C'est une feuille ! On extrait ses infos
                # Le .getattr() sécurise le code si un attribut est manquant
                dm_code = getattr(curr, 'dm_code', 'sans_code')
                md_out = getattr(curr, 'md_out', '')
                
                # On remplit le dictionnaire de ce nœud
                dict_feuilles[dm_code] = md_out
            else:
                # Ce n'est pas une feuille, on continue à descendre
                stack.extend(curr.children)
                
        # --- Étape 2 : Associer le nœud d'origine avec son dictionnaire de feuilles ---
        resultat_final.append({
            "node": node,
            "donnees": dict_feuilles
        })

    return resultat_final




def extraire_branches_optimales(node, max_token, resultats=None):
    # Initialisation de la liste au premier appel
    if resultats is None:
        resultats = []
        
    if not node:
        return resultats

    # CONDITION 1 & 2 : Si le nœud respecte la limite, c'est le plus haut valide.
    # On le stocke et on NE DESCEND PAS chez ses enfants (élagage).
    if node.token_cumulés <= max_token:
        resultats.append(node)
        return resultats

    # Si le nœud est trop grand, on est obligé de descendre d'un niveau
    if node.children:
        for child in node.children:
            extraire_branches_optimales(child, max_token, resultats)
            
    return resultats




def calculer_tokens_rec(node):
    if not node:
        return 0

    # Cas d'une feuille : son token_cumulés vaut la longueur de son propre md_out
    if not node.children:
        # Le .getattr() évite les bugs si md_out est absent ou None
        md_out_content = getattr(node, 'md_out', '') or ''
        node.token_cumulés = len(md_out_content)
        return node.token_cumulés

    # Cas d'un parent : on fait d'abord descendre la récursion chez les enfants
    total_enfants = 0
    for child in node.children:
        total_enfants += calculer_tokens_rec(child)

    # Le parent stocke la somme récupérée de ses enfants
    node.token_cumulés = total_enfants
    return node.token_cumulés


