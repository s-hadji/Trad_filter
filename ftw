class NoeudTrie:
    """Structure de nœud itérative pour arbre de préfixes (Trie)."""
    def __init__(self, texte=""):
        self.texte = texte
        self.enfants = {}  

    def inserer(self, tokens):
        """
        VERSION ITÉRATIVE : Plus aucun risque de RecursionError !
        On utilise une boucle de haut en bas pour créer la branche.
        """
        noeud_courant = self
        for token in tokens:
            if token not in noeud_courant.enfants:
                noeud_courant.enfants[token] = NoeudTrie(token)
            # On descend d'un niveau manuellement, sans rappeler la fonction
            noeud_courant = noeud_courant.enfants[token]

    def generer_arbre_rich(self, noeud_rich=None):
        """Convertit la structure en arbre Rich pour l'affichage."""
        if noeud_rich is None:
            noeud_rich = Tree(f"📁 [bold gold3]{getattr(self, 'text_racine', 'Racine des Procédures')}[/bold gold3]")
            
        for texte_enfant, noeud_enfant in self.enfants.items():
            style = "[bold cyan]" if noeud_enfant.enfants else "[white]"
            branche = noeud_rich.add(f"{style}{texte_enfant}[/]")
            noeud_enfant.generer_arbre_rich(branche)
            
        return noeud_rich


def construire_arbre_generique(liste_chaines, fonction_decoupage=None):
    """Trie les données et construit l'arbre de manière robuste."""
    # Tri alphabétique initial
    donnees_triees = sorted(liste_chaines)
    
    if fonction_decoupage is None:
        fonction_decoupage = lambda texte: [t.strip() for t in re.split(r'[\s\-/]+', texte) if t.strip()]
        
    racine = NoeudTrie()
    racine.text_racine = "Racine des Procédures"
    
    # Itération sur toutes les lignes
    for chaine in donnees_triees:
        tokens = fonction_decoupage(chaine)
        racine.inserer(tokens) # Utilise la méthode itérative safe
        
    return racine




