# =====================================================================

def estimer_tokens_arbre(noeud):
    if noeud.feuille:
        poids = 0
        for patch in noeud.patches:
            poids += len(patch["avant"].split()) + len(patch["apres"].split())
        noeud.tokens_cumules = poids
    else:
        for enfant in noeud.children:
            estimer_tokens_arbre(enfant)
        noeud.tokens_cumules = sum(enfant.tokens_cumules for enfant in noeud.children)


def planifier_appels_llm(racine, budget_max_appels=10, limite_tokens_par_appel=2000):
    selection_pivots = [racine]
    
    continuer_decoupage = True
    while continuer_decoupage:
        continuer_decoupage = False
        nouvelle_selection = []
        
        for noeud in selection_pivots:
            if noeud.tokens_cumules > limite_tokens_par_appel and not noeud.feuille:
                nouvelle_selection.extend(noeud.children)
                continuer_decoupage = True
            else:
                nouvelle_selection.append(noeud)
        selection_pivots = nouvelle_selection

    if len(selection_pivots) > budget_max_appels:
        return selection_pivots

    while len(selection_pivots) < budget_max_appels:
        noeuds_divisibles = [n for n in selection_pivots if not n.feuille]
        if not noeuds_divisibles:
            break
            
        noeud_cible = max(noeuds_divisibles, key=lambda n: n.tokens_cumules)
        croissance_liste = len(noeud_cible.children) - 1
        
        if len(selection_pivots) + croissance_liste <= budget_max_appels:
            selection_pivots.remove(noeud_cible)
            selection_pivots.extend(noeud_cible.children)
        else:
            noeuds_eligibles = [
                n for n in noeuds_divisibles 
                if len(n.children) - 1 <= (budget_max_appels - len(selection_pivots))
            ]
            if not noeuds_eligibles:
                break
                
            noeud_compromis = max(noeuds_eligibles, key=lambda n: n.tokens_cumules)
            selection_pivots.remove(noeud_compromis)
            selection_pivots.extend(noeud_compromis.children)
            
    return selection_pivots


def generer_dictionnaire_planning(noeuds_pivots):
    liste_appels = []
    compteur_appels = 1
    
    for noeud in noeuds_pivots:
        if noeud.tokens_cumules == 0:
            continue
            
        chemin_groupe = " > ".join(ancetre.name for ancetre in noeud.path)
        
        liste_contenu = []
        for patch in noeud.patches:
            liste_contenu.append({
                "dm_code": patch["dm_code"],
                "avant": patch["avant"],
                "apres": patch["apres"]
            })
            
        liste_appels.append({
            "id_appel": compteur_appels,
            "groupe": chemin_groupe,
            "tokens": noeud.tokens_cumules,
            "contenu": liste_contenu
        })
        compteur_appels += 1
        
    return {"planification": liste_appels}


