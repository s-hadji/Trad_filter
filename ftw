class ModificationDetaillee(BaseModel):
    descriptions: List[str] = Field(
        description="Description technique claire de l'evolution. Mentionner obligatoirement les modules (DMC) concernes par cette ligne."
    )

class SectionFicheVersion(BaseModel):
    chapitre: str = Field(description="Chemin complet ou chapitre cible de la modification.")
    codes_dm: List[str] = Field(description="Liste des codes DM (DMC) impactes dans ce chapitre.")
    modifications_apportees: ModificationDetaillee = Field(description="Synthese descriptive et ciblee de la modification.")

class FicheVersionGlobale(BaseModel):
    titre_fiche: str = Field(description="Intitule formel de la note de version.")
    resume_macro: str = Field(description="Explication globale de haut niveau synthetisant l'impact technique.")
    sections: List[SectionFicheVersion] = Field(description="Ensemble des chapitres modifies.")


