# Helper: intra-line diff highlighting
# ─────────────────────────────────────────────────────────────────────────────

def _intraline_markup(a: str, b: str) -> tuple[str, str]:
    """Return (marked_a, marked_b) with <span> highlights on changed chars."""
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    out_a, out_b = [], []
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        seg_a = html.escape(a[i1:i2])
        seg_b = html.escape(b[j1:j2])
        if tag == "equal":
            out_a.append(seg_a)
            out_b.append(seg_b)
        elif tag == "replace":
            out_a.append(f'<span class="hl-del">{seg_a}</span>')
            out_b.append(f'<span class="hl-add">{seg_b}</span>')
        elif tag == "delete":
            out_a.append(f'<span class="hl-del">{seg_a}</span>')
        elif tag == "insert":
            out_b.append(f'<span class="hl-add">{seg_b}</span>')
    return "".join(out_a), "".join(out_b)


def _he(s: str) -> str:
    return html.escape(s, quote=False)


# ─────────────────────────────────────────────────────────────────────────────
# ModernHtmlDiff
# ─────────────────────────────────────────────────────────────────────────────

class ModernHtmlDiff(difflib.HtmlDiff):
    """
    A modern, opinionated extension of difflib.HtmlDiff.

    Parameters
    ----------
    filter_trivial : bool
        If True (default), diffs whose *entire* changed content is composed of
        isolated punctuation / symbols are silently promoted to 'equal'.
    extra_trivial_chars : str
        Additional characters considered trivial (appended to the default set).
    normalize_content : bool
        Ignore diffs where both sides have identical words once punctuation and
        whitespace are stripped (space/comma/dot-only differences). Default False.
    context : bool
        Show only context lines around changes (default False = full diff).
    numlines : int
        Context lines around each change when context=True.
    tabsize : int
        Tab stop spacing (passed to parent).
    wrapcolumn : int | None
        Wrap column (passed to parent).
    """

    def __init__(
        self,
        filter_trivial: bool = True,
        normalize_content: bool = False,
        extra_trivial_chars: str = "",
        context: bool = False,
        numlines: int = 3,
        tabsize: int = 4,
        wrapcolumn: int | None = None,
    ) -> None:
        """
        Parameters
        ----------
        filter_trivial : bool
            Ignore diffs whose entire changed content is isolated symbols
            (commas, dashes, etc.). Default True.
        normalize_content : bool
            Ignore diffs where both sides carry the *same words* once
            punctuation and whitespace are stripped. Catches changes like
            adding/removing a comma, an extra space, or a trailing dot while
            the actual words are unchanged. Default False.
            Can be combined with filter_trivial (both filters are applied).
        extra_trivial_chars : str
            Extra characters added to the symbol set used by filter_trivial.
        """
        super().__init__(tabsize=tabsize, wrapcolumn=wrapcolumn)
        self.filter_trivial = filter_trivial
        self.normalize_content = normalize_content
        self.context = context
        self.numlines = numlines
        if extra_trivial_chars:
            global _TRIVIAL_SYMBOLS
            _TRIVIAL_SYMBOLS = _TRIVIAL_SYMBOLS | frozenset(extra_trivial_chars)

    # ── core opcode pipeline ─────────────────────────────────────────────────

    def _compute_opcodes(
        self,
        a_lines: list[str],
        b_lines: list[str],
    ) -> list[tuple]:
        sm = difflib.SequenceMatcher(None, a_lines, b_lines, autojunk=False)
        opcodes = sm.get_opcodes()
        if self.filter_trivial:
            opcodes = _strip_trivial(opcodes, a_lines, b_lines)
        if self.normalize_content:
            opcodes = _strip_content_equal(opcodes, a_lines, b_lines)
        return opcodes

    def _build_blocks(
        self,
        a_lines: list[str],
        b_lines: list[str],
    ) -> list[DiffBlock]:
        """Turn opcodes into DiffBlock list."""
        opcodes = self._compute_opcodes(a_lines, b_lines)
        blocks: list[DiffBlock] = []
        for tag, i1, i2, j1, j2 in opcodes:
            blocks.append(
                DiffBlock(
                    tag=tag,
                    a_lines=a_lines[i1:i2],
                    b_lines=b_lines[j1:j2],
                    a_start=i1 + 1,
                    b_start=j1 + 1,
                )
            )
        return blocks

    # ── public API ───────────────────────────────────────────────────────────

    def has_changes(
        self,
        fromlines: Sequence[str],
        tolines: Sequence[str],
    ) -> bool:
        """Return True if the two texts differ after trivial-symbol filtering."""
        a = [l.rstrip("\n") for l in fromlines]
        b = [l.rstrip("\n") for l in tolines]
        return any(bl.tag != "equal" for bl in self._build_blocks(a, b))

    def get_clean_rules(
        self,
        fromlines: Sequence[str],
        tolines: Sequence[str],
        protect: list[str] | None = None,
    ) -> list[dict]:
        """
        Extract a flat list of word-level replacement rules.

        Strategy
        --------
        1. Build diff blocks (respects filter_trivial / normalize_content).
        2. For each changed block, iterate line pairs.
        3. Skip pairs where the two lines are identical (no work needed).
        4. For every truly changed pair, diff at *word* level — never character
           level — so each rule already covers complete tokens with no noise.
        5. Merge consecutive changed word groups into one rule (handles
           "Alice Dupont" → "Bob Martin" as a single replacement rather than
           two, without crossing meaningful equal words).

        Parameters
        ----------
        fromlines : list[str]
            Lines of the original document.
        tolines : list[str]
            Lines of the modified document.
        protect : list[str] | None
            Optional list of regex patterns whose matches are treated as
            indivisible tokens, even when they contain spaces.

            Example — keep legal references intact (use raw strings):

                protect=[
                    r"art\\.\\s+L\\.\\s*[\\d][\\d\\-\\.]*",
                    r"R\\.\\s*\\d+[\\d\\-\\.a-z]*",
                ]

            Any space that falls inside a pattern match is NOT used as a
            split boundary, so the whole match becomes one token.

        Each rule dict
        --------------
            type        – "replace" (before/after both non-empty),
                          "delete"  (after is empty),
                          "insert"  (before is empty)
            before      – word(s) that were there  (empty for pure insertions)
            after       – word(s) that replaced it (empty for pure deletions)
            range_a     – (start, end) char offsets inside the original line
            range_b     – (start, end) char offsets inside the new line
            file_line_a – 1-based line number in the source document
            file_line_b – 1-based line number in the target document

        Example
        -------
        >>> d = ModernHtmlDiff()
        >>> d.get_clean_rules(["(ref R.306-5)"], ["(ref R.230a)"])
        [{"type": "replace", "before": "R.306-5", "after": "R.230a", ...}]
        """
        a_lines = [l.rstrip("\n") for l in fromlines]
        b_lines = [l.rstrip("\n") for l in tolines]
        blocks   = self._build_blocks(a_lines, b_lines)
        protect  = protect or []

        rules: list[dict] = []

        for bl in blocks:
            if bl.tag == "equal":
                continue  # nothing to do for unchanged blocks

            for line_a, line_b, rel_ai, rel_bi in                     self._pair_block_lines(bl.a_lines, bl.b_lines):

                # Compute absolute 1-based line numbers from block start + index.
                # None on one side means pure insertion/deletion.
                a_ln = bl.a_start + rel_ai if rel_ai is not None else bl.a_start
                b_ln = bl.b_start + rel_bi if rel_bi is not None else bl.b_start

                if line_a == line_b:   # identical → skip
                    continue

                for rule in self._word_level_rules(line_a, line_b, protect):
                    rule["file_line_a"] = a_ln
                    rule["file_line_b"] = b_ln
                    rules.append(rule)

        return rules

    @staticmethod
    def _pair_block_lines(
        a_lines: list[str],
        b_lines: list[str],
    ) -> list[tuple[str, str, int | None, int | None]]:
        """
        Find the best (a_line, b_line) pairings inside a replace block.

        Returns a list of ``(a_line, b_line, a_idx, b_idx)`` where:

        * ``a_idx`` / ``b_idx`` are 0-based indices in the original arrays.
        * ``None`` on one side means a pure insertion or deletion.

        Two-level strategy
        ------------------
        **Level 1 — exact anchors (SequenceMatcher on line strings)**
          Lines that are strictly identical are found first and used as
          anchors.  This splits the block into smaller sub-blocks, each of
          which is locally coherent.

        **Level 2 — similarity pairing (greedy ratio matching)**
          Inside each remaining replace sub-block, lines are paired by the
          best ``SequenceMatcher.ratio()`` score rather than by position.
          This correctly pairs "Note: draft" with "Note: révisé" even when
          a new line ("Tag: urgent") was inserted between them, which would
          have shifted every positional pairing by one.

          Pairs with a ratio below ``min_ratio`` (default 0.2) are not
          forced — the line is instead emitted as a pure insertion/deletion.
        """
        if not a_lines:
            return [("", b, None, bi) for bi, b in enumerate(b_lines)]
        if not b_lines:
            return [(a, "", ai, None) for ai, a in enumerate(a_lines)]

        pairs: list[tuple[str, str, int | None, int | None]] = []
        sm = difflib.SequenceMatcher(None, a_lines, b_lines, autojunk=False)

        for tag, i1, i2, j1, j2 in sm.get_opcodes():
            if tag == "equal":
                for k, (a, b) in enumerate(zip(a_lines[i1:i2], b_lines[j1:j2])):
                    pairs.append((a, b, i1 + k, j1 + k))

            elif tag == "delete":
                for k, a in enumerate(a_lines[i1:i2]):
                    pairs.append((a, "", i1 + k, None))

            elif tag == "insert":
                for k, b in enumerate(b_lines[j1:j2]):
                    pairs.append(("", b, None, j1 + k))

            elif tag == "replace":
                sub_a = a_lines[i1:i2]
                sub_b = b_lines[j1:j2]
                for a_line, b_line, rel_ai, rel_bi in                         ModernHtmlDiff._similarity_pairs(sub_a, sub_b):
                    ai = (i1 + rel_ai) if rel_ai is not None else None
                    bi = (j1 + rel_bi) if rel_bi is not None else None
                    pairs.append((a_line, b_line, ai, bi))

        return pairs

    @staticmethod
    def _similarity_pairs(
        a_chunk: list[str],
        b_chunk: list[str],
        min_ratio: float = 0.2,
    ) -> list[tuple[str, str, int | None, int | None]]:
        """
        Pair lines from *a_chunk* and *b_chunk* by best similarity ratio.

        Algorithm
        ---------
        1. Build the full (len_a × len_b) ratio matrix — one
           ``SequenceMatcher`` per cell.  Blocks are typically small
           (< 10 lines) so this is fast in practice.
        2. Greedy: repeatedly pick the (ai, bi) cell with the highest ratio
           and emit that pair, then mark both indices as used.
        3. Stop pairing when the best remaining ratio drops below
           *min_ratio*; remaining lines on each side become orphans
           (pure deletions / insertions).
        4. Re-sort the output to preserve the original relative order of
           each side (A-side order first, then B-side orphan insertions).
        """
        if not a_chunk:
            return [("", b, None, bi) for bi, b in enumerate(b_chunk)]
        if not b_chunk:
            return [(a, "", ai, None) for ai, a in enumerate(a_chunk)]

        # ── Step 1: ratio matrix ─────────────────────────────────────────────
        ratios = [
            [
                difflib.SequenceMatcher(None, a, b, autojunk=False).ratio()
                for b in b_chunk
            ]
            for a in a_chunk
        ]

        # ── Step 2: greedy best-match ────────────────────────────────────────
        a_used: set[int] = set()
        b_used: set[int] = set()
        matches: list[tuple[int, int]] = []   # (ai, bi)

        while len(a_used) < len(a_chunk) and len(b_used) < len(b_chunk):
            best_r, best_ai, best_bi = -1.0, -1, -1
            for ai in range(len(a_chunk)):
                if ai in a_used:
                    continue
                for bi in range(len(b_chunk)):
                    if bi in b_used:
                        continue
                    if ratios[ai][bi] > best_r:
                        best_r = ratios[ai][bi]
                        best_ai, best_bi = ai, bi

            if best_r < min_ratio:
                break   # remaining lines are too different → orphans

            matches.append((best_ai, best_bi))
            a_used.add(best_ai)
            b_used.add(best_bi)

        # ── Step 3: build ordered output ─────────────────────────────────────
        # Preserve A-side order; B-orphans are appended at the end.
        b_matched: dict[int, int] = {bi: ai for ai, bi in matches}
        a_to_b:   dict[int, int] = {ai: bi for ai, bi in matches}

        result: list[tuple[str, str, int | None, int | None]] = []
        b_emitted: set[int] = set()

        for ai in range(len(a_chunk)):
            if ai in a_to_b:
                bi = a_to_b[ai]
                result.append((a_chunk[ai], b_chunk[bi], ai, bi))
                b_emitted.add(bi)
            else:
                result.append((a_chunk[ai], "", ai, None))   # a-orphan → delete

        for bi in range(len(b_chunk)):
            if bi not in b_emitted:
                result.append(("", b_chunk[bi], None, bi))   # b-orphan → insert

        return result

    @staticmethod
    def _word_level_rules(a: str, b: str, protect: list[str] | None = None) -> list[dict]:
        """
        Diff two lines at word level and return replacement rules.

        Algorithm
        ---------
        1. Split each line into (word, char_offset) pairs using a
           protect-aware tokenizer.
           - Find all spans covered by the ``protect`` patterns.
           - Any space inside a protected span is NOT a split boundary,
             so the whole match is one indivisible token.
           - Remaining spaces split normally.
        2. Run SequenceMatcher on the *word lists* (not characters), so tokens
           like "R.306-5" or "art. L. 302-4" are indivisible units.
        3. Merge consecutive non-equal opcodes into one rule.
        4. Reconstruct char offsets from the positions tracked in step 1.
        """
        # ── Step 1: protect-aware tokenizer ─────────────────────────────────
        def protected_positions(text: str, patterns: list[str]) -> set[int]:
            """Return the set of space positions that must NOT be split on."""
            blocked: set[int] = set()
            for pat in patterns:
                for m in re.finditer(pat, text):
                    for pos in range(m.start(), m.end()):
                        if text[pos] == " ":
                            blocked.add(pos)
            return blocked

        def split_words(text: str, blocked: set[int]) -> tuple[list[str], list[int]]:
            """Split on unblocked spaces; return (words, char_offsets)."""
            words, offsets = [], []
            i = 0
            while i < len(text):
                if text[i] == " " and i not in blocked:
                    i += 1          # unprotected space → separator, skip
                else:
                    j = i
                    while j < len(text) and (text[j] != " " or j in blocked):
                        j += 1
                    words.append(text[i:j])
                    offsets.append(i)
                    i = j
            return words, offsets

        patterns = protect or []
        a_words, a_off = split_words(a, protected_positions(a, patterns))
        b_words, b_off = split_words(b, protected_positions(b, patterns))

        # Edge case: one or both sides are empty / whitespace-only
        if not a_words and not b_words:
            return []
        if not a_words:
            return [{"type": "insert", "before": "", "after": b.strip(),
                     "range_a": (0, 0), "range_b": (0, len(b))}]
        if not b_words:
            return [{"type": "delete", "before": a.strip(), "after": "",
                     "range_a": (0, len(a)), "range_b": (0, 0)}]

        # ── Step 2: word-level SequenceMatcher ───────────────────────────────
        sm      = difflib.SequenceMatcher(None, a_words, b_words, autojunk=False)
        opcodes = sm.get_opcodes()

        # ── Step 3: merge consecutive non-equal opcodes ──────────────────────
        merged: list[tuple] = []
        for tag, i1, i2, j1, j2 in opcodes:
            if tag == "equal":
                merged.append((tag, i1, i2, j1, j2))
                continue
            if merged and merged[-1][0] != "equal":
                # Two changes with no equal between them → fuse into one
                pt, pi1, _, pj1, _ = merged[-1]
                merged[-1] = ("replace", pi1, i2, pj1, j2)
            else:
                merged.append((tag, i1, i2, j1, j2))

        # ── Step 4: format rules with char offsets ───────────────────────────
        rules: list[dict] = []
        for tag, i1, i2, j1, j2 in merged:
            if tag == "equal":
                continue

            before = " ".join(a_words[i1:i2])
            after  = " ".join(b_words[j1:j2])

            if before == after:          # safety: identical after join → skip
                continue

            # Char range: start of first word … end of last word
            a_start = a_off[i1]          if i1 < len(a_off) else len(a)
            a_end   = a_off[i2-1] + len(a_words[i2-1]) if i2 > 0 else a_start
            b_start = b_off[j1]          if j1 < len(b_off) else len(b)
            b_end   = b_off[j2-1] + len(b_words[j2-1]) if j2 > 0 else b_start

            kind = "replace" if before and after else ("delete" if before else "insert")

            # Trim matching non-alphanumeric characters from both ends.
            # "R.306-5)" and "R.230a)" share the trailing ")" → strip it
            # so the rule reads "R.306-5 → R.230a" instead of "R.306-5) → R.230a)".
            # Only non-alnum characters that are IDENTICAL on both sides are trimmed,
            # so internal punctuation like the "." and "-" in "R.306-5" is preserved.
            if kind == "replace":
                s = 0
                while (s < len(before) and s < len(after)
                       and before[s] == after[s]
                       and not before[s].isalnum()):
                    s += 1
                ea, eb = len(before), len(after)
                while (ea > s and eb > s
                       and before[ea - 1] == after[eb - 1]
                       and not before[ea - 1].isalnum()):
                    ea -= 1; eb -= 1
                before = before[s:ea]
                after  = after[s:eb]
                a_start += s
                b_start += s
                a_end   = a_start + len(before)
                b_end   = b_start + len(after)
                if not before and not after:
                    continue

            rules.append({
                "type":    kind,
                "before":  before,
                "after":   after,
                "range_a": (a_start, a_end),
                "range_b": (b_start, b_end),
            })

        return rules

    def make_file(  # type: ignore[override]
        self,
        fromlines: Sequence[str],
        tolines: Sequence[str],
        fromdesc: str = "",
        todesc: str = "",
        title: str = "Diff",
        **_kwargs,
    ) -> str:
        """
        Return a complete, self-contained HTML file as a string.

        Parameters
        ----------
        fromlines : list[str]   Lines of the "before" text.
        tolines   : list[str]   Lines of the "after"  text.
        fromdesc  : str         Label shown for the left/from pane.
        todesc    : str         Label shown for the right/to pane.
        title     : str         <title> tag content.
        """
        a = [l.rstrip("\n") for l in fromlines]
        b = [l.rstrip("\n") for l in tolines]
        blocks = self._build_blocks(a, b)

        stats = self._compute_stats(blocks)
        stats_html = self._render_stats(stats)
        file_banner = self._render_file_banner(fromdesc, todesc)
        tabs_html = self._render_tabs()

        side_html = self._render_side_by_side(blocks, a, b)
        overlay_html = self._render_overlay(blocks)
        unified_html = self._render_unified(blocks, a, b)

        return _PAGE_TEMPLATE.format(
            title=html.escape(title),
            css=_MODERN_CSS,
            stats_html=stats_html,
            file_banner=file_banner,
            tabs_html=tabs_html,
            side_by_side=side_html,
            overlay=overlay_html,
            unified=unified_html,
        )

    def make_table(  # type: ignore[override]
        self,
        fromlines: Sequence[str],
        tolines: Sequence[str],
        fromdesc: str = "",
        todesc: str = "",
        **_kwargs,
    ) -> str:
        """Return only the side-by-side diff HTML fragment (no <html> wrapper)."""
        a = [l.rstrip("\n") for l in fromlines]
        b = [l.rstrip("\n") for l in tolines]
        blocks = self._build_blocks(a, b)
        return self._render_side_by_side(blocks, a, b)

    def make_markdown(
        self,
        fromlines: Sequence[str],
        tolines: Sequence[str],
        fromdesc: str = "original",
        todesc: str = "modified",
        include_context: bool = True,
        context_lines: int = 2,
    ) -> str:
        """
        Return a compact Markdown string suitable for sending to an LLM.

        The output lists only meaningful change blocks with a few lines of
        context.  Symbol-only changes are filtered when self.filter_trivial
        is True.

        Parameters
        ----------
        fromlines        : list[str]  Lines of the "before" text.
        tolines          : list[str]  Lines of the "after"  text.
        fromdesc         : str        Label for the original version.
        todesc           : str        Label for the modified version.
        include_context  : bool       Whether to include surrounding context.
        context_lines    : int        Number of context lines per change.
        """
        a = [l.rstrip("\n") for l in fromlines]
        b = [l.rstrip("\n") for l in tolines]
        blocks = self._build_blocks(a, b)

        stats = self._compute_stats(blocks)
        lines: list[str] = []

        lines.append(f"## Diff: `{fromdesc}` → `{todesc}`\n")
        lines.append(
            f"**Summary:** {stats['added']} lines added, "
            f"{stats['deleted']} deleted, "
            f"{stats['changed']} changed "
            f"(trivial-symbol diffs {'filtered' if self.filter_trivial else 'included'}).\n"
        )

        change_blocks = [bl for bl in blocks if bl.tag != "equal"]
        if not change_blocks:
            lines.append("_No meaningful differences found._\n")
            return "\n".join(lines)

        # Group changes into regions with surrounding context, using our own
        # (trivial-filtered) opcodes so symbol-only diffs stay collapsed.
        if include_context:
            opcodes = self._compute_opcodes(a, b)
            grouped = self._group_opcodes(opcodes, context_lines, len(a), len(b))
        else:
            grouped = None

        if grouped is not None:
            for chunk_idx, chunk in enumerate(grouped, 1):
                # find change-region range
                first_op = chunk[0]
                last_op  = chunk[-1]
                a_start = first_op[1] + 1
                b_start = first_op[3] + 1
                a_end   = last_op[2]
                b_end   = last_op[4]
                lines.append(
                    f"### Change {chunk_idx}  "
                    f"— `{fromdesc}` lines {a_start}–{a_end} "
                    f"/ `{todesc}` lines {b_start}–{b_end}\n"
                )
                lines.append("```diff")
                for tag, i1, i2, j1, j2 in chunk:
                    if tag == "equal":
                        for ln in a[i1:i2]:
                            lines.append(f"  {ln}")
                    elif tag in ("replace", "delete"):
                        for ln in a[i1:i2]:
                            lines.append(f"- {ln}")
                        if tag == "replace":
                            for ln in b[j1:j2]:
                                lines.append(f"+ {ln}")
                    elif tag == "insert":
                        for ln in b[j1:j2]:
                            lines.append(f"+ {ln}")
                lines.append("```\n")
        else:
            for bl in change_blocks:
                lines.append(f"### Lines {bl.a_start}+ ({bl.tag})\n")
                lines.append("```diff")
                for ln in bl.a_lines:
                    lines.append(f"- {ln}")
                for ln in bl.b_lines:
                    lines.append(f"+ {ln}")
                lines.append("```\n")

        return "\n".join(lines)

    # ── internal helpers ─────────────────────────────────────────────────────

    @staticmethod
    def _group_opcodes(
        opcodes: list[tuple],
        n: int,
        a_len: int,
        b_len: int,
    ) -> list[list[tuple]]:
        """Group opcodes into change regions with n context lines."""
        groups: list[list[tuple]] = []
        current: list[tuple] = []
        for tag, i1, i2, j1, j2 in opcodes:
            if tag == "equal":
                # Possibly split: keep at most n lines at start/end
                if current:
                    # end of previous region: keep first n lines
                    end_i = min(i1 + n, i2)
                    end_j = j1 + (end_i - i1)
                    current.append(("equal", i1, end_i, j1, end_j))
                    groups.append(current)
                    current = []
                # beginning of next region: keep last n lines
                start_i = max(i2 - n, i1 if not current else i1)
                start_j = j2 - (i2 - start_i)
                if start_i < i2:
                    current = [("equal", start_i, i2, start_j, j2)]
            else:
                current.append((tag, i1, i2, j1, j2))
        if current:
            groups.append(current)
        return groups

    @staticmethod
    def _compute_stats(blocks: list[DiffBlock]) -> dict[str, int]:
        added = deleted = changed = 0
        for bl in blocks:
            if bl.tag == "insert":
                added += len(bl.b_lines)
            elif bl.tag == "delete":
                deleted += len(bl.a_lines)
            elif bl.tag == "replace":
                changed += max(len(bl.a_lines), len(bl.b_lines))
        return {"added": added, "deleted": deleted, "changed": changed}

    @staticmethod
    def _render_stats(stats: dict[str, int]) -> str:
        return (
            '<div class="diff-stats">'
            f'<span class="stat-pill added">＋ {stats["added"]} added</span>'
            f'<span class="stat-pill deleted">－ {stats["deleted"]} deleted</span>'
            f'<span class="stat-pill changed">～ {stats["changed"]} changed</span>'
            "</div>"
        )

    @staticmethod
    def _render_file_banner(fromdesc: str, todesc: str) -> str:
        if not fromdesc and not todesc:
            return ""
        def label(name: str, cls: str) -> str:
            esc = _he(name) if name else "<em>unnamed</em>"
            return (
                f'<div class="file-label {cls}">'
                f'<span class="file-icon">📄</span>'
                f'<span class="file-name">{esc}</span>'
                f"</div>"
            )
        return (
            '<div class="file-banner">'
            + label(fromdesc, "from-label")
            + label(todesc, "to-label")
            + "</div>"
        )

    @staticmethod
    def _render_tabs() -> str:
        tabs = [
            ("side", "Side by side", True),
            ("overlay", "Overlay", False),
            ("unified", "Unified", False),
        ]
        btns = "".join(
            f'<button class="view-tab {"active" if active else ""}" data-view="{v}">{lbl}</button>'
            for v, lbl, active in tabs
        )
        return f'<div class="view-tabs">{btns}</div>'

    # ── side-by-side ─────────────────────────────────────────────────────────

    def _render_side_by_side(
        self,
        blocks: list[DiffBlock],
        a: list[str],
        b: list[str],
    ) -> str:
        rows: list[str] = []
        sep_row = (
            '<tr class="row-sep">'
            '<td colspan="4">· · ·</td>'
            "</tr>"
        )

        prev_was_equal = False
        a_ln = b_ln = 0  # running line counters

        for bl_idx, bl in enumerate(blocks):
            if self.context and bl.tag == "equal":
                # Show only numlines lines at start/end of equal block
                lines = bl.a_lines
                n = self.numlines
                if len(lines) > 2 * n:
                    show = lines[:n] + ["··· skipped ···"] + lines[-n:]
                    skipped = True
                else:
                    show = lines
                    skipped = False
                for i, ln_text in enumerate(show):
                    if ln_text == "··· skipped ···":
                        if skipped:
                            rows.append(sep_row)
                        continue
                    a_ln += 1
                    b_ln += 1
                    rows.append(self._side_row("equal", a_ln, ln_text, b_ln, ln_text))
                continue

            if bl.tag == "equal":
                for ln_text in bl.a_lines:
                    a_ln += 1
                    b_ln += 1
                    rows.append(self._side_row("equal", a_ln, ln_text, b_ln, ln_text))
            elif bl.tag == "insert":
                for ln_text in bl.b_lines:
                    b_ln += 1
                    rows.append(self._side_row("add", None, "", b_ln, ln_text))
            elif bl.tag == "delete":
                for ln_text in bl.a_lines:
                    a_ln += 1
                    rows.append(self._side_row("del", a_ln, ln_text, None, ""))
            elif bl.tag == "replace":
                # Pair up lines for intra-line diff
                pairs = list(
                    zip(
                        bl.a_lines + [""] * max(0, len(bl.b_lines) - len(bl.a_lines)),
                        bl.b_lines + [""] * max(0, len(bl.a_lines) - len(bl.b_lines)),
                    )
                )
                for a_text, b_text in pairs:
                    if a_text:
                        a_ln += 1
                    if b_text:
                        b_ln += 1
                    rows.append(
                        self._side_row_replace(
                            a_ln if a_text else None, a_text,
                            b_ln if b_text else None, b_text,
                        )
                    )

        table = (
            '<table class="diff-table">'
            "<colgroup class='gutter'></colgroup>"
            "<colgroup class='code'></colgroup>"
            "<colgroup class='divider'></colgroup>"
            "<colgroup class='gutter'></colgroup>"
            "<colgroup class='code'></colgroup>"
            "<tbody>"
            + "".join(rows)
            + "</tbody></table>"
        )
        return table

    @staticmethod
    def _side_row(
        kind: str,
        a_ln: int | None,
        a_text: str,
        b_ln: int | None,
        b_text: str,
    ) -> str:
        css = {
            "equal": "row-equal",
            "add": "row-add",
            "del": "row-del",
            "chg": "row-chg",
        }[kind]
        la = str(a_ln) if a_ln else ""
        lb = str(b_ln) if b_ln else ""
        return (
            f'<tr class="{css}">'
            f'<td class="ln">{la}</td>'
            f'<td class="cell-code">{_he(a_text)}</td>'
            f'<td class="divider"></td>'
            f'<td class="ln">{lb}</td>'
            f'<td class="cell-code">{_he(b_text)}</td>'
            "</tr>"
        )

    @staticmethod
    def _side_row_replace(
        a_ln: int | None, a_text: str,
        b_ln: int | None, b_text: str,
    ) -> str:
        ma, mb = _intraline_markup(a_text, b_text)
        la = str(a_ln) if a_ln else ""
        lb = str(b_ln) if b_ln else ""
        return (
            '<tr class="row-chg">'
            f'<td class="ln">{la}</td>'
            f'<td class="cell-code">{ma}</td>'
            f'<td class="divider"></td>'
            f'<td class="ln">{lb}</td>'
            f'<td class="cell-code">{mb}</td>'
            "</tr>"
        )

    # ── overlay ──────────────────────────────────────────────────────────────

    def _render_overlay(self, blocks: list[DiffBlock]) -> str:
        parts: list[str] = ['<div class="overlay-container">']
        a_ln = b_ln = 0

        for bl in blocks:
            if bl.tag == "equal":
                parts.append('<div class="overlay-block block-equal">')
                for ln_text in bl.a_lines:
                    a_ln += 1
                    b_ln += 1
                    parts.append(
                        f'<div class="overlay-line line-eq">'
                        f'<span class="ln">{a_ln}</span>'
                        f'<span class="sig"> </span>'
                        f'<span>{_he(ln_text)}</span>'
                        f"</div>"
                    )
                parts.append("</div>")

            elif bl.tag == "insert":
                parts.append(
                    '<div class="overlay-block block-add">'
                    '<div class="overlay-label">'
                    '<span class="lbl-to">▲ inserted</span>'
                    "</div>"
                )
                for ln_text in bl.b_lines:
                    b_ln += 1
                    parts.append(
                        f'<div class="overlay-line line-to">'
                        f'<span class="ln">{b_ln}</span>'
                        f'<span class="sig">+</span>'
                        f'<span>{_he(ln_text)}</span>'
                        f"</div>"
                    )
                parts.append("</div>")

            elif bl.tag == "delete":
                parts.append(
                    '<div class="overlay-block block-del">'
                    '<div class="overlay-label">'
                    '<span class="lbl-from">▼ removed</span>'
                    "</div>"
                )
                for ln_text in bl.a_lines:
                    a_ln += 1
                    parts.append(
                        f'<div class="overlay-line line-from">'
                        f'<span class="ln">{a_ln}</span>'
                        f'<span class="sig">−</span>'
                        f'<span>{_he(ln_text)}</span>'
                        f"</div>"
                    )
                parts.append("</div>")

            elif bl.tag == "replace":
                parts.append(
                    '<div class="overlay-block block-change">'
                    '<div class="overlay-label">'
                    '<span class="lbl-from">before</span>'
                    '<span style="color:var(--text-muted)">→</span>'
                    '<span class="lbl-to">after</span>'
                    "</div>"
                )
                pairs = list(
                    zip(
                        bl.a_lines + [""] * max(0, len(bl.b_lines) - len(bl.a_lines)),
                        bl.b_lines + [""] * max(0, len(bl.a_lines) - len(bl.b_lines)),
                    )
                )
                for a_text, b_text in pairs:
                    if a_text:
                        a_ln += 1
                        parts.append(
                            f'<div class="overlay-line line-from">'
                            f'<span class="ln">{a_ln}</span>'
                            f'<span class="sig">−</span>'
                            f'<span>{_he(a_text)}</span>'
                            f"</div>"
                        )
                    if b_text:
                        b_ln += 1
                        parts.append(
                            f'<div class="overlay-line line-to">'
                            f'<span class="ln">{b_ln}</span>'
                            f'<span class="sig">+</span>'
                            f'<span>{_he(b_text)}</span>'
                            f"</div>"
                        )
                parts.append("</div>")

        parts.append("</div>")
        return "\n".join(parts)

    # ── unified ──────────────────────────────────────────────────────────────

    def _render_unified(
        self,
        blocks: list[DiffBlock],
        a: list[str],
        b: list[str],
    ) -> str:
        rows: list[str] = []
        a_ln = b_ln = 0

        for bl in blocks:
            if bl.tag == "equal":
                for ln_text in bl.a_lines:
                    a_ln += 1
                    b_ln += 1
                    rows.append(
                        f'<tr class="u-row-eq">'
                        f'<td class="u-ln">{a_ln}</td>'
                        f'<td class="u-ln">{b_ln}</td>'
                        f'<td class="u-sig"> </td>'
                        f'<td class="u-code">{_he(ln_text)}</td>'
                        f"</tr>"
                    )
            elif bl.tag == "delete":
                for ln_text in bl.a_lines:
                    a_ln += 1
                    rows.append(
                        f'<tr class="u-row-del">'
                        f'<td class="u-ln">{a_ln}</td>'
                        f'<td class="u-ln"></td>'
                        f'<td class="u-sig">−</td>'
                        f'<td class="u-code">{_he(ln_text)}</td>'
                        f"</tr>"
                    )
            elif bl.tag == "insert":
                for ln_text in bl.b_lines:
                    b_ln += 1
                    rows.append(
                        f'<tr class="u-row-add">'
                        f'<td class="u-ln"></td>'
                        f'<td class="u-ln">{b_ln}</td>'
                        f'<td class="u-sig">+</td>'
                        f'<td class="u-code">{_he(ln_text)}</td>'
                        f"</tr>"
                    )
            elif bl.tag == "replace":
                for ln_text in bl.a_lines:
                    a_ln += 1
                    rows.append(
                        f'<tr class="u-row-del">'
                        f'<td class="u-ln">{a_ln}</td>'
                        f'<td class="u-ln"></td>'
                        f'<td class="u-sig">−</td>'
                        f'<td class="u-code">{_he(ln_text)}</td>'
                        f"</tr>"
                    )
                for ln_text in bl.b_lines:
                    b_ln += 1
                    rows.append(
                        f'<tr class="u-row-add">'
                        f'<td class="u-ln"></td>'
                        f'<td class="u-ln">{b_ln}</td>'
                        f'<td class="u-sig">+</td>'
                        f'<td class="u-code">{_he(ln_text)}</td>'
                        f"</tr>"
                    )

        return (
            '<table class="unified-table">'
            "<tbody>" + "".join(rows) + "</tbody>"
            "</table>"
        )
