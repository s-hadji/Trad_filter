def ajuster_et_fixer_texte(texte):
    if not texte:
        return ""
    texte_repare = ftfy.fix_text(texte)
    return texte_repare.encode('utf-8', errors='replace').decode('utf-8')

# ==============================================================================
# 1. FUSION EN AMONT PAR DM_CODE
# ==============================================================================
def fusionner_par_dm_code(liste_docs):
    groupes = defaultdict(list)
    for doc in liste_docs:
        info = doc.get("extra_information", {})
        if "DM_code" in info:
            info["DM_code"] = ajuster_et_fixer_texte(info["DM_code"])
        if "DM_title" in info:
            info["DM_title"] = ajuster_et_fixer_texte(info["DM_title"])
            
        code = info.get("DM_code")
        if code:
            groupes[code].append(doc)
            
    docs_fusionnes = []
    for code, docs in groupes.items():
        docs.sort(key=lambda x: x.get("type", ""))
        morceaux_texte = []
        info_commune = {}
        
        for d in docs:
            doc_type = d.get("type")
            if doc_type not in ["XML_procedure", "XML_description"]:
                continue
            
            label = "Procédure" if doc_type == "XML_procedure" else "Description"
            contenu_propre = ajuster_et_fixer_texte(d.get("content", ""))
            morceaux_texte.append(f"[{label}]\n{contenu_propre.strip()}")
            
            if not info_commune:
                info_commune = d.get("extra_information", {})
        
        if morceaux_texte:
            texte_unique = "\n\n".join(morceaux_texte)
            docs_fusionnes.append({
                "type": "XML_fusionne",
                "content": texte_unique,
                "extra_information": info_commune
            })
            
    return docs_fusionnes

