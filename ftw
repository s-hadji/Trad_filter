def drop_identique(avant, apres, liste_symboles=None):
    if liste_symboles is None:
        # Liste des symboles et ponctuations à ignorer
        liste_symboles = [',', '.', ';', ':', '!', '?', '(', ')', '[', ']', '{', '}', '-', '_', '"', "'", '«', '»', '/', '\\', '*']
    
    # Suppression de la casse et de tous les espaces
