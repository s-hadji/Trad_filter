def make_node(name, parent, dm_code=None, feuille=False, titre_complet=None):
    n = Node(name, parent=parent)
    n.dm_code       = dm_code
    n.feuille       = feuille
    n.titre_complet = titre_complet  # Permet de retrouver l'élément exact dans le dictionnaire
    n.patches       = []             
    n.statut        = "BRANCHE"
    return n

def construire_trie(entrees, parent):
    # 1. Gestion des feuilles dont le chemin de tokens est entièrement consommé
    # (Cas des DM_code différents partageant le même titre exact)
    for c, code, t_complet in entrees:
        if not c:
            make_node(f"[{code}]", parent, dm_code=code, feuille=True, titre_complet=t_complet)
            
    # 2. Filtrage pour continuer la construction des branches du Trie
    entrees = [(c, code, t_complet) for c, code, t_complet in entrees if c]
    if not entrees:
        return
        
    groupes = {}
    for c, code, t_complet in entrees:
        groupes.setdefault(c[0].lower(), []).append((c, code, t_complet))
        
    for _, groupe in sorted(groupes.items()):
