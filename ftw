# 4. COLLECTE ET ISOLATION DES AJOUTS/SUPPRESSIONS GLOBALES
# ==============================================================================
def structure_branche_factory():
    return {
        "resume_lignes": [],
        "modifications": defaultdict(set)
    }

def collecter_donnees_condensees(noeud, chemin_actuel="", donnees_par_branche=None, globaux=None):
    if donnees_par_branche is None:
        donnees_par_branche = defaultdict(structure_branche_factory)
    if globaux is None:
        # Accumulateur pour stocker les DM_codes purs ajoutés ou supprimés
        globaux = {"ajoutes": set(), "supprimes": set()}
        
    nom_chemin = f"{chemin_actuel} > {noeud.name}" if chemin_actuel else noeud.name
    
    for (dm_code, type_label), mod in noeud.modules.items():
        identifiant_bloc = f"{dm_code}"
        
        # --- INTERCEPTION ET ISOLATION DES MOUVEMENTS ENTIERS ---
        if mod["status"] == "NOUVEAU":
            globaux["ajoutes"].add(identifiant_bloc)
            continue # Évite d'écrire des lignes de stats inutiles localement
        elif mod["status"] == "SUPPRIME":
            globaux["supprimes"].add(identifiant_bloc)
            continue
            
        # Uniquement pour les modules modifiés
        if mod["lignes_ajoutees"] > 0 or mod["lignes_supprimees"] > 0:
            phrase = f"Module {identifiant_bloc} : {mod['lignes_ajoutees']} ligne(s) ajoutée(s), {mod['lignes_supprimees']} ligne(s) supprimée(s)."
            donnees_par_branche[nom_chemin]["resume_lignes"].append(phrase)
            
        if mod["status"] == "MODIFIE" and mod["transformations_internes"]:
            for mut, categorie in mod["transformations_internes"]:
                donnees_par_branche[nom_chemin]["modifications"][mut].add(identifiant_bloc)
                    
    for enfant in noeud.children.values():
        collecter_donnees_condensees(enfant, nom_chemin, donnees_par_branche, globaux)
        
    return donnees_par_branche, globaux

def generer_batchs_llm(donnees_par_branche, globaux, max_tokens_per_batch=1000):
    batchs = []
    contenu_courant = []
    tokens_courants = 0
    
    consigne_systeme = (
        "ROLE: Analyser les modifications textuelles compactes fournies.\n"
        "==================================================================\n"
    )
    
    for chemin, contenu in donnees_par_branche.items():
        bloc_texte_branche = f"Sous-Branche : {chemin}\n"
        
        if contenu["resume_lignes"]:
            bloc_texte_branche += "  Structure globale :\n"
            for phrase in contenu["resume_lignes"]:
                bloc_texte_branche += f"    - {phrase}\n"
                
        if contenu["modifications"]:
            bloc_texte_branche += "  Modifications en ligne uniques :\n"
            for mut, liste_blocs in contenu["modifications"].items():
                blocs_associes = ", ".join(sorted(list(liste_blocs)))
                bloc_texte_branche += f"    - [Modules: {blocs_associes}] -> {mut}\n"
                
        bloc_texte_branche += "--------------------------------------------------\n"
        tokens_bloc = max(1, len(bloc_texte_branche) // 4)
        
        if tokens_courants + tokens_bloc > max_tokens_per_batch:
            batchs.append(consigne_systeme + "".join(contenu_courant))
            contenu_courant = [bloc_texte_branche]
            tokens_courants = tokens_bloc
        else:
            contenu_courant.append(bloc_texte_branche)
            tokens_courants += tokens_bloc
            
    # --- INJECTION DE LA LIGNE DE SYNTHÈSE UNIQUE À LA FIN ---
    bloc_synthese_final = "==================================================\n"
    if globaux["supprimes"] or globaux["ajoutes"]:
        bloc_synthese_final += "SYNTHÈSE DES MOUVEMENTS DE MODULES ENTIERS :\n"
        if globaux["supprimes"]:
            bloc_synthese_final += f"  - Ces modules ont été supprimés : {', '.join(sorted(list(globaux['supprimes'])))}\n"
        if globaux["ajoutes"]:
            bloc_synthese_final += f"  - Ces modules ont été ajoutés : {', '.join(sorted(list(globaux['ajoutes'])))}\n"
            
    tokens_synthese = len(bloc_synthese_final) // 4
    if tokens_courants + tokens_synthese > max_tokens_per_batch:
        batchs.append(consigne_systeme + "".join(contenu_courant))
        contenu_courant = [bloc_synthese_final]
    else:
        contenu_courant.append(bloc_synthese_final)
        
    if contenu_courant:
        batchs.append(consigne_systeme + "".join(contenu_courant))
        
    return batchs

