#  Rapport condensé : regroupe les changements identiques par DM     #
# ------------------------------------------------------------------ #
def generer_rapport_condense(feuille, **kwargs) -> str:
    """
    feuille : liste de nodes, chacun portant doc_v1, doc_v2 (dicts avec 'content')
    et un code DM.
    kwargs : transmis a detecter_changements (seuil_fusion, skip_characters).
    Renvoie un rapport texte ou chaque changement distinct liste les DM concernes.
    """
    regroupes: Dict[Tuple[str, str, str], Tuple[Changement, List[str]]] = {}

    for node in feuille:
        code_dm = _extraire_code_dm(node)
        v1 = _extraire_contenu(getattr(node, "doc_v1", None))
        v2 = _extraire_contenu(getattr(node, "doc_v2", None))

        if not v1 and not v2:
            continue

        for ch in detecter_changements(v1, v2, **kwargs):
            cle = ch.cle()
            if cle not in regroupes:
                regroupes[cle] = (ch, [])
            _, dms = regroupes[cle]
            if code_dm not in dms:  # deduplication des DM
                dms.append(code_dm)

    lignes = ["RAPPORT DES MODIFICATIONS AUTOMATIQUEMENT CONDENSE", ""]
    for ch, dms in regroupes.values():
        lignes.append(f"- {ch.phrase()} dans le(s) DM : {', '.join(sorted(dms))}")

    return "\n".join(lignes)


