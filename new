import difflib
import re


def diff_unifie(
    v1: str,
    v2: str,
    seuil_fusion: int = 30,
    contexte_mots: int = 20,
    skip_characters: str = " \t\n\r\f\v.,;:!?-_/\\|()[]{}'\"`~^*+=<>&#@$%°",
) -> str:
    """
    Compare deux versions et renvoie une sortie unifiee.

    seuil_fusion    : si deux changements sont separes par une partie commune de
                      moins de seuil_fusion caracteres, tout le bloc est modifie.
    contexte_mots   : nombre de mots de contexte conserves de part et d'autre.
    skip_characters : jeu de caracteres sans valeur metier (blancs, ponctuation,
                      symboles). Un changement dont l'avant ET l'apres ne sont
                      composes QUE de ces caracteres (ou sont vides) est IGNORE :
                      on rend le texte v2 tel quel, comme une partie commune.
    """
    skip = set(skip_characters)
    est_negligeable = lambda t: all(c in skip for c in t)  # vrai aussi si t == ""

    decoupe = lambda t: re.findall(r"\S+|\s+", t)
    a, b = decoupe(v1), decoupe(v2)
    opcodes = difflib.SequenceMatcher(None, a, b).get_opcodes()

    # --- 0. NEUTRALISATION des changements sans valeur metier ---
    # Fait AVANT la fusion : sinon un changement negligeable servirait de pont
    # et ferait fusionner a tort deux vrais changements eloignes.
    nettoyes = []
    for tag, i1, i2, j1, j2 in opcodes:
        if tag != "equal":
            avant, apres = "".join(a[i1:i2]), "".join(b[j1:j2])
            if est_negligeable(avant) and est_negligeable(apres):
                tag = "equal"   # on l'assimile a du commun : il sera rendu tel quel
        nettoyes.append((tag, i1, i2, j1, j2))

    # Recoller les 'equal' devenus consecutifs
    opcodes = []
    for op in nettoyes:
        if opcodes and op[0] == "equal" and opcodes[-1][0] == "equal":
            t, pi1, _, pj1, _ = opcodes[-1]
            opcodes[-1] = ("equal", pi1, op[2], pj1, op[4])
        else:
            opcodes.append(op)

    # --- 1. FUSION : absorber les 'equal' trop courts entre deux changements ---
    fusionnes = []
    for op in opcodes:
        tag, i1, i2, j1, j2 = op
        taille = len("".join(a[i1:i2]))
        est_court = tag == "equal" and taille < seuil_fusion
        entre_deux = bool(fusionnes) and fusionnes[-1][0] != "equal"
        fusionnes.append(("replace", i1, i2, j1, j2) if (est_court and entre_deux) else op)

    compacts = []
    for tag, i1, i2, j1, j2 in fusionnes:
        if compacts and tag != "equal" and compacts[-1][0] != "equal":
            _, pi1, _, pj1, _ = compacts[-1]
            compacts[-1] = ("replace", pi1, i2, pj1, j2)
        else:
            compacts.append((tag, i1, i2, j1, j2))

    # --- 2. RENDU avec elagage du contexte ---
    sortie = []
    for idx, (tag, i1, i2, j1, j2) in enumerate(compacts):
        avant, apres = "".join(a[i1:i2]), "".join(b[j1:j2])

        if tag == "equal":
            # Un 'equal' issu d'un changement neutralise peut differer entre v1 et v2
            # (ex. espacement) : on rend la version v2, qui est la plus recente.
            mots = b[j1:j2] if apres else a[i1:i2]
            debut, fin = idx > 0, idx < len(compacts) - 1
            limite = contexte_mots * 2
            if debut and fin and len(mots) > 2 * limite:
                sortie.append("".join(mots[:limite]) + " [...] " + "".join(mots[-limite:]))
            elif fin and not debut and len(mots) > limite:
                sortie.append("[...] " + "".join(mots[-limite:]))
            elif debut and not fin and len(mots) > limite:
                sortie.append("".join(mots[:limite]) + " [...]")
            else:
                sortie.append("".join(mots))
        elif tag == "replace":
            sortie.append(f"[MODIFIE | avant: {avant.strip()} | apres: {apres.strip()}]")
        elif tag == "delete":
            sortie.append(f"[SUPPRIME | avant: {avant.strip()}]")
        elif tag == "insert":
            sortie.append(f"[AJOUTE | apres: {apres.strip()}]")

    return "".join(sortie)




import difflib
import re


def diff_unifie(v1: str, v2: str) -> str:
    """
    Compare deux versions d'un texte et renvoie une sortie UNIFIEE :
    ce qui est identique est conserve tel quel, ce qui change est marque
    en ligne avec la version v1, la version v2 et le type de modification.

    Types : MODIFIE (remplacement), SUPPRIME (present en v1 seulement),
            AJOUTE (present en v2 seulement).
    """
    # Split intelligent : on decoupe en mots en gardant les separateurs,
    # pour que les blocs marques restent lisibles (pas du caractere a caractere).
    decoupe = lambda t: re.findall(r"\S+|\s+", t)
    a, b = decoupe(v1), decoupe(v2)

    sortie = []
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b).get_opcodes():
        avant, apres = "".join(a[i1:i2]), "".join(b[j1:j2])

        if tag == "equal":
            sortie.append(avant)                       # commun : inchange
        elif tag == "replace":
            sortie.append(f"[MODIFIE | avant: {avant.strip()} | apres: {apres.strip()}]")
        elif tag == "delete":
            sortie.append(f"[SUPPRIME | avant: {avant.strip()}]")
        elif tag == "insert":
            sortie.append(f"[AJOUTE | apres: {apres.strip()}]")

    return "".join(sortie)







"""
==============================================================================
 ETAPE 3 - BOUCLE DE N PASSES (TRI ACP + ACTIONS UNIQUES)
==============================================================================
 Repete le processus : etape 1 (tri ACP) puis etape 2 (actions uniques),
 sur la liste reduite issue de la passe precedente.

   PASSE k :
     1. Embedding des textes courants + tri ACP (n composantes moyennees)
     2. Fenetres fixes + LLM : regroupement par action ("group by action")
     3. Union deterministe de la tracabilite (ids, nodes, DM, chapitres)
     4. Verification de completude (ids et DM codes)
     5. Metriques de passe

 Le re-tri de la passe suivante rapproche ce que les frontieres de fenetre
 avaient separe : c'est ce qui fait converger la condensation.

 Format d'item unique, stable d'une passe a l'autre :
   {texte, ids_origine: set, nodes: set, codes_dm: set, chapitres: set}
==============================================================================
"""

