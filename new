# =================================================================== #
#  Nettoyage du code DMC                                              #
# =================================================================== #
def nettoyer_dmc(code_dm: str) -> str:
    """
    Retire le suffixe repère ' _X' ajoute manuellement.
    'EG-G-05-00A-000A-A _3' -> 'EG-G-05-00A-000A-A'
    """
    return re.sub(r"\s*_\d+\s*$", "", str(code_dm)).strip()


# =================================================================== #
#  ÉTAPE CLÉ : regrouper les resumes par DMC réel                     #
# =================================================================== #
def regrouper_resumes_par_dmc(resumes: Dict[str, "ResumeDM"]) -> Dict[str, List[str]]:
    """
    Plusieurs cles de 'resumes' peuvent designer le MEME vrai DMC (suffixes _1,
    _2...). On les regroupe et on fusionne leurs resumes, en supprimant les
    doublons exacts. Renvoie {dmc_reel: [resumes distincts]}.
    """
    regroupes: Dict[str, List[str]] = {}

    for code, resume_obj in resumes.items():
        dmc = nettoyer_dmc(code)
        texte = resume_obj.resume.strip()

        liste = regroupes.setdefault(dmc, [])
        if texte and texte not in liste:  # anti-doublon exact
            liste.append(texte)

    return regroupes


# =================================================================== #
#  Résultat par feuille                                               #
# =================================================================== #
@dataclass
class FeuilleTrouvee:
    dm_code: str                 # DMC nettoye (unique)
    chemin: List[str]            # noms des nodes, racine -> feuille
    modifications: List[str]     # resumes fusionnes de ce DMC

    def chemin_texte(self) -> str:
        return " > ".join(self.chemin)


# =================================================================== #
#  Descente depuis la racine                                          #
# =================================================================== #
def parcourir_arbre(racine, resumes: Dict[str, "ResumeDM"]) -> Dict[str, FeuilleTrouvee]:
    """
    Regroupe d'abord les resumes par DMC reel, puis descend l'arbre depuis la
    racine. Chaque DMC recherche n'est associe qu'UNE fois a son chemin.
    """
    modifs_par_dmc = regrouper_resumes_par_dmc(resumes)  # {dmc: [modifs]}
    trouvees: Dict[str, FeuilleTrouvee] = {}

    def descendre(node, chemin_courant: List[str]):
        nom = getattr(node, "name", "?")
        chemin = chemin_courant + [nom]

        dmc = nettoyer_dmc(getattr(node, "dm_code", "") or "")
        # On enregistre une seule fois par DMC (le premier node rencontre)
        if dmc and dmc in modifs_par_dmc and dmc not in trouvees:
            trouvees[dmc] = FeuilleTrouvee(
                dm_code=dmc,
                chemin=chemin,
                modifications=modifs_par_dmc[dmc],
            )

        for enfant in getattr(node, "children", []) or []:
            descendre(enfant, chemin)

    descendre(racine, [])
    return trouvees


# =================================================================== #
#  Affichage                                                          #
# =================================================================== #
def afficher_feuilles(feuilles_trouvees: Dict[str, FeuilleTrouvee]) -> None:
    """Affiche chaque DMC une seule fois : son chemin et ses modifications."""
    for feuille in feuilles_trouvees.values():
        print(f"\n{'=' * 70}")
        print(f"DMC    : {feuille.dm_code}")
        print(f"Chemin : {feuille.chemin_texte()}")
        print("Modifications :")
        for i, modif in enumerate(feuille.modifications, 1):
            prefixe = f"  {i}. " if len(feuille.modifications) > 1 else "  "
            for j, ligne in enumerate(modif.splitlines() or [modif]):
                print(f"{prefixe if j == 0 else '     '}{ligne}")


