def analyser_par_lots(rapport: RapportFinal, taille_lot: int = 10) -> Dict[int, dict]:
    """
    Envoie les modifications au LLM par lots. Accumule les patterns : un pattern
    vu au lot 1 est reinjecte pour etre reutilise au lot 10.
    Renvoie {pattern_id: {description, modifications, ensembles}} avec tracabilite.
    """
    llm = ChatOpenAI(model="gpt-4o", temperature=0.1, max_tokens=4000)
    chaine = PROMPT | llm.with_structured_output(SortieLLM)

    # Table pour retrouver l'ensemble_id de chaque modification
    ensemble_de_modif = {m.id: m.ensemble_id for m in rapport.modifications}

    patterns: Dict[int, dict] = {}   # memoire cumulative
    mods = rapport.modifications
    nb_lots = (len(mods) + taille_lot - 1) // taille_lot

    for numero, debut in enumerate(range(0, len(mods), taille_lot), 1):
        lot = mods[debut: debut + taille_lot]
        print(f"[LLM] Lot {numero}/{nb_lots} ({len(lot)} modifs)")

        sortie = chaine.invoke({
            "lot": _formater_lot(lot),
            "patterns_connus": _formater_patterns_connus(patterns),
        })

        # Fusion dans la memoire cumulative + tracabilite des ensembles
        for p in sortie.patterns:
            entree = patterns.setdefault(
                p.id, {"description": p.description, "modifications": set(), "ensembles": set()}
            )
            # On garde la description (celle du 1er lot fait foi pour la coherence)
            for modif_id in p.modifications_couvertes:
                entree["modifications"].add(modif_id)
                if modif_id in ensemble_de_modif:
                    entree["ensembles"].add(ensemble_de_modif[modif_id])

    return patterns


