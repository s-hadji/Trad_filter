# ==============================================================================
# 3. ETAPE 0 - INDEXATION A PLAT
# ==============================================================================

def indexer_modifications(dictio: Dict[Any, Any]) -> List[Dict[str, Any]]:
    """dictio -> liste d'items (une entree par description, tracabilite complete)."""
    items: List[Dict[str, Any]] = []
    compteur = 0
    for node, fiche in dictio.items():
        for section in fiche.sections:
            for description in section.modifications_apportees.descriptions:
                if not description or not description.strip():
                    continue
                items.append({
                    "texte": description.strip(),
                    "ids_origine": {compteur},
                    "nodes": {node},
                    "codes_dm": set(section.codes_dm),
                    "chapitres": {section.chapitre},
                })
                compteur += 1
    return items


# ==============================================================================
# 4. ETAPE 1 - TRI ACP
# ==============================================================================

def trier_par_acp(
    items: List[Dict[str, Any]],
    embeddings,
    n_composantes: int = 3,
) -> List[Dict[str, Any]]:
    """Embedding + score 1D (moyenne ponderee des projections ACP) + tri."""
    n = len(items)
    if n <= 1:
        return items

    X = np.array(embeddings.embed_documents([it["texte"] for it in items]))
    X_norm = normalize(X)

    k = max(1, min(n_composantes, n - 1, X_norm.shape[1]))
    pca = PCA(n_components=k)
    projections = pca.fit_transform(X_norm)

    if k > 1:
        poids = pca.explained_variance_ratio_
        scores = projections @ (poids / poids.sum())
    else:
        scores = projections[:, 0]
    scores = scores.flatten()

    ordre = np.argsort(scores)
    assert sorted(ordre.tolist()) == list(range(n)), "Tri : permutation invalide."

    variance = float(pca.explained_variance_ratio_.sum())
    print(f"    tri ACP : {k} composante(s), variance expliquee cumulee = {variance:.1%}")
    return [items[i] for i in ordre]


# ==============================================================================
# 5. ETAPE 2 - ACTIONS UNIQUES PAR FENETRES FIXES
# ==============================================================================

def _reparer_actions(
    actions_llm: List[ActionUnique],
    ids_fenetre: List[int],
    textes_par_id: Dict[int, str],
) -> List[ActionUnique]:
    """
    Garantit la partition exacte des ids de la fenetre :
      - id invente         -> retire ;
      - id en double       -> garde dans sa premiere action ;
      - id oublie          -> reinjecte en action solo (texte d'origine) ;
      - action a 1 seul id -> texte FORCE a l'original (anti-reformulation).
    """
    attendus = set(ids_fenetre)
    vus: set = set()
    propres: List[ActionUnique] = []

    for action in actions_llm:
        ids = [i for i in action.ids_sources if i in attendus and i not in vus]
        vus.update(ids)
        if not ids:
            continue
        if len(ids) == 1:
            propres.append(ActionUnique(texte=textes_par_id[ids[0]], ids_sources=ids))
        else:
            propres.append(ActionUnique(texte=action.texte, ids_sources=sorted(ids)))

    for i in sorted(attendus - vus):
        propres.append(ActionUnique(texte=textes_par_id[i], ids_sources=[i]))

    return propres


def regrouper_en_actions(
    items_tries: List[Dict[str, Any]],
    chaine,
    taille_fenetre: int = 30,
) -> List[Dict[str, Any]]:
    """Fenetres fixes sur la liste triee ; le LLM regroupe par action ; union par le code."""
    n = len(items_tries)
    if n <= 1:
        return items_tries

    # Indices locaux presentes au LLM (positions dans la liste triee)
    resultat: List[Dict[str, Any]] = []
    nb_fenetres = (n + taille_fenetre - 1) // taille_fenetre

    for num, debut in enumerate(range(0, n, taille_fenetre), start=1):
        positions = list(range(debut, min(debut + taille_fenetre, n)))

        if len(positions) == 1:
            resultat.append(items_tries[positions[0]])
            continue

        textes_par_id = {p: items_tries[p]["texte"] for p in positions}
        input_data = "\n".join(f"[ID {p}] : {items_tries[p]['texte']}" for p in positions)

        try:
            rapport = chaine.invoke({"input_data": input_data})
            actions = _reparer_actions(rapport.actions_uniques, positions, textes_par_id)
        except Exception as e:
            print(f"    fenetre {num}/{nb_fenetres} : echec LLM ({e}), items conserves tels quels.")
            actions = [ActionUnique(texte=textes_par_id[p], ids_sources=[p]) for p in positions]

        # Union deterministe de la tracabilite : c'est le CODE qui unit.
        for action in actions:
            sources = [items_tries[p] for p in action.ids_sources]
            resultat.append({
                "texte": action.texte,
                "ids_origine": set().union(*(s["ids_origine"] for s in sources)),
                "nodes": set().union(*(s["nodes"] for s in sources)),
                "codes_dm": set().union(*(s["codes_dm"] for s in sources)),
                "chapitres": set().union(*(s["chapitres"] for s in sources)),
            })

    return resultat


# ==============================================================================
# 6. COMPLETUDE ET METRIQUES
# ==============================================================================

def verifier_completude(
    items: List[Dict[str, Any]],
    ids_attendus: set,
    dm_attendus: set,
    etiquette: str,
) -> None:
    """Chaque description d'origine ET chaque DM code doivent rester presents."""
    ids = set().union(*(it["ids_origine"] for it in items)) if items else set()
    dms = set().union(*(it["codes_dm"] for it in items)) if items else set()

    manquants_ids = ids_attendus - ids
    manquants_dm = dm_attendus - dms
    assert not manquants_ids, f"[{etiquette}] descriptions manquantes : {sorted(manquants_ids)}"
    assert not manquants_dm, f"[{etiquette}] DM codes manquants : {sorted(manquants_dm)}"

    # Une description ne doit pas se retrouver dans deux actions.
    compte = Counter(i for it in items for i in it["ids_origine"])
    doublons = [i for i, c in compte.items() if c > 1]
    assert not doublons, f"[{etiquette}] descriptions dupliquees : {sorted(doublons)}"

    print(f"    completude [{etiquette}] : {len(items)} actions, "
          f"{len(ids)}/{len(ids_attendus)} descriptions, {len(dms)}/{len(dm_attendus)} DM codes.")


def calculer_metriques(items: List[Dict[str, Any]]) -> Dict[str, Any]:
    """
    Metriques de condensation et index inverse DM -> actions.
    Repere les DM cites dans PLUSIEURS actions uniques distinctes.
    """
    dm_vers_actions: Dict[str, List[int]] = defaultdict(list)
    for idx, it in enumerate(items):
        for dm in it["codes_dm"]:
            dm_vers_actions[dm].append(idx)

    dm_multi = {dm: idxs for dm, idxs in dm_vers_actions.items() if len(idxs) > 1}
    tailles = [len(it["ids_origine"]) for it in items]

    return {
        "nb_actions": len(items),
        "nb_descriptions": sum(tailles),
        "nb_dm_cites": len(dm_vers_actions),
        "nb_dm_multi_actions": len(dm_multi),
        "taille_action_max": max(tailles) if tailles else 0,
        "taille_action_moyenne": (sum(tailles) / len(tailles)) if tailles else 0.0,
        "dm_vers_actions": dict(dm_vers_actions),
        "dm_multi_actions": dm_multi,
    }


def afficher_metriques(
    items: List[Dict[str, Any]],
    metriques: Dict[str, Any],
    top_dm: int = 10,
    largeur_texte: int = 90,
) -> None:
    """Affiche les metriques et, pour les DM presents dans plusieurs actions, lesquelles."""
    print("\n" + "=" * 78)
    print("METRIQUES DE CONDENSATION")
    print("=" * 78)
    print(f"  actions uniques          : {metriques['nb_actions']}")
    print(f"  descriptions d'origine   : {metriques['nb_descriptions']}")
    print(f"  DM codes cites           : {metriques['nb_dm_cites']}")
    print(f"  taille moyenne d'action  : {metriques['taille_action_moyenne']:.2f} descriptions")
    print(f"  plus grosse action       : {metriques['taille_action_max']} descriptions")

    dm_multi = metriques["dm_multi_actions"]
    print(f"\n  DM codes presents dans PLUSIEURS actions uniques : {len(dm_multi)}")

    if not dm_multi:
        print("  (aucun DM ne se repartit sur plusieurs actions)")
        print("=" * 78 + "\n")
        return

    classes = sorted(dm_multi.items(), key=lambda kv: len(kv[1]), reverse=True)
    print(f"  detail des {min(top_dm, len(classes))} DM les plus disperses "
          f"(quel DM contient quelles modifications) :\n")

    for dm, idxs in classes[:top_dm]:
        print(f"  - {dm}  ({len(idxs)} actions)")
        for i in idxs:
            texte = items[i]["texte"]
            if len(texte) > largeur_texte:
                texte = texte[:largeur_texte - 3] + "..."
            print(f"      [action {i}] {texte}")
        print()

    if len(classes) > top_dm:
        print(f"  ... et {len(classes) - top_dm} autres DM disperses "
              f"(voir metriques['dm_multi_actions']).")
    print("=" * 78 + "\n")


# ==============================================================================
# 7. PIPELINE : N PASSES
# ==============================================================================

def executer_passes(
    dictio: Dict[Any, Any],
    llm,
    embeddings,
    n_passes: int = 3,
    taille_fenetre: int = 30,
    n_composantes: int = 3,
) -> Tuple[List[Dict[str, Any]], Dict[str, Any]]:
    """
    Repete n_passes fois : tri ACP (etape 1) puis actions uniques (etape 2).
    Verifie la completude a chaque passe et retourne (actions, metriques).

    dictio         : sortie V1, dict {node: FicheVersionGlobale}
    llm            : instance ChatOpenAI deja initialisee
    embeddings     : instance OpenAIEmbeddings deja initialisee
    n_passes       : nombre maximal de passes (arret anticipe si stabilite)
    taille_fenetre : nombre d'elements montres au LLM par fenetre
    n_composantes  : directions principales moyennees pour le tri
    """
    chaine = PROMPT_ACTIONS_UNIQUES | llm.with_structured_output(RapportActions)

    # ---- Indexation -----------------------------------------------------
    items = indexer_modifications(dictio)
    if not items:
        print("Aucune description a traiter.")
        return [], {}

    ids_attendus = set().union(*(it["ids_origine"] for it in items))
    dm_attendus = set().union(*(it["codes_dm"] for it in items))
    print(f"Indexation : {len(items)} modifications, {len(dm_attendus)} DM codes distincts.")
    verifier_completude(items, ids_attendus, dm_attendus, "indexation")

    # ---- Passes ---------------------------------------------------------
    for passe in range(1, n_passes + 1):
        nb_avant = len(items)
        if nb_avant <= 1:
            print(f"\nPasse {passe} : un seul element, arret.")
            break

        print(f"\nPasse {passe}/{n_passes} : {nb_avant} elements en entree.")
        items_tries = trier_par_acp(items, embeddings, n_composantes)
        items = regrouper_en_actions(items_tries, chaine, taille_fenetre)
        verifier_completude(items, ids_attendus, dm_attendus, f"passe {passe}")
        print(f"    resultat : {nb_avant} -> {len(items)} actions "
              f"(reduction {100 * (nb_avant - len(items)) / nb_avant:.1f}%).")

        if len(items) == nb_avant:
            print("    stabilite atteinte, arret anticipe.")
            break

    # ---- Metriques finales ----------------------------------------------
    metriques = calculer_metriques(items)
    afficher_metriques(items, metriques)

    print(f"Condensation terminee : {len(ids_attendus)} modifications -> "
          f"{len(items)} actions uniques. "
          f"{metriques['nb_dm_cites']}/{len(dm_attendus)} DM codes cites.")
    return items, metriques


