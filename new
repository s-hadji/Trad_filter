# 4. ETAPE 1 - TRI ACP
# ==============================================================================

def trier_par_plus_proche_voisin(
    items: List[Dict[str, Any]],
    embeddings,
    depart_excentre: bool = True,
) -> List[Dict[str, Any]]:
    """
    Trie les items en construisant une CHAINE DE PLUS PROCHES VOISINS
    (parcours glouton) : chaque element est suivi de celui qui lui est le plus
    proche parmi ceux qui restent, au sens de la distance cosinus.

    Pourquoi ce tri plutot qu'une ACP : l'ACP projette sur un axe global, donc deux
    textes tres proches peuvent se retrouver eloignes si l'axe principal ne capture
    pas leur ressemblance. Le plus proche voisin rend les similaires STRUCTURELLEMENT
    ADJACENTS, ce qui est exactement ce dont les fenetres ont besoin.

    depart_excentre : demarre au point le plus eloigne du centroide plutot qu'a
    l'index 0. Le resultat ne depend alors plus de l'ordre d'entree (reproductible).
    """
    n = len(items)
    if n <= 1:
        return items

    X = np.array(embeddings.embed_documents([it["texte"] for it in items]))
    X_norm = normalize(X)  # L2 : distance cosinus = 1 - produit scalaire

    # Point de depart : le plus excentre (stable), ou l'index 0 (comportement simple)
    if depart_excentre:
        centroide = normalize(X_norm.mean(axis=0, keepdims=True))[0]
        courant = int(np.argmin(X_norm @ centroide))  # le moins similaire au centre
    else:
        courant = 0

    ordre = [courant]
    restants = np.ones(n, dtype=bool)
    restants[courant] = False

    for _ in range(n - 1):
        indices_restants = np.flatnonzero(restants)
        # Vecteurs L2-normalises : similarite cosinus = produit scalaire.
        similarites = X_norm[indices_restants] @ X_norm[courant]
        suivant = int(indices_restants[np.argmax(similarites)])  # distance min
        ordre.append(suivant)
        restants[suivant] = False
        courant = suivant

    assert sorted(ordre) == list(range(n)), "Tri : permutation invalide."
    print(f"    tri plus proche voisin : chaine de {n} elements construite.")
    return [items[i] for i in ordre]


# ==============================================================================
# 5. ETAPE 2 - ACTIONS UNIQUES PAR FENETRES FIXES
# ==============================================================================

def _nettoyer_references_ids(texte: str) -> str:
    """
    Filet de securite : retire toute reference aux identifiants internes que le LLM
    aurait pu recopier malgre la consigne ('[ID 3]', 'ID 3', '(ids 3, 7)', ...).
    Les [ID] sont nos reperes de tracabilite, jamais du contenu documentaire.
    """
    if not texte:
        return texte

    nettoye = texte
    # '[ID 3]' ou '[ID 3, 7]'
    nettoye = re.sub(r"\[\s*ID[Ss]?\s*[:\s]?\s*[\d\s,et&]+\]", "", nettoye, flags=re.IGNORECASE)
    # '(ID 3)' / '(ids 3, 7)' / '(id : 3)'
    nettoye = re.sub(r"\(\s*ID[Ss]?\s*[:\s]?\s*[\d\s,et&]+\)", "", nettoye, flags=re.IGNORECASE)
    # 'ID 3' / 'IDs 3, 7' hors parentheses
    nettoye = re.sub(r"\bID[Ss]?\s*[:\s]?\s*\d+(?:\s*(?:,|et|&)\s*\d+)*", "", nettoye,
                     flags=re.IGNORECASE)
    # Espaces et ponctuation orphelins laisses par la suppression
    nettoye = re.sub(r"\s{2,}", " ", nettoye)
    nettoye = re.sub(r"\s+([,.;:])", r"\1", nettoye)
    nettoye = re.sub(r"\(\s*\)", "", nettoye)
    nettoye = re.sub(r"^[\s,;:-]+", "", nettoye)

    return nettoye.strip()


def calculer_taille_fenetre(
    n_items: int,
    nb_fenetres_cible: int = 12,
    fenetre_min: int = 10,
    fenetre_max: int = 60,
) -> int:
    """
    Adapte la taille de fenetre a la taille COURANTE de la liste.

    A mesure que les passes condensent, la liste retrecit. Garder une taille fixe
    finit par produire des fenetres trop etroites pour que les actions similaires
    encore separees puissent se rencontrer. On veut donc l'effet inverse : quand la
    liste diminue, la fenetre doit S'ELARGIR (relativement), quitte a ne faire qu'une
    ou deux fenetres a la fin.

    Regle :
      - si tout tient sous le plafond, UNE seule fenetre (fusion maximale possible) ;
      - sinon, on vise nb_fenetres_cible fenetres, borne par [fenetre_min, fenetre_max].

    fenetre_max protege le contexte et l'attention du LLM : au dela, la qualite du
    regroupement se degrade.
    """
    if n_items <= fenetre_max:
        return n_items  # une seule fenetre : tous les elements se voient

    taille = (n_items + nb_fenetres_cible - 1) // nb_fenetres_cible  # ceil
    return max(fenetre_min, min(taille, fenetre_max))


def _reparer_actions(
    actions_llm: List[ActionUnique],
    ids_fenetre: List[int],
    textes_par_id: Dict[int, str],
) -> List[ActionUnique]:
    """
    Garantit la partition exacte des ids de la fenetre :
      - id invente         -> retire ;
      - id en double       -> garde dans sa premiere action ;
      - id oublie          -> reinjecte en action solo (texte d'origine) ;
      - action a 1 seul id -> texte FORCE a l'original (anti-reformulation).
    """
    attendus = set(ids_fenetre)
    vus: set = set()
    propres: List[ActionUnique] = []

    for action in actions_llm:
        ids = [i for i in action.ids_sources if i in attendus and i not in vus]
        vus.update(ids)
        if not ids:
            continue
        if len(ids) == 1:
            propres.append(ActionUnique(texte=textes_par_id[ids[0]], ids_sources=ids))
        else:
            # Texte englobant produit par le LLM : on retire toute reference aux [ID].
            propres.append(ActionUnique(texte=_nettoyer_references_ids(action.texte),
                                        ids_sources=sorted(ids)))

    for i in sorted(attendus - vus):
        propres.append(ActionUnique(texte=textes_par_id[i], ids_sources=[i]))

    return propres


def regrouper_en_actions(
    items_tries: List[Dict[str, Any]],
    chaine_analyse,
    chaine_reduction,
    taille_fenetre: int,
    verbeux: bool = True,
) -> List[Dict[str, Any]]:
    """
    Fenetres fixes sur la liste triee. Pour chaque fenetre, DEUX appels LLM :
      1. ANALYSE  : trouver les motifs communs et les modifications isolees.
      2. REDUCTION: appliquer cette analyse pour produire les actions uniques.
    L'union de la tracabilite est faite par le CODE.
    """
    n = len(items_tries)
    if n <= 1:
        return items_tries

    resultat: List[Dict[str, Any]] = []
    nb_fenetres = (n + taille_fenetre - 1) // taille_fenetre

    for num, debut in enumerate(range(0, n, taille_fenetre), start=1):
        positions = list(range(debut, min(debut + taille_fenetre, n)))

        if len(positions) == 1:
            resultat.append(items_tries[positions[0]])
            continue

        textes_par_id = {p: items_tries[p]["texte"] for p in positions}
        input_data = "\n".join(f"[ID {p}] : {items_tries[p]['texte']}" for p in positions)

        try:
            # --- APPEL 1 : analyse pure (aucun regroupement, aucun ID) ---
            analyse = chaine_analyse.invoke({"input_data": input_data})
            motifs = analyse.motifs_communs or ["(aucun motif commun identifie)"]
            isolees = analyse.modifications_isolees or ["(aucune)"]

            if verbeux:
                print(f"    fenetre {num}/{nb_fenetres} : {len(positions)} modifs, "
                      f"{len(analyse.motifs_communs)} motif(s), "
                      f"{len(analyse.modifications_isolees)} isolee(s)")
                for motif in analyse.motifs_communs:
                    apercu = motif if len(motif) <= 100 else motif[:97] + "..."
                    print(f"        motif : {apercu}")

            # --- APPEL 2 : reduction guidee par l'analyse ---
            rapport = chaine_reduction.invoke({
                "motifs": "\n".join(f"- {m}" for m in motifs),
                "isolees": "\n".join(f"- {i}" for i in isolees),
                "input_data": input_data,
            })
            actions = _reparer_actions(rapport.actions_uniques, positions, textes_par_id)

        except Exception as e:
            print(f"    fenetre {num}/{nb_fenetres} : echec LLM ({e}), items conserves tels quels.")
            actions = [ActionUnique(texte=textes_par_id[p], ids_sources=[p]) for p in positions]

        # Union deterministe de la tracabilite : c'est le CODE qui unit.
        for action in actions:
            sources = [items_tries[p] for p in action.ids_sources]
            resultat.append({
                "texte": action.texte,
                "ids_origine": set().union(*(s["ids_origine"] for s in sources)),
                "nodes": set().union(*(s["nodes"] for s in sources)),
                "codes_dm": set().union(*(s["codes_dm"] for s in sources)),
                "chapitres": set().union(*(s["chapitres"] for s in sources)),
            })

    return resultat


# ==============================================================================
# 6. COMPLETUDE ET METRIQUES
# ==============================================================================

def verifier_completude(
    items: List[Dict[str, Any]],
    ids_attendus: set,
    dm_attendus: set,
    etiquette: str,
) -> None:
    """Chaque description d'origine ET chaque DM code doivent rester presents."""
    ids = set().union(*(it["ids_origine"] for it in items)) if items else set()
    dms = set().union(*(it["codes_dm"] for it in items)) if items else set()

    manquants_ids = ids_attendus - ids
    manquants_dm = dm_attendus - dms
    assert not manquants_ids, f"[{etiquette}] descriptions manquantes : {sorted(manquants_ids)}"
    assert not manquants_dm, f"[{etiquette}] DM codes manquants : {sorted(manquants_dm)}"

    # Une description ne doit pas se retrouver dans deux actions.
    compte = Counter(i for it in items for i in it["ids_origine"])
    doublons = [i for i, c in compte.items() if c > 1]
    assert not doublons, f"[{etiquette}] descriptions dupliquees : {sorted(doublons)}"

    print(f"    completude [{etiquette}] : {len(items)} actions, "
          f"{len(ids)}/{len(ids_attendus)} descriptions, {len(dms)}/{len(dm_attendus)} DM codes.")


def calculer_metriques(items: List[Dict[str, Any]]) -> Dict[str, Any]:
    """
    Metriques de condensation et index inverse DM -> actions.
    Repere les DM cites dans PLUSIEURS actions uniques distinctes.
    """
    dm_vers_actions: Dict[str, List[int]] = defaultdict(list)
    for idx, it in enumerate(items):
        for dm in it["codes_dm"]:
            dm_vers_actions[dm].append(idx)

    dm_multi = {dm: idxs for dm, idxs in dm_vers_actions.items() if len(idxs) > 1}
    tailles = [len(it["ids_origine"]) for it in items]
    nb_solitaires = sum(1 for t in tailles if t == 1)

    return {
        "nb_actions": len(items),
        "nb_descriptions": sum(tailles),
        "nb_dm_cites": len(dm_vers_actions),
        "nb_dm_multi_actions": len(dm_multi),
        "nb_actions_solitaires": nb_solitaires,
        "taux_solitaires": (nb_solitaires / len(items)) if items else 0.0,
        "taille_action_max": max(tailles) if tailles else 0,
        "taille_action_moyenne": (sum(tailles) / len(tailles)) if tailles else 0.0,
        "dm_vers_actions": dict(dm_vers_actions),
        "dm_multi_actions": dm_multi,
    }


def afficher_metriques(
    items: List[Dict[str, Any]],
    metriques: Dict[str, Any],
    top_dm: int = 10,
    largeur_texte: int = 90,
) -> None:
    """Affiche les metriques et, pour les DM presents dans plusieurs actions, lesquelles."""
    print("\n" + "=" * 78)
    print("METRIQUES DE CONDENSATION")
    print("=" * 78)
    print(f"  actions uniques          : {metriques['nb_actions']}")
    print(f"  descriptions d'origine   : {metriques['nb_descriptions']}")
    print(f"  taux de condensation     : "
          f"{100 * (1 - metriques['nb_actions'] / max(1, metriques['nb_descriptions'])):.1f}%")
    print(f"  DM codes cites           : {metriques['nb_dm_cites']}")
    print(f"  taille moyenne d'action  : {metriques['taille_action_moyenne']:.2f} descriptions")
    print(f"  plus grosse action       : {metriques['taille_action_max']} descriptions")
    print(f"  actions solitaires       : {metriques['nb_actions_solitaires']} "
          f"({100 * metriques['taux_solitaires']:.1f}%)")
    if metriques["taux_solitaires"] > 0.5:
        print("    -> taux eleve : des motifs transversaux n'ont probablement pas ete detectes "
              "(elargir la fenetre ou augmenter n_passes).")

    dm_multi = metriques["dm_multi_actions"]
    print(f"\n  DM codes presents dans PLUSIEURS actions uniques : {len(dm_multi)}")

    if not dm_multi:
        print("  (aucun DM ne se repartit sur plusieurs actions)")
        print("=" * 78 + "\n")
        return

    classes = sorted(dm_multi.items(), key=lambda kv: len(kv[1]), reverse=True)
    print(f"  detail des {min(top_dm, len(classes))} DM les plus disperses "
          f"(quel DM contient quelles modifications) :\n")

    for dm, idxs in classes[:top_dm]:
        print(f"  - {dm}  ({len(idxs)} actions)")
        for i in idxs:
            texte = items[i]["texte"]
            if len(texte) > largeur_texte:
                texte = texte[:largeur_texte - 3] + "..."
            print(f"      [action {i}] {texte}")
        print()

    if len(classes) > top_dm:
        print(f"  ... et {len(classes) - top_dm} autres DM disperses "
              f"(voir metriques['dm_multi_actions']).")
    print("=" * 78 + "\n")


# ==============================================================================
# 7. PIPELINE : N PASSES
# ==============================================================================

def executer_passes(
    dictio: Dict[Any, Any],
    llm,
    embeddings,
    n_passes: int = 3,
    nb_fenetres_cible: int = 12,
    fenetre_min: int = 10,
    fenetre_max: int = 60,
    depart_excentre: bool = True,
) -> Tuple[List[Dict[str, Any]], Dict[str, Any]]:
    """
    Repete n_passes fois : tri par plus proche voisin (etape 1) puis actions
    uniques (etape 2). Verifie la completude a chaque passe.

    Le tri par plus proche voisin construit une chaine ou chaque element est suivi
    de son voisin le plus proche : les modifications similaires deviennent adjacentes,
    donc tombent dans la meme fenetre.

    La taille de fenetre est ADAPTATIVE : recalculee a chaque passe en fonction du
    nombre d'elements restants, pour viser nb_fenetres_cible fenetres. A mesure que
    la liste se condense, la fenetre s'elargit, ce qui permet aux actions similaires
    encore separees de se rencontrer.

    dictio            : sortie V1, dict {node: FicheVersionGlobale}
    llm               : instance ChatOpenAI deja initialisee
    embeddings        : instance OpenAIEmbeddings deja initialisee
    n_passes          : nombre maximal de passes (arret anticipe si stabilite)
    nb_fenetres_cible : nombre de fenetres vise a chaque passe
    fenetre_min       : taille plancher d'une fenetre
    fenetre_max       : taille plafond (protege le contexte du LLM)
    depart_excentre   : demarre la chaine au point le plus eloigne du centroide
                        (tri reproductible, independant de l'ordre d'entree)
    """
    chaine_analyse = PROMPT_ANALYSE | llm.with_structured_output(AnalyseLot)
    chaine_reduction = PROMPT_REDUCTION | llm.with_structured_output(RapportActions)

    # ---- Indexation -----------------------------------------------------
    items = indexer_modifications(dictio)
    if not items:
        print("Aucune description a traiter.")
        return [], {}

    ids_attendus = set().union(*(it["ids_origine"] for it in items))
    dm_attendus = set().union(*(it["codes_dm"] for it in items))
    print(f"Indexation : {len(items)} modifications, {len(dm_attendus)} DM codes distincts.")
    verifier_completude(items, ids_attendus, dm_attendus, "indexation")

    # ---- Passes ---------------------------------------------------------
    for passe in range(1, n_passes + 1):
        nb_avant = len(items)
        if nb_avant <= 1:
            print(f"\nPasse {passe} : un seul element, arret.")
            break

        taille_fenetre = calculer_taille_fenetre(
            nb_avant, nb_fenetres_cible, fenetre_min, fenetre_max
        )
        nb_fenetres = (nb_avant + taille_fenetre - 1) // taille_fenetre
        print(f"\nPasse {passe}/{n_passes} : {nb_avant} elements en entree, "
              f"fenetre adaptative = {taille_fenetre} ({nb_fenetres} fenetre(s)).")

        items_tries = trier_par_plus_proche_voisin(items, embeddings, depart_excentre)
        items = regrouper_en_actions(items_tries, chaine_analyse, chaine_reduction, taille_fenetre)
        verifier_completude(items, ids_attendus, dm_attendus, f"passe {passe}")
        print(f"    resultat : {nb_avant} -> {len(items)} actions "
              f"(reduction {100 * (nb_avant - len(items)) / nb_avant:.1f}%).")

        if len(items) == nb_avant:
            print("    stabilite atteinte, arret anticipe.")
            break

    # ---- Metriques finales ----------------------------------------------
    metriques = calculer_metriques(items)
    afficher_metriques(items, metriques)

    print(f"Condensation terminee : {len(ids_attendus)} modifications -> "
          f"{len(items)} actions uniques. "
          f"{metriques['nb_dm_cites']}/{len(dm_attendus)} DM codes cites.")
    return items, metriques


