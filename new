"""
==============================================================================
 ÉTAPE 1 — LISTER, TRIER (ACP n composantes), TRACKER
==============================================================================
 Entrée : dictio (V1), dict {node: FicheVersionGlobale}
          + instance embeddings DÉJÀ initialisée.
 Sortie : liste TRIÉE de toutes les modifications, chaque élément portant sa
          traçabilité complète (id, node, codes DM, chapitre) + son score de tri.
==============================================================================
"""

from typing import List, Dict, Any
import numpy as np
from sklearn.decomposition import PCA
from sklearn.preprocessing import normalize


def lister_et_trier_modifications(
    dictio: Dict[Any, Any],
    embeddings,
    n_composantes: int = 3,
) -> List[Dict[str, Any]]:
    """
    1. Liste à plat TOUTES les descriptions de dictio (une entrée par description).
    2. Embedding + ACP : score 1D = moyenne des projections sur les n premières
       composantes principales, pondérée par la variance expliquée de chaque axe.
    3. Tri selon ce score, traçabilité conservée.

    Retourne la liste triée : [{id, texte, node, codes_dm, chapitre, score}]
    """
    # ---- 1. Listing à plat, id de traçabilité ------------------------------
    modifications: List[Dict[str, Any]] = []
    id_compteur = 0
    for node, fiche in dictio.items():
        for section in fiche.sections:
            for description in section.modifications_apportees.descriptions:
                if not description or not description.strip():
                    continue
                modifications.append({
                    "id": id_compteur,
                    "texte": description.strip(),
                    "node": node,
                    "codes_dm": list(section.codes_dm),
                    "chapitre": section.chapitre,
                })
                id_compteur += 1

    n = len(modifications)
    print(f"📋 {n} modifications listées.")
    if n <= 1:
        for m in modifications:
            m["score"] = 0.0
        return modifications

    # ---- 2. Embedding + score ACP ------------------------------------------
    X = np.array(embeddings.embed_documents([m["texte"] for m in modifications]))
    X_norm = normalize(X)

    k = max(1, min(n_composantes, n - 1, X_norm.shape[1]))
    pca = PCA(n_components=k)
    projections = pca.fit_transform(X_norm)          # (n, k)

    if k > 1:
        poids = pca.explained_variance_ratio_
        scores = projections @ (poids / poids.sum()) # moyenne pondérée des k axes
    else:
        scores = projections[:, 0]
    scores = scores.flatten()

    print(f"🧭 ACP : {k} composante(s), variance expliquée cumulée = "
          f"{pca.explained_variance_ratio_.sum():.1%}")

    # ---- 3. Tri + tracking ---------------------------------------------------
    for m, s in zip(modifications, scores):
        m["score"] = float(s)

    indices_de_tri = np.argsort(scores)
    modifications_triees = [modifications[i] for i in indices_de_tri]

    # Contrôle : rien perdu, rien dupliqué
    assert sorted(m["id"] for m in modifications_triees) == list(range(n)), \
        "Tri : des modifications ont été perdues ou dupliquées."
    print(f"✅ {n} modifications triées, traçabilité vérifiée.")

    return modifications_triees


