# ==============================================================================
# 3. RÉPARATION (garantit la partition exacte des ids de la fenêtre)
# ==============================================================================

def _reparer_actions(
    actions_llm: List[ActionUnique],
    ids_fenetre: List[int],
    textes_par_id: Dict[int, str],
) -> List[ActionUnique]:
    """
      - id inventé          -> retiré ;
      - id en double        -> gardé dans sa première action ;
      - id oublié           -> réinjecté comme action solo (texte d'origine) ;
      - action à 1 seul id  -> texte FORCÉ à l'original (anti-reformulation).
    """
    attendus = set(ids_fenetre)
    vus: set = set()
    propres: List[ActionUnique] = []

    for action in actions_llm:
        ids = [i for i in action.ids_sources if i in attendus and i not in vus]
        vus.update(ids)
        if not ids:
            continue
        if len(ids) == 1:
            propres.append(ActionUnique(texte=textes_par_id[ids[0]], ids_sources=ids))
        else:
            propres.append(ActionUnique(texte=action.texte, ids_sources=sorted(ids)))

    for i in sorted(attendus - vus):
        propres.append(ActionUnique(texte=textes_par_id[i], ids_sources=[i]))

    return propres


# ==============================================================================
# 4. ÉTAPE 2
# ==============================================================================

def lister_actions_uniques(
    modifs_triees: List[Dict[str, Any]],
    llm,
    taille_fenetre: int = 30,
) -> List[Dict[str, Any]]:
    """
    Découpe modifs_triees en fenêtres FIXES et demande au LLM les actions uniques
    de chaque fenêtre. Le code fait l'union de la traçabilité et vérifie la complétude.

    Retourne : [{texte, ids_origine:set, nodes:set, codes_dm:set, chapitres:set}]
    """
    chaine = PROMPT_ACTIONS_UNIQUES | llm.with_structured_output(RapportActions)

    n = len(modifs_triees)
    if n == 0:
        return []

    # Traçabilité attendue, pour contrôle final
    ids_attendus = {m["id"] for m in modifs_triees}
    dm_attendus = {dm for m in modifs_triees for dm in m["codes_dm"]}
    par_id = {m["id"]: m for m in modifs_triees}

    actions: List[Dict[str, Any]] = []
    nb_fenetres = (n + taille_fenetre - 1) // taille_fenetre
    print(f"🪟 {n} modifications -> {nb_fenetres} fenêtre(s) de {taille_fenetre}.")

    for num, debut in enumerate(range(0, n, taille_fenetre), start=1):
        lot = modifs_triees[debut:debut + taille_fenetre]
        ids_lot = [m["id"] for m in lot]
        textes_par_id = {m["id"]: m["texte"] for m in lot}

        if len(lot) == 1:
            resultats = [ActionUnique(texte=lot[0]["texte"], ids_sources=[lot[0]["id"]])]
        else:
            input_data = "\n".join(f"[ID {m['id']}] : {m['texte']}" for m in lot)
            try:
                rapport = chaine.invoke({"input_data": input_data})
                resultats = _reparer_actions(rapport.actions_uniques, ids_lot, textes_par_id)
            except Exception as e:
                print(f"⚠️ Fenêtre {num} : échec LLM ({e}). Modifications conservées telles quelles.")
                resultats = [ActionUnique(texte=textes_par_id[i], ids_sources=[i]) for i in ids_lot]

        # Union de la traçabilité : c'est le CODE qui l'établit, pas le LLM.
        for action in resultats:
            sources = [par_id[i] for i in action.ids_sources]
            actions.append({
                "texte": action.texte,
                "ids_origine": set(action.ids_sources),
                "nodes": {s["node"] for s in sources},
                "codes_dm": {dm for s in sources for dm in s["codes_dm"]},
                "chapitres": {s["chapitre"] for s in sources},
            })

        print(f"   fenêtre {num}/{nb_fenetres} : {len(lot)} modifs -> "
              f"{len(resultats)} action(s) unique(s).")

    # ---- Contrôles de complétude -------------------------------------------
    ids_couverts = set().union(*(a["ids_origine"] for a in actions))
    assert ids_couverts == ids_attendus, \
        f"Modifications manquantes : {sorted(ids_attendus - ids_couverts)}"

    dm_couverts = set().union(*(a["codes_dm"] for a in actions))
    assert dm_couverts == dm_attendus, \
        f"DM codes manquants : {sorted(dm_attendus - dm_couverts)}"

    print(f"✅ {n} modifications -> {len(actions)} actions uniques. "
          f"{len(dm_couverts)}/{len(dm_attendus)} DM codes cités — complétude OK.")
    return actions


