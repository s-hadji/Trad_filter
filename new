            cible.description = decision.description_fusionnee
            cible.sources |= pattern.sources
            cible.ensembles |= pattern.ensembles      # union des DM, cote code
        else:
            # Pas de merge : le pattern rejoint la liste tel quel
            # (on garde la description, eventuellement reformulee a l'identique)
            if decision:
                pattern.description = decision.description_fusionnee
