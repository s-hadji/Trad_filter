    textes_par_dmc = baliser_par_dmc(feuille)   # {dmc: contenu mergé}
    codes = list(textes_par_dmc.keys())
    contenus = [textes_par_dmc[dmc] for dmc in codes]
    total = len(codes)
    print(f"[Embedding] {total} DMC à embedder")

    if total == 0:
        return {}

    # 2. Embedding en une passe (embed_documents attend une liste de str)
    vecteurs = embedding.embed_documents(contenus)

    # 3. Association {dmc: contenu + vecteur}
    documents = {}
    for indice, dmc in enumerate(codes, 1):
        documents[dmc] = DocumentDMC(
            dm_code=dmc,
            contenu=textes_par_dmc[dmc],
            vecteur=vecteurs[indice - 1],
        )
        print(f"[Embedding] {indice}/{total} — DMC {dmc} "
              f"({compter_balises(textes_par_dmc[dmc])} modif., "
              f"vecteur dim {len(vecteurs[indice - 1])})")

    print(f"[Embedding] Termine : {len(documents)}/{total}")
    return documents
