def _reparer_actions(
    actions_llm: List[ActionUnique],
    ids_fenetre: List[int],
    textes_par_id: Dict[int, str],
) -> List[ActionUnique]:
    """
      - id inventé          -> retiré ;
      - id en double        -> gardé dans sa première action ;
      - id oublié           -> réinjecté comme action solo (texte d'origine) ;
      - action à 1 seul id  -> texte FORCÉ à l'original (anti-reformulation).
    """
    attendus = set(ids_fenetre)
    vus: set = set()
    propres: List[ActionUnique] = []

    for action in actions_llm:
        ids = [i for i in action.ids_sources if i in attendus and i not in vus]
        vus.update(ids)
        if not ids:
            continue
        if len(ids) == 1:
            propres.append(ActionUnique(texte=textes_par_id[ids[0]], ids_sources=ids))
        else:
            propres.append(ActionUnique(texte=action.texte, ids_sources=sorted(ids)))

    for i in sorted(attendus - vus):
        propres.append(ActionUnique(texte=textes_par_id[i], ids_sources=[i]))

    return propres


