"""
==============================================================================
 ETAPE 3 - BOUCLE DE N PASSES (TRI ACP + ACTIONS UNIQUES)
==============================================================================
 Repete le processus : etape 1 (tri ACP) puis etape 2 (actions uniques),
 sur la liste reduite issue de la passe precedente.

   PASSE k :
     1. Embedding des textes courants + tri ACP (n composantes moyennees)
     2. Fenetres fixes + LLM : regroupement par action ("group by action")
     3. Union deterministe de la tracabilite (ids, nodes, DM, chapitres)
     4. Verification de completude (ids et DM codes)
     5. Metriques de passe

 Le re-tri de la passe suivante rapproche ce que les frontieres de fenetre
 avaient separe : c'est ce qui fait converger la condensation.

 Format d'item unique, stable d'une passe a l'autre :
   {texte, ids_origine: set, nodes: set, codes_dm: set, chapitres: set}
==============================================================================
"""

from typing import List, Dict, Any, Tuple
from collections import Counter, defaultdict
import numpy as np
from pydantic import BaseModel, Field
from sklearn.decomposition import PCA
from sklearn.preprocessing import normalize
from langchain_core.prompts import ChatPromptTemplate


# ==============================================================================
# 1. SCHEMAS
# ==============================================================================

class ActionUnique(BaseModel):
    texte: str = Field(
        description=(
            "L'action unique, exprimee de facon englobante : le point commun (nature et contenu "
            "du changement) suivi de l'enumeration exhaustive des cibles concernees. Si un seul "
            "[ID] la compose, son texte est recopie a l'identique."
        )
    )
    ids_sources: List[int] = Field(
        description="Tous les [ID] du lot que cette action unique englobe."
    )

class RapportActions(BaseModel):
    actions_uniques: List[ActionUnique]


# ==============================================================================
# 2. PROMPT (group by action - la cible n'est pas un critere de separation)
# ==============================================================================

