        assert codes_attendus <= couverts_final, \
            f"DM toujours manquants apres rattachement : {codes_attendus - couverts_final}"
        print(f"   OK : {len(couverts_final & codes_attendus)}/{len(codes_attendus)} DM couverts")

        dictionnaire_final[noeud_pivot] = fiche

    return dictionnaire_final






