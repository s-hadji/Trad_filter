     "Donnees (Code DM -> md_out) :\n{input_data}\n\n"
     "Extrayez pour chaque code DM sa liste complete de modifications.")
])


def _compter_balises(texte: str) -> int:
    """Compte deterministe des balises reellement presentes dans le document."""
    return len(re.findall(r"\[\s*(?:MODIFIER|SUPPRIME|AJOUTE)\s*\|", texte, re.IGNORECASE))


def generer_comptes_rendus_packs(packs_nettoyes, max_retries: int = 2) -> Dict[object, ExtractionPack]:
    dictionnaire_final = {}

    llm = ChatOpenAI(model="gpt-4o", temperature=0.1, max_tokens=8000)
    chaine = prompt_extraction | llm.with_structured_output(ExtractionPack)

    for pack in packs_nettoyes:
        noeud_pivot = pack["node"]
        donnees_feuilles = pack["donnees"]
        nom_pivot = getattr(noeud_pivot, "name", "Noeud_Anonyme")
        codes_attendus = list(donnees_feuilles.keys())

        # Nombre de balises attendu par DM (verite deterministe issue du texte source)
        attendus_par_dm = {c: _compter_balises(str(donnees_feuilles[c])) for c in codes_attendus}
        total_attendu = sum(attendus_par_dm.values())
        print(f"Analyse du pack : {nom_pivot} "
              f"({len(codes_attendus)} documents, {total_attendu} balises attendues)...")

        payload_textuel = json.dumps(donnees_feuilles, indent=2, ensure_ascii=False)

        fiches: List[FicheDM] = []
        try:
            for tentative in range(max_retries + 1):
                try:
                    resultat = chaine.invoke({
                        "nom_pivot": nom_pivot,
                        "codes_attendus": ", ".join(codes_attendus),
                        "input_data": payload_textuel,
                    })
                except Exception as e:
                    # Echec de l'appel LLM ou du parsing structure sur cette tentative
                    print(f"   ! Tentative {tentative + 1} : erreur d'appel LLM ({type(e).__name__}: {e})")
                    if tentative < max_retries:
                        continue
                    # Derniere tentative echouee -> on ressort avec ce qu'on a (rien)
                    raise

                # 1. On ne garde que les DM reellement attendus (purge des hallucinations)
                index = {f.code_dm: f for f in resultat.fiches_dm if f.code_dm in donnees_feuilles}

                # 2. DM totalement manquants dans la sortie
                manquants = [c for c in codes_attendus if c not in index]

                # 3. DM presents mais vides alors que le texte contient des balises
                vides = [c for c in codes_attendus
                         if c in index and not index[c].modifications and attendus_par_dm[c] > 0]

                # 4. DM incomplets : moins de modifications que de balises attendues
                incomplets = [
                    c for c in codes_attendus
                    if c in index and len(index[c].modifications) < attendus_par_dm[c]
                ]

                if not manquants and not vides and not incomplets:
                    fiches = [index[c] for c in codes_attendus]
                    break

                print(f"   ! Tentative {tentative + 1} incomplete "
                      f"(manquants={manquants}, vides={vides}, "
                      f"incomplets={[(c, len(index[c].modifications), attendus_par_dm[c]) for c in incomplets]})")
                fiches = [index.get(c, FicheDM(code_dm=c)) for c in codes_attendus]

        except Exception as e:
            # Echec definitif du pack : on le trace, on met des fiches vides et on continue
            print(f"   ECHEC du pack {nom_pivot} apres {max_retries + 1} tentative(s) : "
                  f"{type(e).__name__}: {e}")
            fiches = [FicheDM(code_dm=c) for c in codes_attendus]
            dictionnaire_final[noeud_pivot] = ExtractionPack(fiches_dm=fiches)
            continue  # on passe au pack suivant sans interrompre le traitement global

        # --- Rapport de completude final ---
        ok = True
        for f in fiches:
            attendu = attendus_par_dm[f.code_dm]
            obtenu = len(f.modifications)
            statut = "OK" if obtenu >= attendu else "INCOMPLET"
            if obtenu < attendu:
                ok = False
            print(f"   - DM {f.code_dm} : {obtenu}/{attendu} modification(s) [{statut}]")

        if not ok:
            print(f"   ATTENTION : le pack {nom_pivot} reste incomplet apres {max_retries + 1} tentative(s).")

        dictionnaire_final[noeud_pivot] = ExtractionPack(fiches_dm=fiches)

    return dictionnaire_final



