import json
import re
from typing import List, Dict
from langchain_openai import ChatOpenAI
from langchain_core.prompts import ChatPromptTemplate
from pydantic import BaseModel, Field


# --- Schémas : extraction brute, un DM -> sa liste de modifications ---
class FicheDM(BaseModel):
    """Fiche d'UN seul code DM."""
    code_dm: str = Field(description="Le code DM analyse, recopie a l'identique.")
    modifications: List[str] = Field(
        default_factory=list,
        description="Liste EXHAUSTIVE de toutes les modifications de ce document, une entree par evolution distincte."
    )

class ExtractionPack(BaseModel):
    """Tous les DM d'un pack, chacun avec ses modifications."""
    fiches_dm: List[FicheDM] = Field(
        description="Une fiche par code DM fourni, sans exception et sans regroupement."
    )


# --- Prompt : tous les DM du bloc en une passe ---
prompt_extraction = ChatPromptTemplate.from_messages([
    ("system",
     "Vous etes un expert de la documentation technique et de la gestion de configuration.\n"
     "On vous fournit un ensemble de documents sous la forme d'un objet JSON (Code DM -> contenu md_out).\n"
     "Votre unique role est d'EXTRAIRE, pour chaque code DM, la liste exhaustive de ses modifications.\n\n"
     "Les modifications proviennent de balises typees du document source :\n"
     "  - [MODIFIER| avant: X, apres: Y] : la valeur X devient Y.\n"
     "  - [SUPPRIME| avant: X] : la valeur X a ete retiree.\n"
     "  - [AJOUTE| apres: Y] : la valeur Y a ete ajoutee.\n"
     "Tout ce qui n'est pas dans une balise etait identique entre les deux versions et ne doit pas etre releve.\n\n"
     "METHODE :\n"
     "1. Traitez les documents un par un, dans l'ordre fourni.\n"
     "2. Pour un document donne, parcourez son texte du debut a la fin et relevez CHAQUE balise, "
     "sans exception, une entree par balise.\n"
     "3. Chaque entree explicite ce qui change : le type (modifie, supprime, ajoute) et l'evolution "
     "entre l'ancienne valeur (avant) et la nouvelle (apres).\n\n"
     "REGLES IMPERATIVES :\n"
     "- Produisez EXACTEMENT une fiche par code DM fourni, ni plus ni moins. Recopiez les codes DM a "
     "l'identique, n'en inventez aucun, n'en omettez aucun.\n"
     "- AUCUN CROISEMENT : les modifications d'un document ne doivent jamais etre attribuees a un autre. "
     "Ne regroupez pas, ne factorisez pas, ne mutualisez pas entre documents, meme si les modifications "
     "se ressemblent ou sont identiques. Chaque fiche est autonome et repete ses propres modifications.\n"
     "- EXHAUSTIVITE : ne resumez pas, ne condensez pas, n'ecrivez jamais 'idem', 'meme chose que', "
     "'et autres modifications similaires'. Si une meme evolution apparait a dix endroits du document, "
     "listez les dix entrees.\n"
     "- Si un document ne contient aucune balise, retournez une liste vide pour lui.\n\n"
     "Regles de redaction strictes :\n"
     "- Aucun emoji, icone ou artifice de mise en forme.\n"
     "- Phrases fluides, orientees metier, factuelles, neutres et concises."),
    ("user",
     "Pivot : {nom_pivot}\n\n"
     "Codes DM a traiter (tous obligatoires) : {codes_attendus}\n\n"
     "Donnees (Code DM -> md_out) :\n{input_data}\n\n"
     "Extrayez pour chaque code DM sa liste complete de modifications.")
])


def _compter_balises(texte: str) -> int:
    """Compte deterministe des balises reellement presentes dans le document."""
    return len(re.findall(r"\[\s*(?:MODIFIER|SUPPRIME|AJOUTE)\s*\|", texte, re.IGNORECASE))


def generer_comptes_rendus_packs(packs_nettoyes, max_retries: int = 2) -> Dict[object, ExtractionPack]:
    dictionnaire_final = {}

    llm = ChatOpenAI(model="gpt-4o", temperature=0.1, max_tokens=8000)
    chaine = prompt_extraction | llm.with_structured_output(ExtractionPack)

    for pack in packs_nettoyes:
        noeud_pivot = pack["node"]
        donnees_feuilles = pack["donnees"]
        nom_pivot = getattr(noeud_pivot, "name", "Noeud_Anonyme")
        codes_attendus = list(donnees_feuilles.keys())

        # Nombre de balises attendu par DM (verite deterministe issue du texte source)
        attendus_par_dm = {c: _compter_balises(str(donnees_feuilles[c])) for c in codes_attendus}
        total_attendu = sum(attendus_par_dm.values())
        print(f"Analyse du pack : {nom_pivot} "
              f"({len(codes_attendus)} documents, {total_attendu} balises attendues)...")

        payload_textuel = json.dumps(donnees_feuilles, indent=2, ensure_ascii=False)

        fiches: List[FicheDM] = []
        try:
            for tentative in range(max_retries + 1):
                try:
                    resultat = chaine.invoke({
                        "nom_pivot": nom_pivot,
                        "codes_attendus": ", ".join(codes_attendus),
                        "input_data": payload_textuel,
                    })
                except Exception as e:
                    # Echec de l'appel LLM ou du parsing structure sur cette tentative
                    print(f"   ! Tentative {tentative + 1} : erreur d'appel LLM ({type(e).__name__}: {e})")
                    if tentative < max_retries:
                        continue
                    # Derniere tentative echouee -> on ressort avec ce qu'on a (rien)
                    raise

                # 1. On ne garde que les DM reellement attendus (purge des hallucinations)
                index = {f.code_dm: f for f in resultat.fiches_dm if f.code_dm in donnees_feuilles}

                # 2. DM totalement manquants dans la sortie
                manquants = [c for c in codes_attendus if c not in index]

                # 3. DM presents mais vides alors que le texte contient des balises
                vides = [c for c in codes_attendus
                         if c in index and not index[c].modifications and attendus_par_dm[c] > 0]

                # 4. DM incomplets : moins de modifications que de balises attendues
                incomplets = [
                    c for c in codes_attendus
                    if c in index and len(index[c].modifications) < attendus_par_dm[c]
                ]

                if not manquants and not vides and not incomplets:
                    fiches = [index[c] for c in codes_attendus]
                    break

                print(f"   ! Tentative {tentative + 1} incomplete "
                      f"(manquants={manquants}, vides={vides}, "
                      f"incomplets={[(c, len(index[c].modifications), attendus_par_dm[c]) for c in incomplets]})")
                fiches = [index.get(c, FicheDM(code_dm=c)) for c in codes_attendus]

        except Exception as e:
            # Echec definitif du pack : on le trace, on met des fiches vides et on continue
            print(f"   ECHEC du pack {nom_pivot} apres {max_retries + 1} tentative(s) : "
                  f"{type(e).__name__}: {e}")
            fiches = [FicheDM(code_dm=c) for c in codes_attendus]
            dictionnaire_final[noeud_pivot] = ExtractionPack(fiches_dm=fiches)
            continue  # on passe au pack suivant sans interrompre le traitement global

        # --- Rapport de completude final ---
        ok = True
        for f in fiches:
            attendu = attendus_par_dm[f.code_dm]
            obtenu = len(f.modifications)
            statut = "OK" if obtenu >= attendu else "INCOMPLET"
            if obtenu < attendu:
                ok = False
            print(f"   - DM {f.code_dm} : {obtenu}/{attendu} modification(s) [{statut}]")

        if not ok:
            print(f"   ATTENTION : le pack {nom_pivot} reste incomplet apres {max_retries + 1} tentative(s).")

        dictionnaire_final[noeud_pivot] = ExtractionPack(fiches_dm=fiches)

    return dictionnaire_final



