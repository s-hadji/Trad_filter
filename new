import re
import difflib
from typing import List, Dict, Tuple, Optional


# =================================================================== #
#  Caractères "volatils" : ce qui, quand ça seul diffère entre deux    #
#  lignes, ne suffit pas a les distinguer.                            #
# =================================================================== #
# On y met la ponctuation, les blancs ET les chiffres, pour que
# '(rep. 2)' et '(rep. 5)' soient consideres equivalents.
VOLATILES = set(" \t\n\r.,;:!?()[]{}'\"/-0123456789")


def diff_est_volatile(texte_a: str, texte_b: str) -> bool:
    """
    Compare deux textes caractere par caractere avec difflib.
    Renvoie True si TOUT ce qui differe entre eux est compose uniquement de
    caracteres volatils. Autrement dit : ils sont identiques a un
    numero / espace / ponctuation pres.
    """
    comparateur = difflib.SequenceMatcher(None, texte_a, texte_b)
    for tag, i1, i2, j1, j2 in comparateur.get_opcodes():
        if tag == "equal":
            continue
        # Portion qui differe, des deux cotes
        part_a = texte_a[i1:i2]
        part_b = texte_b[j1:j2]
        # Si l'une des deux contient un caractere NON volatil -> vraie difference
        if any(c not in VOLATILES for c in part_a + part_b):
            return False
    return True


def couples_equivalents(couple_a, couple_b) -> bool:
    """Deux changements sont equivalents si leur AVANT et leur APRES le sont."""
    avant_a, apres_a = couple_a
    avant_b, apres_b = couple_b
    return diff_est_volatile(avant_a, avant_b) and diff_est_volatile(apres_a, apres_b)


# =================================================================== #
#  Extraction de l'avant / après d'une ligne                          #
# =================================================================== #
LIGNE = re.compile(
    r"un element '(?P<avant>.*?)' a ete remplace par '(?P<apres>.*?)'"
    r"(?:\s+dans le\(s\) DM\s*:\s*(?P<dm>.*))?$",
    re.IGNORECASE,
)


def analyser_ligne(ligne: str) -> Optional[Tuple[str, str, List[str]]]:
    """Extrait (avant, apres, [dm...]) d'une ligne. None si le format ne colle pas."""
    m = LIGNE.search(ligne)
    if not m:
        return None
    avant = m.group("avant") or ""
    apres = m.group("apres") or ""
    dm_txt = m.group("dm") or ""
    dms = [d.strip() for d in dm_txt.split(",") if d.strip()]
    return avant, apres, dms


# =================================================================== #
#  Regroupement par équivalence difflib (transitif)                   #
# =================================================================== #
def regrouper_lignes(lignes: List[str]) -> List[dict]:
    """
    Regroupe les lignes dont (avant, apres) sont equivalents au sens difflib :
    tout ce qui differe entre deux lignes d'un meme groupe est volatil.

    Strategie : on parcourt les lignes une fois. Chaque nouvelle ligne est
    comparee au REPRESENTANT de chaque groupe deja forme ; si elle est
    equivalente, elle rejoint ce groupe, sinon elle en ouvre un nouveau.
    Le premier element rencontre sert de representant (les lignes sont deja
    triees, donc les equivalents sont voisins : la comparaison reste rapide).
    """
    groupes: List[dict] = []

    for ligne in lignes:
        analyse = analyser_ligne(ligne)
        if analyse is None:
            continue
        avant, apres, dms = analyse
        couple = (avant, apres)

        # Cherche un groupe existant dont le representant est equivalent
        groupe_trouve = None
        for groupe in groupes:
            if couples_equivalents(groupe["representant"], couple):
                groupe_trouve = groupe
                break

        if groupe_trouve is None:
            groupes.append({
                "representant": couple,      # sert de reference pour comparer
                "avant": avant,              # forme lisible affichee
                "apres": apres,
                "variantes": {couple},
                "dms": set(dms),
            })
        else:
            groupe_trouve["variantes"].add(couple)
            groupe_trouve["dms"].update(dms)

    # Mise en forme finale
    return [
        {
            "avant": g["avant"],
            "apres": g["apres"],
            "nb_variantes": len(g["variantes"]),
            "dms": sorted(g["dms"]),
        }
        for g in groupes
    ]


# =================================================================== #
#  Affichage                                                          #
# =================================================================== #
def afficher_groupes(groupes: List[dict]) -> None:
    print(f"{len(groupes)} groupe(s) apres regroupement\n")
    for i, g in enumerate(groupes, 1):
        print(f"{i}. '{g['avant']}' -> '{g['apres']}'")
        print(f"   {g['nb_variantes']} variante(s), {len(g['dms'])} DM")
        if g["dms"]:
            print(f"   DM : {', '.join(g['dms'])}")
        print()


