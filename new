    contenu: str            # tout le texte balisé du DMC, mergé en un bloc
    vecteur: List[float] = field(default_factory=list)  # embedding du contenu


def construire_documents_embeddes(feuille, embedding) -> Dict[str, DocumentDMC]:
    """
    Part de 'feuille', merge le texte balisé par DMC réel (un seul bloc par DMC),
    puis embedde chaque bloc. Renvoie {dmc: DocumentDMC(dm_code, contenu, vecteur)}.
