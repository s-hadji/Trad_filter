    paires = defaultdict(lambda: {"v1": [], "v2": [], "tokens": None})
    for tokens, code, doc, version in entrees:
        p = paires[code]
        p[version].append(doc)
        if p["tokens"] is None:
            p["tokens"] = tokens        # chemin de référence = premier vu

    # --- 2. Ré-explosion en entrées appariées ---
    appariees = []
    for code, p in paires.items():
        v1, v2 = p["v1"], p["v2"]
        for i in range(max(len(v1), len(v2))):
            appariees.append((
                p["tokens"], code, i,
                v1[i] if i < len(v1) else None,
                v2[i] if i < len(v2) else None,
            ))

    _construire(appariees, parent)


def _construire(entrees, parent):
