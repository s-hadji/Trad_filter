def _afficher_catalogue(catalogue: Dict[int, Modification]) -> None:
    """Etat courant du catalogue, affiche apres chaque DM."""
    print(f"    --- Catalogue ({len(catalogue)}) ---")
    for m in catalogue.values():
        print(f"    [{m.id}] {m.description}  ({len(m.dms)} DM)")
    print()


# =================================================================== #
#  Traitement : une passe sur toutes les feuilles                     #
# =================================================================== #
def analyser_feuilles(feuille, llm, has_changes, diff_unifie, nombre_essais: int = 3):
    """
    Pour chaque feuille modifiee : calcule le diff, demande au LLM les patterns,
    et met a jour les deux tables.
    Renvoie (catalogue, par_dm) :
      - catalogue : {id: Modification}          -> pattern -> liste de DM
      - par_dm    : {dm_code: [ids de patterns]} -> DM -> ses patterns
    """
    chaine = PROMPT | llm.with_structured_output(SortieLLM)

    catalogue: Dict[int, Modification] = {}
    par_dm: Dict[str, List[int]] = {}
    prochain_id = 1

    a_traiter = [f for f in feuille
                 if has_changes(f.doc_v1["content"], f.doc_v2["content"])]
    total = len(a_traiter)

    for numero, f in enumerate(a_traiter, 1):
        dm = f.dm_code
        print(f"[{numero}/{total}] DM {dm}")

        diff = diff_unifie(f.doc_v1["content"], f.doc_v2["content"])
        sortie = _appeler_llm(chaine, diff, catalogue, nombre_essais)

        if sortie is None:                 # echec definitif : on passe au suivant
            par_dm[dm] = []
            continue

        ids_du_dm = []
        for vue in sortie.modifications:
            # Pattern deja connu ? (on verifie que l'id existe vraiment)
            modif = catalogue.get(vue.id_connu) if vue.id_connu != -1 else None

            if modif is None:
                modif = Modification(id=prochain_id, description=vue.description)
                catalogue[prochain_id] = modif
                prochain_id += 1

            # C'est NOUS qui rattachons le DM : aucune hallucination possible
            modif.dms.add(dm)
            ids_du_dm.append(modif.id)

        par_dm[dm] = ids_du_dm
        _afficher_catalogue(catalogue)

    print(f"Termine : {len(catalogue)} pattern(s) distinct(s) sur {total} DM")
    return catalogue, par_dm


def _appeler_llm(chaine, diff, catalogue, nombre_essais):
    """Appelle le LLM avec quelques tentatives. Renvoie None si echec definitif."""
    for essai in range(1, nombre_essais + 1):
        try:
            return chaine.invoke({"diff": diff, "connues": _formater_connues(catalogue)})
        except Exception as erreur:
            print(f"    ! Essai {essai}/{nombre_essais} echoue "
                  f"({type(erreur).__name__}: {erreur})")
    print("    ! Echec definitif, DM ignore")
    return None


# =================================================================== #
#  Affichage final des deux tables                                    #
# =================================================================== #
def afficher(catalogue: Dict[int, Modification], par_dm: Dict[str, List[int]]) -> None:
    print("\n=== PATTERNS -> DM ===\n")
    for m in catalogue.values():
        print(f"[{m.id}] {m.description}")
        print(f"     {len(m.dms)} DM : {', '.join(sorted(m.dms))}\n")

    print("\n=== DM -> PATTERNS ===\n")
    for dm, ids in par_dm.items():
        print(f"{dm} : {ids}")


