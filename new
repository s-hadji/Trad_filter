            "du changement) suivi de l'enumeration exhaustive des cibles concernees. Si un seul "
            "[ID] la compose, son texte est recopie a l'identique."
        )
    )
    ids_sources: List[int] = Field(
        description="Tous les [ID] du lot que cette action unique englobe."
    )

class RapportActions(BaseModel):
    actions_uniques: List[ActionUnique]


# ==============================================================================
# 2. PROMPT (group by action - la cible n'est pas un critere de separation)
# ==============================================================================

