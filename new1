def consolider_catalogue(catalogue: Dict[int, Modification], llm, embedding,
                         taille_lot: int = 40, nombre_essais: int = 3) -> List[PatternFinal]:
    """
    Passe 2. Trie les lignes du catalogue par embedding (les doublons se
    retrouvent dans le meme lot), puis consolide par lots. Le LLM fusionne les
    descriptions ; NOUS reconstruisons les DM par union des sources.
    """
    chaine = PROMPT_PASSE2 | llm.with_structured_output(SuperCatalogue)

    lignes = list(catalogue.values())

    # --- TRI par embedding des descriptions ---
    print(f"Tri de {len(lignes)} pattern(s) par embedding...")
    ordre = trier_par_embedding([m.description for m in lignes], embedding)
    lignes = [lignes[i] for i in ordre]

    total = len(lignes)
    nb_lots = (total + taille_lot - 1) // taille_lot
    print(f"Consolidation en {nb_lots} lot(s)")

    finaux: List[PatternFinal] = []
    prochain_id = 1

    for numero, debut in enumerate(range(0, total, taille_lot), 1):
        lot = {m.id: m for m in lignes[debut: debut + taille_lot]}
        print(f"[Lot {numero}/{nb_lots}] {len(lot)} pattern(s)")

        sortie = _appeler_passe2(chaine, lot, nombre_essais)
        if sortie is None:
            for m in lot.values():
                finaux.append(PatternFinal(id=prochain_id, description=m.description,
                                           sources={m.id}, dms=set(m.dms)))
                prochain_id += 1
            continue

        couverts: Set[int] = set()
        for entree in sortie.entrees:
            sources_valides = [i for i in entree.sources if i in lot]
            if not sources_valides:
                continue
            dms = set()
            for i in sources_valides:
                dms |= lot[i].dms             # UNION des DM, cote code
                couverts.add(i)
            finaux.append(PatternFinal(id=prochain_id, description=entree.description,
                                       sources=set(sources_valides), dms=dms))
            prochain_id += 1

        oublies = set(lot) - couverts
        if oublies:
            print(f"    ! {len(oublies)} pattern(s) oublie(s), rattache(s) seuls")
            for i in oublies:
                m = lot[i]
                finaux.append(PatternFinal(id=prochain_id, description=m.description,
                                           sources={i}, dms=set(m.dms)))
                prochain_id += 1

    print(f"Passe 2 terminee : {len(finaux)} entree(s) finale(s)")
    return finaux


