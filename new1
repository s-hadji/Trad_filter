import re
import unicodedata

TOKENS_PARASITES = {'/', '|', '.', '>', '→', '->'}      # on garde les tirets


def normaliser(titre):
    """Titre nettoye : une seule ligne, espaces simples, tokens parasites retires."""
    titre = unicodedata.normalize('NFKC', titre.splitlines()[0])
    titre = re.sub(r'\s+', ' ', titre).strip()
    return " ".join(t for t in titre.split(' ') if t and t not in TOKENS_PARASITES)


def set_titres(dico, dico_v2):
    """Set des titres uniques des deux versions."""
    return {normaliser(d["extra_information"]["DM_title"]) for d in dico + dico_v2}


def arbre_titres(titres):
    """Arbre prefixe des titres (separateur = espace, insensible a la casse).
    Chaque noeud : {'nom', 'titres' (les titres qui s'arretent ici), 'fils'}.
    Un noeud sans titre et sans embranchement fusionne avec son fils unique."""
    arbre = {}
    for titre in titres:                                # 1. un niveau par mot
        noeud, courant = arbre, None
        for mot in titre.split(" "):
            courant = noeud.setdefault(mot.lower(), {"nom": mot, "titres": set(), "fils": {}})
            noeud = courant["fils"]
        if courant:
            courant["titres"].add(titre)                # le titre s'arrete ici

    def merger(noeud):                                  # 2. un seul fils -> on colle les noms
        fusionne = {}
        for n in noeud.values():
            nom, titres_ici, fils = n["nom"], n["titres"], n["fils"]
            while not titres_ici and len(fils) == 1:
                (f,) = fils.values()
                nom, titres_ici, fils = f"{nom} {f['nom']}", f["titres"], f["fils"]
            fusionne[nom] = {"titres": titres_ici, "fils": merger(fils)}
        return fusionne

    return merger(arbre)


def compter_chemins(arbre):
    """Nombre de titres poses dans l'arbre : doit valoir len(titres)."""
    return sum(len(n["titres"]) + compter_chemins(n["fils"]) for n in arbre.values())


def afficher(arbre, niveau=0):
    for nom, n in sorted(arbre.items()):
        marque = f"  <- {len(n['titres'])} titre(s)" if n["titres"] else ""
        print("  " * niveau + nom + marque)
        afficher(n["fils"], niveau + 1)





def arbre_titres(titres):
    """Arbre prefixe des titres (separateur = espace), chaines fusionnees en un seul noeud."""
    arbre = {}
    for titre in titres:                            # 1. un niveau par mot
        noeud = arbre
        for mot in titre.split(" "):
            noeud = noeud.setdefault(mot, {})

    def merger(noeud):                              # 2. un seul enfant -> on colle les noms
        fusionne = {}
        for mot, fils in noeud.items():
            while len(fils) == 1:
                (suite, petits), = fils.items()
                mot, fils = f"{mot} {suite}", petits
            fusionne[mot] = merger(fils)
        return fusionne

    return merger(arbre)




