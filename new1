    )


class SuperCatalogue(BaseModel):
    entrees: List[EntreeFinale] = Field(description="Catalogue final compact, sans perte.")


class PatternFinal(BaseModel):
    id: int
    description: str
    sources: Set[int] = Field(default_factory=set)
    dms: Set[str] = Field(default_factory=set)

    class Config:
        arbitrary_types_allowed = True

    @property
    def nb_dm(self) -> int:
        return len(self.dms)


class EtatPasse2(BaseModel):
