            if code not in feuilles:
                f = feuilles[code] = Node(code)
                f.dm_code, f.feuille, f.statut = code, True, "FEUILLE"
                f.mots = normaliser(d["extra_information"]["DM_title"])
            setattr(feuilles[code], champ, d)

    racine = Node("ROOT")
    construire(sorted(feuilles.values(), key=lambda f: f.mots), racine)
    return racine


def construire(feuilles, parent, i=0):
    """Prend la 1re feuille, regarde qui a le meme i-eme mot :
       - personne -> feuille directe sous parent
       - d'autres -> un noeud avec tout le prefixe commun, et on recommence dessous
       Puis on passe a la suivante non encore traitee, et ainsi de suite."""
    restantes = list(feuilles)
    while restantes:
        premiere = restantes[0]
        if i >= len(premiere.mots):                                # plus de mot -> feuille
            groupe = [premiere]
        else:
            groupe = [f for f in restantes
                      if i < len(f.mots) and f.mots[i].lower() == premiere.mots[i].lower()]
        restantes = [f for f in restantes if f not in groupe]

        if len(groupe) == 1:                                       # seul -> feuille
            premiere.parent = parent
            parent.children.append(premiere)
            continue

        n = i + 1                                                  # prefixe le plus long
        while all(len(f.mots) > n and f.mots[n].lower() == premiere.mots[n].lower()
                  for f in groupe):
            n += 1
        construire(groupe, Node(" ".join(premiere.mots[i:n]), parent=parent), n)


