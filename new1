def construire_arbre(dico, dico_v2):
    # 1. Docs par (titre, code) ; trie des titres
    docs = defaultdict(lambda: {"doc_v1": None, "doc_v2": None})
    trie = pygtrie.StringTrie(separator=" ")
    for liste, champ in ((dico, "doc_v1"), (dico_v2, "doc_v2")):
        for d in liste:
            info = d["extra_information"]
            titre, code = normaliser(info["DM_title"]), info["DM_code"]
            docs[(titre, code)][champ] = d
            trie.setdefault(titre, set()).add(code)

    # 2. Un titre = un chemin ; on ne cree un Node qu'aux endroits ou le trie se separe
    racine = Node("ROOT")
