# =================================================================== #
def afficher_final(finaux: List[PatternFinal]) -> None:
    print(f"\n=== CATALOGUE FINAL ({len(finaux)}) ===\n")
    for p in sorted(finaux, key=lambda x: x.nb_dm, reverse=True):
        print(f"[{p.id}] {p.description}")
        print(f"     sources : {sorted(p.sources)}")
        print(f"     {p.nb_dm} DM : {', '.join(sorted(p.dms))}\n")


