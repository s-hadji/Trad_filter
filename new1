


from typing import List, Dict, Set
from pydantic import BaseModel, Field
from langchain_core.prompts import ChatPromptTemplate


# =================================================================== #
#  Ce que le LLM doit renvoyer                                        #
# =================================================================== #
class ModificationVue(BaseModel):
    """Un pattern de modification repere dans le diff d'un document."""
    id_connu: int = Field(
        description="Id d'un pattern DEJA CONNU si c'est le meme, sinon -1 pour un nouveau."
    )
    description: str = Field(
        description="Pattern de modification, GENERIQUE et court. Decrire la NATURE du changement, "
                    "pas les elements precis sur lesquels il porte. "
                    "Si id_connu != -1, recopier la description connue a l'identique."
    )


class SortieLLM(BaseModel):
    modifications: List[ModificationVue] = Field(
        description="Les patterns de modification presents dans ce document. Peu nombreux."
    )


# =================================================================== #
#  Le catalogue : pattern -> DM concernes                             #
# =================================================================== #
class Modification(BaseModel):
    id: int
    description: str
    dms: Set[str] = Field(default_factory=set)

    class Config:
        arbitrary_types_allowed = True


PROMPT = ChatPromptTemplate.from_messages([
    ("system",
     "Vous etes un expert en analyse de modifications documentaires.\n\n"
     "On vous donne un document ou seules les modifications sont balisees :\n"
     "  [MODIFIE | avant: X | apres: Y]   X est devenu Y\n"
     "  [SUPPRIME | avant: X]             X a ete retire\n"
     "  [AJOUTE | apres: Y]               Y a ete ajoute\n"
     "Le texte non balise est le contexte inchange, [...] signale un passage omis.\n\n"
     "Votre role : identifier les PATTERNS de modification, pas les modifications individuelles.\n\n"
     "REGLE FONDAMENTALE : decrivez la NATURE du changement, JAMAIS les elements precis sur "
     "lesquels il porte.\n"
     "  BON  : 'Traduction des libelles du francais vers l'anglais'\n"
     "  BON  : 'Ajout de reperes (rep. N) apres les designations'\n"
     "  BON  : 'Remplacement de references alphanumeriques'\n"
     "  MAUVAIS : 'Gouvernes horizontales (pose) devient Horizontal Control Surfaces (rep. 2)'\n"
     "  MAUVAIS : 'Le calculateur detail connecteur a ete traduit'\n\n"
     "Un document contient en general 1 a 4 patterns seulement. Regroupez agressivement : toutes "
     "les balises de meme nature relevent d'UN SEUL pattern, quel que soit leur nombre.\n\n"
     "PATTERNS DEJA CONNUS :\n{connues}\n\n"
     "Si un pattern que vous voyez existe deja, mettez son id dans 'id_connu' et RECOPIEZ sa "
     "description a l'identique. Ne creez un nouveau pattern (-1) que si aucun ne correspond.\n\n"
     "Aucun emoji. Style factuel et concis."),
    ("user", "Document balise :\n{diff}\n\nIdentifiez les patterns de modification.")
])


def _formater_connues(catalogue: Dict[int, Modification]) -> str:
    if not catalogue:
        return "  (aucun pour l'instant)"
    return "\n".join(f"  [{m.id}] {m.description}" for m in catalogue.values())


def _afficher_catalogue(catalogue: Dict[int, Modification], numero_catalogue: int) -> None:
    """Etat courant du catalogue actif, affiche apres chaque DM."""
    print(f"    --- Catalogue #{numero_catalogue} ({len(catalogue)}) ---")
    for m in catalogue.values():
        print(f"    [{m.id}] {m.description}  ({len(m.dms)} DM)")
    print()


# =================================================================== #
#  Traitement : une passe, avec rotation des catalogues               #
# =================================================================== #
def analyser_feuilles(feuille, llm, has_changes, diff_unifie,
                      taille_max_catalogue: int = 30, nombre_essais: int = 3):
    """
    Pour chaque feuille modifiee : calcule le diff, demande au LLM les patterns.

    Quand le catalogue COURANT depasse 'taille_max_catalogue', on l'archive et on
    en ouvre un nouveau (vide) : le LLM ne voit jamais plus de N patterns a la
    fois, ce qui evite de saturer le contexte.

    Les ids restent GLOBALEMENT uniques (jamais reinitialises), donc par_dm reste
    coherent. Un pattern deja vu dans un catalogue archive peut reapparaitre dans
    le nouveau (double) : on fusionne a la fin par description identique.

    Renvoie (catalogue_global, par_dm).
    """
    chaine = PROMPT | llm.with_structured_output(SortieLLM)

    catalogue_courant: Dict[int, Modification] = {}   # ce que voit le LLM
    tous_les_patterns: Dict[int, Modification] = {}    # accumulation globale
    par_dm: Dict[str, List[int]] = {}
    prochain_id = 1
    numero_catalogue = 1

    a_traiter = [f for f in feuille
                 if has_changes(f.doc_v1["content"], f.doc_v2["content"])]
    total = len(a_traiter)

    for numero, f in enumerate(a_traiter, 1):
        dm = f.dm_code
        print(f"[{numero}/{total}] DM {dm}")

        # --- Rotation : catalogue courant trop grand -> on en ouvre un neuf ---
        if len(catalogue_courant) >= taille_max_catalogue:
            numero_catalogue += 1
            print(f"    >>> Catalogue plein ({len(catalogue_courant)}), "
                  f"ouverture du catalogue #{numero_catalogue}")
            catalogue_courant = {}

        diff = diff_unifie(f.doc_v1["content"], f.doc_v2["content"])
        sortie = _appeler_llm(chaine, diff, catalogue_courant, nombre_essais)

        if sortie is None:
            par_dm[dm] = []
            continue

        ids_du_dm = []
        for vue in sortie.modifications:
            # Pattern connu ? On ne cherche QUE dans le catalogue courant
            modif = catalogue_courant.get(vue.id_connu) if vue.id_connu != -1 else None

            if modif is None:
                modif = Modification(id=prochain_id, description=vue.description)
                catalogue_courant[prochain_id] = modif
                tous_les_patterns[prochain_id] = modif      # meme objet, partage
                prochain_id += 1

            modif.dms.add(dm)          # rattachement du DM, cote code
            ids_du_dm.append(modif.id)

        par_dm[dm] = ids_du_dm
        _afficher_catalogue(catalogue_courant, numero_catalogue)

    # --- Fusion finale des doublons entre catalogues ---
    catalogue_global, remap = _fusionner_doublons(tous_les_patterns)
    par_dm = {dm: [remap.get(i, i) for i in ids] for dm, ids in par_dm.items()}

    print(f"Termine : {len(catalogue_global)} pattern(s) distinct(s) apres fusion "
          f"({numero_catalogue} catalogue(s) utilise(s))")
    return catalogue_global, par_dm


def _fusionner_doublons(patterns: Dict[int, Modification]):
    """
    Fusionne les patterns de meme description (nes dans des catalogues differents).
    Renvoie (catalogue_fusionne, remap) ou remap : ancien_id -> id conserve.
    """
    par_desc: Dict[str, Modification] = {}
    remap: Dict[int, int] = {}

    for m in patterns.values():
        cle = m.description.strip().lower()
        if cle not in par_desc:
            par_desc[cle] = m
            remap[m.id] = m.id
        else:
            garde = par_desc[cle]
            garde.dms |= m.dms          # union des DM
            remap[m.id] = garde.id      # les references pointent vers le garde

    return {m.id: m for m in par_desc.values()}, remap


def _appeler_llm(chaine, diff, catalogue, nombre_essais):
    """Appelle le LLM avec quelques tentatives. Renvoie None si echec definitif."""
    for essai in range(1, nombre_essais + 1):
        try:
            return chaine.invoke({"diff": diff, "connues": _formater_connues(catalogue)})
        except Exception as erreur:
            print(f"    ! Essai {essai}/{nombre_essais} echoue "
                  f"({type(erreur).__name__}: {erreur})")
    print("    ! Echec definitif, DM ignore")
    return None


# =================================================================== #
#  Affichage final des deux tables                                    #
# =================================================================== #
def afficher(catalogue: Dict[int, Modification], par_dm: Dict[str, List[int]]) -> None:
    print("\n=== PATTERNS -> DM ===\n")
    for m in sorted(catalogue.values(), key=lambda x: len(x.dms), reverse=True):
        print(f"[{m.id}] {m.description}")
        print(f"     {len(m.dms)} DM : {', '.join(sorted(m.dms))}\n")

    print("\n=== DM -> PATTERNS ===\n")
    for dm, ids in par_dm.items():
        print(f"{dm} : {ids}")


