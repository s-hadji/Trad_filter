import re
import unicodedata
from collections import defaultdict
from typing import List

TOKENS_PARASITES = {'-', '/', '|', '—', '.', '>', '→', '->'}


class Node:
    def __init__(self, name, parent=None):
        self.name = name
        self.parent = parent
        self.children = []
        if parent:
            parent.children.append(self)
        self.dm_code = None
        self.feuille = False
        self.patches = []
        self.statut = "BRANCHE"
        self.tokens_cumules = 0
        self.doc_v1 = None
        self.doc_v2 = None
        self.md_out = None

    @property
    def descendants(self):
        nodes = []
        for child in self.children:
            nodes.append(child)
            nodes.extend(child.descendants)
        return nodes

    @property
    def path(self):
        path = []
        current = self
        while current:
            path.insert(0, current)
            current = current.parent
        return path

    @property
    def depth(self):
        return len(self.path) - 1


# ---------------------------------------------------------------- utilitaires

def normaliser(ligne):
    if not ligne:
        return []
    ligne = unicodedata.normalize('NFKC', ligne.splitlines()[0])
    ligne = re.sub(r'\s+', ' ', ligne).strip()
    return [t for t in ligne.split(' ') if t and t not in TOKENS_PARASITES]


def extraire(dico):
    return [d for d in dico if d["type"] == "XML_procedure"]


def extraire_desc(dico):
    return [d for d in dico if d["type"] == "XML_description"]


def fusionner_docs(docs):
    """Fusionne les documents d'un meme DM_code. None si aucun document."""
    docs = [d for d in docs if d is not None]
    if not docs:
        return None
    if len(docs) == 1:
        return docs[0]
    fusion = dict(docs[0])                      # on garde les champs du 1er
    fusion["content"] = "\n".join(str(d.get("content") or "") for d in docs)
    fusion["length"] = sum(int(d.get("length") or 0) for d in docs)
    return fusion


def separer_en_set(feuilles: List[Node]) -> tuple:
    common_set = [f for f in feuilles if f.doc_v1 is not None and f.doc_v2 is not None]
    added_set = [f for f in feuilles if f.doc_v1 is None and f.doc_v2 is not None]
    delet_set = [f for f in feuilles if f.doc_v1 is not None and f.doc_v2 is None]
    return common_set, added_set, delet_set


# ------------------------------------------------------------- construction

def regrouper_par_dm_code(docs_v1, docs_v2):
    """{DM_code: {'titre': str, 'v1': [docs], 'v2': [docs]}}"""
    entrees = defaultdict(lambda: {"titre": "", "v1": [], "v2": []})
    for version, docs in (("v1", docs_v1), ("v2", docs_v2)):
        for doc in docs:
            extra = doc.get("extra_information") or {}
            code = extra.get("DM_code")
            if not code:
                continue
            e = entrees[code]
            if not e["titre"]:
                e["titre"] = extra.get("DM_title") or ""
            e[version].append(doc)
    return entrees


def construire_arbre(docs_v1, docs_v2):
    """Un noeud par DM_code, range sous un arbre construit sur les mots du DM_title."""
    entrees = [
        (normaliser(e["titre"]), code,
         fusionner_docs(e["v1"]), fusionner_docs(e["v2"]))
        for code, e in sorted(regrouper_par_dm_code(docs_v1, docs_v2).items())
    ]
    racine = Node("ROOT")
    _construire(entrees, racine)
    return racine


def _construire(entrees, parent):
    """Regroupe les entrees par premier mot, une branche par groupe, puis recursion."""
    groupes = defaultdict(list)
    for entree in entrees:
        tokens = entree[0]
        if tokens:
            groupes[tokens[0].lower()].append(entree)
        else:
            _creer_feuille(entree, parent)              # plus de mot : feuille ici

    for _, groupe in sorted(groupes.items()):
        if len(groupe) == 1:                            # seul dans son mot : pas de branche
            _creer_feuille(groupe[0], parent)
            continue

        n = _prefixe_commun([e[0] for e in groupe])     # tout le prefixe commun d'un coup
        branche = Node(" ".join(groupe[0][0][:n]), parent=parent)
        _construire([(t[n:], c, d1, d2) for t, c, d1, d2 in groupe], branche)


def _prefixe_commun(chemins):
    """Nombre de mots de tete identiques (insensible a la casse) a tous les chemins."""
    n = 0
    for mots in zip(*chemins):                          # s'arrete au chemin le plus court
        if len({m.lower() for m in mots}) > 1:
            break
        n += 1
    return n


def _creer_feuille(entree, parent):
    _, code, d1, d2 = entree
    feuille = Node(code, parent=parent)
    feuille.dm_code = code
    feuille.feuille = True
    feuille.statut = "FEUILLE"
    feuille.doc_v1 = d1
    feuille.doc_v2 = d2
    return feuille


def feuilles(racine):
    return [n for n in racine.descendants if n.feuille]


def afficher(node, niveau=0):
    print("  " * niveau + f"{node.name} [{node.statut}]")
    for child in node.children:
        afficher(child, niveau + 1)


