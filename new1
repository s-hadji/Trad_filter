class EtatPasse2(BaseModel):
    """Etat partage de la passe 2, detenu par l'appelant."""
    finaux: List[PatternFinal] = Field(default_factory=list)
    prochain_id: int = 1
    lots_traites: int = 0            # nombre de lots deja faits (reprise)

    class Config:
        arbitrary_types_allowed = True


PROMPT_PASSE2 = ChatPromptTemplate.from_messages([
    ("system",
     "Vous etes un expert en analyse de modifications documentaires. On vous donne un catalogue de "
