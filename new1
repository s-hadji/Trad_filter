# =================================================================== #
#  Tri par plus proche voisin (embedding)                             #
# =================================================================== #
def ordre_plus_proche_voisin(vecteurs: np.ndarray) -> List[int]:
    n = len(vecteurs)
    courant, ordre, restants = 0, [0], list(range(1, n))
    while restants:
        distances = cdist(vecteurs[courant].reshape(1, -1), vecteurs[restants], metric="cosine")[0]
        courant = restants.pop(int(np.argmin(distances)))
        ordre.append(courant)
    return ordre


def trier_par_embedding(textes: List[str], embedding) -> List[int]:
    if len(textes) < 2:
        return list(range(len(textes)))
    vecteurs = np.array(embedding.embed_documents(textes))
    return ordre_plus_proche_voisin(vecteurs)


