def _formater_catalogue(lignes: Dict[int, Modification]) -> str:
    return "\n".join(f"  [{m.id}] {m.description}" for m in lignes.values())


def consolider_catalogue(catalogue: Dict[int, Modification], llm, embedding, etat: EtatPasse2,
                         taille_lot: int = 40, nombre_essais: int = 3
                         ) -> Iterator[Tuple[int, List[PatternFinal]]]:
    """
    Generateur. Trie les lignes par embedding puis consolide par lots.
    'etat' est detenu par l'appelant : reprise possible (etat.lots_traites sautes).
    Le LLM fusionne les descriptions ; NOUS reconstruisons les DM par union.
    yield (numero_lot, [PatternFinal produits par ce lot]).
    """
    chaine = PROMPT_PASSE2 | llm.with_structured_output(SuperCatalogue)

    lignes = list(catalogue.values())
    print(f"Tri de {len(lignes)} pattern(s) par embedding...")
    ordre = trier_par_embedding([m.description for m in lignes], embedding)
    lignes = [lignes[i] for i in ordre]

    total = len(lignes)
    nb_lots = (total + taille_lot - 1) // taille_lot

    for numero, debut in enumerate(range(0, total, taille_lot), 1):
        if numero <= etat.lots_traites:          # reprise : lot deja fait
            continue
        lot = {m.id: m for m in lignes[debut: debut + taille_lot]}
        print(f"[Lot {numero}/{nb_lots}] {len(lot)} pattern(s)")

        produits: List[PatternFinal] = []
        sortie = _appeler(chaine, {"catalogue": _formater_catalogue(lot)}, nombre_essais)

        if sortie is None:
            for m in lot.values():
                produits.append(PatternFinal(id=etat.prochain_id, description=m.description,
                                             sources={m.id}, dms=set(m.dms)))
                etat.prochain_id += 1
        else:
            couverts: Set[int] = set()
            for entree in sortie.entrees:
                sources_valides = [i for i in entree.sources if i in lot]
                if not sources_valides:
                    continue
                dms = set()
                for i in sources_valides:
                    dms |= lot[i].dms            # UNION des DM, cote code
                    couverts.add(i)
                produits.append(PatternFinal(id=etat.prochain_id, description=entree.description,
                                             sources=set(sources_valides), dms=dms))
                etat.prochain_id += 1
            for i in set(lot) - couverts:        # filet : ids oublies rattaches seuls
                m = lot[i]
                produits.append(PatternFinal(id=etat.prochain_id, description=m.description,
                                             sources={i}, dms=set(m.dms)))
                etat.prochain_id += 1

        etat.finaux.extend(produits)
        etat.lots_traites = numero
        yield numero, produits


