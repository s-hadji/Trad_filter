def analyser_feuilles(feuille, llm, embedding, has_changes, diff_unifie,
                      taille_max_catalogue: int = 30, nombre_essais: int = 3):
    """
    Passe 1. Trie d'abord les feuilles modifiees par similarite de leur diff
    (documents proches traites a la suite -> le LLM reutilise mieux les patterns),
    puis detecte les patterns. Rotation du catalogue quand il devient trop grand.
    Renvoie (catalogue_global, par_dm).
    """
    chaine = PROMPT_PASSE1 | llm.with_structured_output(SortieLLM)

    # Feuilles modifiees + leur diff (calcule une seule fois)
    a_traiter = []
    for f in feuille:
        v1, v2 = f.doc_v1["content"], f.doc_v2["content"]
        if has_changes(v1, v2):
            a_traiter.append((f, diff_unifie(v1, v2)))

    # --- TRI par embedding des diffs ---
    print(f"Tri de {len(a_traiter)} document(s) par embedding...")
    ordre = trier_par_embedding([d for _, d in a_traiter], embedding)
    a_traiter = [a_traiter[i] for i in ordre]

    catalogue_courant: Dict[int, Modification] = {}
    tous_les_patterns: Dict[int, Modification] = {}
    par_dm: Dict[str, List[int]] = {}
    prochain_id = 1
    numero_catalogue = 1
    total = len(a_traiter)

    for numero, (f, diff) in enumerate(a_traiter, 1):
        dm = f.dm_code
        print(f"[{numero}/{total}] DM {dm}")

        if len(catalogue_courant) >= taille_max_catalogue:
            numero_catalogue += 1
            print(f"    >>> Catalogue plein, ouverture du catalogue #{numero_catalogue}")
            catalogue_courant = {}

        sortie = _appeler_passe1(chaine, diff, catalogue_courant, nombre_essais)
        if sortie is None:
            par_dm[dm] = []
            continue

        ids_du_dm = []
        for vue in sortie.modifications:
            modif = catalogue_courant.get(vue.id_connu) if vue.id_connu != -1 else None
            if modif is None:
                modif = Modification(id=prochain_id, description=vue.description)
                catalogue_courant[prochain_id] = modif
                tous_les_patterns[prochain_id] = modif
                prochain_id += 1
            modif.dms.add(dm)                 # rattachement du DM, cote code
            ids_du_dm.append(modif.id)

        par_dm[dm] = ids_du_dm
        _afficher_catalogue(catalogue_courant, numero_catalogue)

    # Fusion des doublons strictement identiques entre catalogues
    catalogue_global, remap = _fusionner_doublons(tous_les_patterns)
    par_dm = {dm: [remap.get(i, i) for i in ids] for dm, ids in par_dm.items()}

    print(f"Passe 1 terminee : {len(catalogue_global)} pattern(s) distinct(s)")
    return catalogue_global, par_dm


def _fusionner_doublons(patterns: Dict[int, Modification]):
    """Fusionne les patterns de meme description. Renvoie (catalogue, remap)."""
    par_desc: Dict[str, Modification] = {}
    remap: Dict[int, int] = {}
    for m in patterns.values():
        cle = m.description.strip().lower()
        if cle not in par_desc:
            par_desc[cle] = m
            remap[m.id] = m.id
        else:
            garde = par_desc[cle]
            garde.dms |= m.dms
            remap[m.id] = garde.id
    return {m.id: m for m in par_desc.values()}, remap


