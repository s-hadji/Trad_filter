# =================================================================== #
def analyser_feuilles(feuille, llm, embedding, has_changes, diff_unifie, etat: EtatPasse1,
                      taille_max_catalogue: int = 30, nombre_essais: int = 3
                      ) -> Iterator[Tuple[str, List[int]]]:
    """
    Generateur. Trie les feuilles par embedding puis detecte les patterns, DM par DM.
    'etat' est detenu par l'appelant : en cas d'interruption, tout ce qui a ete
    traite est conserve, et un nouvel appel REPREND (les dm_code de etat.traites
    sont sautes).
    yield (dm_code, [ids de patterns du DM]).
    """
    chaine = PROMPT_PASSE1 | llm.with_structured_output(SortieLLM)

    # Feuilles modifiees non encore traitees + leur diff
    a_traiter = []
    for f in feuille:
        v1, v2 = f.doc_v1["content"], f.doc_v2["content"]
        if has_changes(v1, v2) and f.dm_code not in etat.traites:
            a_traiter.append((f, diff_unifie(v1, v2)))

    if not a_traiter:
        return

    print(f"Tri de {len(a_traiter)} document(s) par embedding...")
    ordre = trier_par_embedding([d for _, d in a_traiter], embedding)
    a_traiter = [a_traiter[i] for i in ordre]
    total = len(a_traiter)

    for numero, (f, diff) in enumerate(a_traiter, 1):
        dm = f.dm_code
        print(f"[{numero}/{total}] DM {dm} — catalogue #{etat.numero_catalogue} "
              f"({len(etat.catalogue_courant)})")

        # Rotation du catalogue courant si trop grand
        if len(etat.catalogue_courant) >= taille_max_catalogue:
            etat.numero_catalogue += 1
            print(f"    >>> Ouverture du catalogue #{etat.numero_catalogue}")
            etat.catalogue_courant = {}

        sortie = _appeler(chaine, {"diff": diff, "connues": _formater_connues(etat.catalogue_courant)},
                          nombre_essais)
        if sortie is None:
            etat.par_dm[dm] = []
            etat.traites.add(dm)
            yield dm, []
            continue

        ids_du_dm = []
        for vue in sortie.modifications:
            modif = etat.catalogue_courant.get(vue.id_connu) if vue.id_connu != -1 else None
            if modif is None:
                modif = Modification(id=etat.prochain_id, description=vue.description)
                etat.catalogue_courant[etat.prochain_id] = modif
                etat.tous_les_patterns[etat.prochain_id] = modif
                etat.prochain_id += 1
            modif.dms.add(dm)                 # rattachement du DM, cote code
            ids_du_dm.append(modif.id)

        etat.par_dm[dm] = ids_du_dm
        etat.traites.add(dm)
        yield dm, ids_du_dm


def finaliser_passe1(etat: EtatPasse1) -> Dict[int, Modification]:
    """A appeler quand la passe 1 est finie : fusionne les doublons entre catalogues."""
    par_desc: Dict[str, Modification] = {}
    remap: Dict[int, int] = {}
    for m in etat.tous_les_patterns.values():
        cle = m.description.strip().lower()
        if cle not in par_desc:
            par_desc[cle] = m
            remap[m.id] = m.id
        else:
            par_desc[cle].dms |= m.dms
            remap[m.id] = par_desc[cle].id
    etat.par_dm = {dm: [remap.get(i, i) for i in ids] for dm, ids in etat.par_dm.items()}
    catalogue = {m.id: m for m in par_desc.values()}
    print(f"Passe 1 : {len(catalogue)} pattern(s) distinct(s)")
    return catalogue


