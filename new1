class EntreeFinale(BaseModel):
    description: str = Field(
        description="Description finale du pattern, precise et generique, dans le langage EXACT "
                    "du texte, sans interpretation."
    )
    sources: List[int] = Field(
        description="Ids des lignes du catalogue d'entree regroupees. CHAQUE ligne d'entree doit "
                    "apparaitre dans exactement une entree finale."
    )


class SuperCatalogue(BaseModel):
    entrees: List[EntreeFinale] = Field(
        description="Le catalogue final consolide. Aussi compact que possible, sans perte."
    )


class PatternFinal(BaseModel):
    id: int
    description: str
    sources: Set[int] = Field(default_factory=set)
    dms: Set[str] = Field(default_factory=set)

    class Config:
        arbitrary_types_allowed = True

    @property
    def nb_dm(self) -> int:
        return len(self.dms)


