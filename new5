        inputs, config, stream_mode=["messages", "updates"]
    ):
        if mode == "messages":
            msg, meta = chunk
            # Seulement les tokens de l'agent (pas ceux du reformulator ni du résumé)
            if meta.get("langgraph_node") == "langg_agent" and msg.content:
